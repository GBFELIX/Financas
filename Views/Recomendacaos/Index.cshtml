@model IEnumerable<Acoes_Fiis.Models.Recomendacao>

@{
    ViewData["Title"] = "Dashboard de Investimentos";
}

<style>
    /* Customizando o visual para parecer um terminal financeiro */
    .table-hover tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
        transition: 0.3s;
    }
    .card {
        border-radius: 15px;
        border: none;
    }
    .badge-custom {
        padding: 8px 12px;
        border-radius: 8px;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
    }
    .header-gradient {
        background: linear-gradient(90deg, #2c3e50 0%, #000000 100%);
        color: white;
        padding: 20px;
        border-radius: 15px;
        margin-bottom: 25px;
    }
    /* Estilo para manter o Ticker visível ao rolar para o lado */
    .table-responsive {
        overflow-x: auto;
    }

    .sticky-col {
        position: sticky;
        left: 0;
        background-color: white !important;
        z-index: 1;
        border-right: 2px solid #dee2e6 !important;
    }

    /* Diminuir a fonte geral para caber mais dados */
    .table-custom {
        font-size: 0.875rem;
    }

    /* Ajuste de largura mínima para evitar quebra de linha feia */
    th {
        white-space: nowrap;
    }
</style>

<div class="header-gradient shadow p-4 text-white rounded">
    <h1 class="display-6"><i class="bi bi-graph-up-arrow"></i> Painel de Recomendações</h1>
    <p class="mb-3">Análise fundamentalista automatizada via Yahoo Finance</p>

    <button type="button" class="btn btn-sm btn-info text-white" data-bs-toggle="modal" data-bs-target="#modalGlossario">
        <i class="bi bi-info-circle"></i> O que significam esses números?
    </button>
</div>

<div class="modal fade" id="modalGlossario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content text-dark">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">📚 Guia de Indicadores Financeiros</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <dl class="row">
                    <dt class="col-sm-4 text-primary">Ticker</dt>
                    <dd class="col-sm-8">Identificador da empresa na Bolsa. <strong>Exemplo:</strong> <em>BBAS3 (Banco do Brasil), VALE3 (Vale).</em></dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">Preço Atual</dt>
                    <dd class="col-sm-8">Cotação do ativo em tempo real. <strong>Exemplo:</strong> <em>Se a ação do Itaú custa R$ 32,10 no mercado agora.</em></dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">P/VP</dt>
                    <dd class="col-sm-8">Preço sobre Valor Patrimonial. <strong>Exemplo:</strong> <em>P/VP de 0,85 indica que você paga R$ 0,85 para cada R$ 1,00 de patrimônio real da empresa.</em></dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">P/L</dt>
                    <dd class="col-sm-8">Preço sobre Lucro. <strong>Exemplo:</strong> <em>P/L de 6 significa que, mantido o lucro, o investimento se paga em 6 anos.</em></dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">ROE (%)</dt>
                    <dd class="col-sm-8">Retorno sobre Patrimônio. <strong>Exemplo:</strong> <em>ROE de 18% mostra que a empresa lucra R$ 18 para cada R$ 100 dos sócios.</em></dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">DY (%)</dt>
                    <dd class="col-sm-8">Dividend Yield. <strong>Exemplo:</strong> <em>Se você tem R$ 1.000 investidos e recebeu R$ 90 de dividendos no ano, seu DY é 9%.</em></dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">Preço Teto (Venda)</dt>
                    <dd class="col-sm-8">Método de Bazin (foco em 6% ao ano). <strong>Exemplo:</strong> <em>Se o dividendo anual é R$ 1,20, seu preço teto é R$ 20,00 (1,20 / 0,06).</em></dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">Margem de Subida</dt>
                    <dd class="col-sm-8">Potencial até o Preço Alvo. <strong>Exemplo:</strong> <em>Preço atual R$ 20, Alvo R$ 25. Margem de subida de 25%.</em></dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">Preço Justo (Graham)</dt>
                    <dd class="col-sm-8">
                        $$ \sqrt{22,5 \times LPA \times VPA} $$
                        <strong>Exemplo:</strong> <em>Se a fórmula resultar em R$ 30, este é o valor intrínseco teórico da ação.</em>
                    </dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">Margem de Segurança</dt>
                    <dd class="col-sm-8">Proteção contra quedas. <strong>Exemplo:</strong> <em>Se o Preço Justo é R$ 30 e você compra por R$ 24, sua margem é de 20%.</em></dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">Última Atualização</dt>
                    <dd class="col-sm-8">Data e hora da coleta de dados. <strong>Exemplo:</strong> <em>19/02/2026 às 15:45.</em></dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">Tipo</dt>
                    <dd class="col-sm-8">Tese de investimento. <strong>Exemplo:</strong> <em>Dividendos (foco em renda), Crescimento (valorização do capital).</em></dd>

                    <hr class="my-2 opacity-25">

                    <dt class="col-sm-4 text-primary">Recomendação</dt>
                    <dd class="col-sm-8">Veredito do sistema. <strong>Exemplo:</strong> <em>"Compra" quando a Margem de Segurança está acima do seu limite estipulado.</em></dd>
                </dl>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Entendi!</button>
            </div>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0">Consultar Ativos</h2>
        <a asp-action="Create" class="btn btn-outline-dark shadow-sm">
            <i class="bi bi-plus-circle"></i> Novo Manual
        </a>
    </div>

    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-5">
                    <form asp-controller="Recomendacaos" asp-action="BuscarYahoo" method="get" class="d-flex h-100 align-items-center">
                        <input type="text" name="ticker" class="form-control me-2" placeholder="Ex: PETR4" required>
                        <button type="submit" class="btn btn-primary text-nowrap">Analisar</button>
                    </form>
                </div>

                <div class="col-md-4">
                    <form asp-action="Index" method="get" class="d-flex h-100 align-items-center">
                        <select name="filtroTipo" class="form-select me-2">
                            <option value="">-- Filtrar por Tipo --</option>
                            <option value="Setor Perene">🏦 Setor Perene</option>
                            <option value="Dividendos">💰 Dividendos</option>
                            <option value="Crescimento">🚀 Crescimento</option>
                        </select>
                        <button type="submit" class="btn btn-secondary">Filtrar</button>
                    </form>
                </div>

                <div class="col-md-3">
                    <form asp-action="AtualizarTodos" method="post" class="h-100 d-flex align-items-center">
                        <input type="hidden" name="filtroTipo" value="@Context.Request.Query["filtroTipo"]" />
                        <button type="submit" class="btn btn-outline-success w-100 fw-bold">
                            Atualizar Filtrados
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success mt-3 alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<p></p>
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-custom">
                <thead class="table-dark">
                    <tr>
                        <th>Ticket</th>
                        <th>Preço</th>
                        <th>P/VP</th>
                        <th>P/L</th>
                        <th>ROE</th>
                        <th>Dy</th>
                        <th>Preço Teto</th>
                        <th>Margem Subida</th>
                        <th>Justo (Graham)</th>
                        <th>Margem Seg.</th>
                        <th>Atualização</th>
                        <th>Tipo</th>
                        <th>Setor</th>
                        <th class="text-center">Recomendação</th>
                        <th class="text-center" style="width: 50px;">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        // Agrupa o modelo pela propriedade TipoAcao e ordena alfabeticamente
                        var gruposPorSetor = Model.GroupBy(x => string.IsNullOrEmpty(x.TipoAcao) ? "Setor Não Definido" : x.TipoAcao)
                        .OrderBy(g => g.Key);
                    }

                    @foreach (var grupo in gruposPorSetor)
                    {
                        <tr class="table-light fw-bold text-secondary text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">
                            <td colspan="14" class="ps-4 py-2 bg-light border-bottom">
                                <i class="bi bi-tags-fill me-1 text-primary"></i> @grupo.Key (@grupo.Count())
                            </td>
                        </tr>

                        @foreach (var item in grupo)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary sticky-col">@item.Ticker.ToUpper()</td>
                                <td><span class="text-nowrap">R$ @item.PrecoAtual.ToString("N2")</span></td>
                                <td class="text-muted">@item.PVP.ToString("N2")</td>
                                <td class="text-muted">@(item.PL == 0 ? "N/A" : item.PL.ToString("N2"))</td>
                                <td class="@(item.Roe > 15 ? "text-success fw-bold" : "")">@item.Roe.ToString("N1")%</td>
                                <td class="text-muted">@item.DividendYield.ToString("N1")%</td>
                                <td class="text-nowrap">R$ @item.PrecoTetoVenda.ToString("N2")</td>
                                <td class="text-nowrap @(item.DistanciaParaVenda > 0 ? "text-success" : "text-danger")">
                                    @(item.DistanciaParaVenda > 0 ? "+" : "")@item.DistanciaParaVenda.ToString("N1")%
                                </td>
                                <td class="text-nowrap">R$ @item.ValorJustoGraham.ToString("N2")</td>
                                <td>
                                    @if (item.MargemSeguranca > 20)
                                    {
                                        <span class="text-success fw-bold">@item.MargemSeguranca.ToString("N0")%</span>
                                    }
                                    else if (item.MargemSeguranca > 0)
                                    {
                                        <span class="text-info">@item.MargemSeguranca.ToString("N0")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">@item.MargemSeguranca.ToString("N0")%</span>
                                    }
                                </td>
                                <td class="small text-muted text-nowrap">
                                    @item.DataAtualizacao.ToString("dd/MM HH:mm")
                                    <i class="bi @(item.DataAtualizacao > DateTime.Now.AddMinutes(-30) ? "bi-patch-check-fill text-success" : "bi-clock text-warning")"></i>
                                </td>
                                <td>
                                    <form asp-action="AlterarTipoRapido" method="post" class="d-flex justify-content-center align-items-center">
                                        <input type="hidden" name="id" value="@item.Id" />

                                        <div class="position-relative" style="width: 24px; height: 24px;">
                                            <select name="novoTipo"
                                                    class="form-select form-select-sm position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer"
                                                    style="z-index: 2;"
                                                    title="Tipo Atual: @item.TipoAtivo (Clique para alterar)"
                                                    onchange="this.form.submit()">

                                                <option value="Setor Perene" selected="@(item.TipoAtivo == "Setor Perene")">🏦 Setor Perene</option>
                                                <option value="Dividendos" selected="@(item.TipoAtivo == "Dividendos")">💰 Dividendos</option>
                                                <option value="Crescimento" selected="@(item.TipoAtivo == "Crescimento")">🚀 Crescimento</option>
                                            </select>

                                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="z-index: 1; pointer-events: none; font-size: 1.1rem;">
                                                @{
                                                    string emojiTipo = item.TipoAtivo switch
                                                    {
                                                        "Setor Perene" => "🏦",
                                                        "Dividendos" => "💰",
                                                        "Crescimento" => "🚀",
                                                        _ => "❓"
                                                    };
                                                }
                                                @emojiTipo
                                            </div>
                                        </div>
                                    </form>
                                </td>

                                <td>
                                    <form asp-action="UpdateSegmento" method="post" class="d-flex justify-content-center align-items-center">
                                        <input type="hidden" name="id" value="@item.Id" />

                                        <div class="position-relative" style="width: 24px; height: 24px;">
                                            <select name="novoSegmento"
                                                    class="form-select form-select-sm position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer"
                                                    style="z-index: 2;"
                                                    title="Setor Atual: @(string.IsNullOrEmpty(item.TipoAcao) ? "Não Definido" : item.TipoAcao) (Clique para alterar)"
                                                    onchange="this.form.submit()">

                                                <option value="Bancário" selected="@(item.TipoAcao == "Bancário")">🏦 Bancário</option>
                                                <option value="Seguros" selected="@(item.TipoAcao == "Seguros")">🛡️ Seguros</option>
                                                <option value="Petroleiras" selected="@(item.TipoAcao == "Petroleiras")">🛢️ Petroleiras</option>
                                                <option value="Saneamento" selected="@(item.TipoAcao == "Saneamento")">🚰 Saneamento</option>
                                                <option value="Elétrico" selected="@(item.TipoAcao == "Elétrico")">⚡ Elétrico</option>
                                                <option value="Telecom" selected="@(item.TipoAcao == "Telecom")">📶 Telecomunicações</option>
                                                <option value="Varejo" selected="@(item.TipoAcao == "Varejo")">🛍️ Varejo / Consumo</option>
                                                <option value="Tecnologia" selected="@(item.TipoAcao == "Tecnologia")">💻 Tecnologia</option>
                                                <option value="Mineração/Siderurgia" selected="@(item.TipoAcao == "Mineração/Siderurgia")">⛏️ Mineração / Siderurgia</option>
                                                <option value="Construção/Shopping" selected="@(item.TipoAcao == "Construção/Shopping")">🏢 Construção / Imobiliário</option>
                                                <option value="Logística/Bens de Capital" selected="@(item.TipoAcao == "Logística/Bens de Capital")">🚛 Logística / Indústria</option>
                                                <option value="Saúde" selected="@(item.TipoAcao == "Saúde")">🩺 Saúde / Farmácia</option>
                                                <option value="Outros" selected="@(item.TipoAcao == "Outros")">📦 Outros</option>
                                            </select>

                                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="z-index: 1; pointer-events: none; font-size: 1.1rem;">
                                                @{
                                                    string emojiSetor = item.TipoAcao switch
                                                    {
                                                        "Bancário" => "🏦",
                                                        "Seguros" => "🛡️",
                                                        "Petroleiras" => "🛢️",
                                                        "Saneamento" => "🚰",
                                                        "Elétrico" => "⚡",
                                                        "Telecom" => "📶",
                                                        "Varejo" => "🛍️",
                                                        "Tecnologia" => "💻",
                                                        "Mineração/Siderurgia" => "⛏️",
                                                        "Construção/Shopping" => "🏢",
                                                        "Logística/Bens de Capital" => "🚛",
                                                        "Saúde" => "🩺",
                                                        "Outros" => "📦",
                                                        _ => "❓"
                                                    };
                                                }
                                                @emojiSetor
                                            </div>
                                        </div>
                                    </form>
                                </td>

                                <td class="text-center text-nowrap px-3">
                                    <span class="@item.CorClasse badge rounded-pill" style="padding: 5px 12px; font-size: 0.75rem;">
                                        @item.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="https://investidor10.com.br/acoes/@item.Ticker.ToLower()/" target="_blank" class="btn btn-sm btn-outline-info" title="Ver no Investidor10">
                                            <i class="bi bi-graph-up-arrow"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil-fill"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash-fill"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger mt-3 alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
