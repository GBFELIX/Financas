@model Acoes_Fiis.Models.Recomendacao

@{
    ViewData["Title"] = "Editar Ação";
}

<div class="container mt-4">
    <div class="card shadow border-0 rounded-4">
        @* Header com um tom de azul para diferenciar de FIIs *@
        <div class="card-header bg-primary text-white py-3 rounded-top-4">
            <h4 class="mb-0 flex-grow-1">
                <i class="bi bi-pencil-square me-2"></i>Editar Ativo: @Model.Ticker
            </h4>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    @* Ticker - Somente leitura para evitar erros de integridade *@
                    <div class="col-md-6 mb-3">
                        <label asp-for="Ticker" class="form-label fw-bold">Ticker (Código)</label>
                        <input asp-for="Ticker" class="form-control bg-light" readonly />
                        <span asp-validation-for="Ticker" class="text-danger small"></span>
                    </div>

                    @* Preço Atual *@
                    <div class="col-md-6 mb-3">
                        <label asp-for="PrecoAtual" class="form-label fw-bold">Preço Atual (R$)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">R$</span>
                            <input asp-for="PrecoAtual" type="text" class="form-control border-start-0" placeholder="0,00" />
                        </div>
                        <span asp-validation-for="PrecoAtual" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    @* VPA *@
                    <div class="col-md-4 mb-3">
                        <label asp-for="VPA" class="form-label fw-bold">VPA (Valor Patr. p/ Ação)</label>
                        <input asp-for="VPA" type="text" class="form-control" placeholder="0,00" />
                        <span asp-validation-for="VPA" class="text-danger small"></span>
                    </div>

                    @* LPA *@
                    <div class="col-md-4 mb-3">
                        <label asp-for="LPA" class="form-label fw-bold">LPA (Lucro p/ Ação)</label>
                        <input asp-for="LPA" type="text" class="form-control" placeholder="0,00" />
                        <span asp-validation-for="LPA" class="text-danger small"></span>
                    </div>

                    @* ROE *@
                    <div class="col-md-4 mb-3">
                        <label asp-for="Roe" class="form-label fw-bold">ROE (%)</label>
                        <div class="input-group">
                            <input asp-for="Roe" type="text" class="form-control" placeholder="0,00" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="Roe" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    @* Dividend Yield *@
                    <div class="col-md-4 mb-3">
                        <label asp-for="DividendYield" class="form-label fw-bold">Dividend Yield (%)</label>
                        <div class="input-group">
                            <input asp-for="DividendYield" type="text" class="form-control" placeholder="0,00" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="DividendYield" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4 text-muted" />

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i>Voltar
                    </a>
                    <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm">
                        <i class="bi bi-save me-1"></i>Salvar Alterações
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @* Script para aceitar vírgula como separador decimal no lado do cliente *@
    <script>
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
        }
    </script>
}