@model Acoes_Fiis.Models.Recomendacao

@{
    ViewData["Title"] = "Confirmar Análise";
}

<div class="container mt-4">
    <div class="card shadow rounded-4 border-0">
        <div class="card-header bg-dark text-white rounded-top-4 py-3">
            <h4 class="mb-0 fw-bold">📊 Confirmar Dados do Ativo: @Model?.Ticker</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row mb-3">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Ticker" class="form-label fw-bold"></label>
                        <input asp-for="Ticker" class="form-control form-control-lg bg-light fw-bold" readonly />
                        <span asp-validation-for="Ticker" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Nome" class="form-label fw-bold"></label>
                        <input asp-for="Nome" class="form-control form-control-lg bg-light" readonly />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="PrecoAtual" class="form-label fw-bold">Preço de Mercado</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-light fw-semibold">R$</span>
                            <input asp-for="PrecoAtual" class="form-control fw-bold text-success" type="text" />
                        </div>
                        <span asp-validation-for="PrecoAtual" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3 mb-3">
                        <label asp-for="VPA" class="form-label fw-bold"></label>
                        <input asp-for="VPA" class="form-control" type="text" />
                        <span asp-validation-for="VPA" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="LPA" class="form-label fw-bold"></label>
                        <input asp-for="LPA" class="form-control" type="text" />
                        <span asp-validation-for="LPA" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Roe" class="form-label fw-bold">ROE (%)</label>
                        <input asp-for="Roe" class="form-control text-primary fw-semibold" type="text" />
                        <span asp-validation-for="Roe" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="DividendYield" class="form-label fw-bold">Dividend Yield (%)</label>
                        <input asp-for="DividendYield" class="form-control text-success fw-semibold" type="text" />
                        <span asp-validation-for="DividendYield" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3 mb-3">
                        <label asp-for="RegularMarketOpen" class="form-label fw-bold">Abertura</label>
                        <input asp-for="RegularMarketOpen" class="form-control" type="text" />
                        <span asp-validation-for="RegularMarketOpen" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="RegularMarketPreviousClose" class="form-label fw-bold">Fechamento Anterior</label>
                        <input asp-for="RegularMarketPreviousClose" class="form-control" type="text" />
                        <span asp-validation-for="RegularMarketPreviousClose" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="RegularMarketDayLow" class="form-label fw-bold">Mínima (Dia)</label>
                        <input asp-for="RegularMarketDayLow" class="form-control" type="text" />
                        <span asp-validation-for="RegularMarketDayLow" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="RegularMarketDayHigh" class="form-label fw-bold">Máxima (Dia)</label>
                        <input asp-for="RegularMarketDayHigh" class="form-control" type="text" />
                        <span asp-validation-for="RegularMarketDayHigh" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3 mb-3">
                        <label asp-for="FiftyTwoWeekLow" class="form-label fw-bold">Mínima (52 Semanas)</label>
                        <input asp-for="FiftyTwoWeekLow" class="form-control" type="text" />
                        <span asp-validation-for="FiftyTwoWeekLow" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="FiftyTwoWeekHigh" class="form-label fw-bold">Máxima (52 Semanas)</label>
                        <input asp-for="FiftyTwoWeekHigh" class="form-control" type="text" />
                        <span asp-validation-for="FiftyTwoWeekHigh" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="ForwardPE" class="form-label fw-bold">P/L Projetado</label>
                        <input asp-for="ForwardPE" class="form-control" type="text" />
                        <span asp-validation-for="ForwardPE" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="PriceToBook" class="form-label fw-bold">P/VP</label>
                        <input asp-for="PriceToBook" class="form-control" type="text" />
                        <span asp-validation-for="PriceToBook" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4 mb-3">
                        <label asp-for="MarketCap" class="form-label fw-bold">Valor de Mercado</label>
                        <input asp-for="MarketCap" class="form-control" type="text" />
                        <span asp-validation-for="MarketCap" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="RegularMarketVolume" class="form-label fw-bold">Volume Diário</label>
                        <input asp-for="RegularMarketVolume" class="form-control" type="text" />
                        <span asp-validation-for="RegularMarketVolume" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="TipoAcao" class="form-label fw-bold">Setor (Yahoo)</label>
                        <input asp-for="TipoAcao" class="form-control" type="text" />
                        <span asp-validation-for="TipoAcao" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group mb-4 p-3 bg-light rounded-3 border">
                    <label asp-for="TipoAtivo" class="control-label fw-bold mb-2"><i class="bi bi-tag-fill me-1 text-secondary"></i>Classificação Estratégica</label>
                    <select asp-for="TipoAtivo" class="form-select form-select-lg">
                        <option value="">-- Selecione o Tipo --</option>
                        <option value="Setor Perene">Setor Perene</option>
                        <option value="Dividendos">Dividendos</option>
                        <option value="Crescimento">Crescimento</option>
                    </select>
                    <span asp-validation-for="TipoAtivo" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancelar</a>
                    <button type="submit" class="btn btn-success btn-lg px-5 rounded-pill shadow-sm">Salvar na Carteira</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
        }
    </script>
}