@model FluxoCaixaViewModel

@{
    Layout = null;
    var visao = ViewBag.VisaoAtual as string ?? "Gabriel";

    decimal mediaRealGabriel = ViewBag.MediaSobraGabriel ?? 0m;
    decimal mediaRealSuely = ViewBag.MediaSobraSuely ?? 0m;

    decimal aporteSugerido = 0m;
    decimal historicoSugerido = 0m;

    string corPrincipalHex = "#0d6efd"; 
    string bgSubtleClasse = "bg-primary bg-opacity-10 border-primary";
    string txtClasse = "text-primary";
    string tituloVisao = "Histórico Individual (Gabriel)";

    if (visao == "Gabriel")
    {
        aporteSugerido = Model.SobraEstimada; 
        historicoSugerido = mediaRealGabriel;  
    }
    else if (visao == "Ela")
    {
        corPrincipalHex = "#dc3545"; // Suely (Vermelho)
        bgSubtleClasse = "bg-danger bg-opacity-10 border-danger";
        txtClasse = "text-danger";
        tituloVisao = "Histórico Individual (Suely)";

        aporteSugerido = Model.SobraEstimada; // Sobra atual da Suely no mês
        historicoSugerido = mediaRealSuely;   // Média real dos últimos 12 meses da Suely
    }
    else if (visao == "Casal")
    {
        corPrincipalHex = "#198754"; // Casal (Verde)
        bgSubtleClasse = "bg-success bg-opacity-10 border-success";
        txtClasse = "text-success";
        tituloVisao = "Visão Consolidada (Soma do Casal)";

        // No mmodo casal, soma-se o histórico real de cada um
        aporteSugerido = Model.SobraEstimada;
        historicoSugerido = mediaRealGabriel + mediaRealSuely; 
    }
}

<div class="modal fade" id="modalSimuladorAporte" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-cpu me-2"></i>Simulador de Projeção -
                    <span class="@txtClasse">@tituloVisao</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-md-4 border-end">
                        <h6 class="fw-bold mb-3 text-uppercase small text-secondary">Configurações</h6>

                        @* Toggle de Origem dos Dados *@
                        <div class="btn-group w-100 mb-3" role="group">
                            <input type="radio" class="btn-check" name="modoSim" id="modoManual" checked onchange="toggleModo('manual')">
                            <label class="btn btn-outline-secondary btn-sm" for="modoManual">Manual</label>

                            <input type="radio" class="btn-check" name="modoSim" id="modoHistorico" onchange="toggleModo('historico')">
                            <label class="btn btn-outline-secondary btn-sm" for="modoHistorico">Média Real</label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Aporte Mensal (R$)</label>
                            <input type="number" id="simAporte" class="form-control" value="@aporteSugerido.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                            <input type="hidden" id="valHistorico" value="@historicoSugerido.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                            <small id="helpHistorico" class="fw-semibold @txtClasse d-none">Média real de 12 meses: @historicoSugerido.ToString("C2")</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Taxa de Juros Anual (%)</label>
                            <input type="number" id="simTaxa" class="form-control" value="11.75">
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Período (Anos)</label>
                            <input type="number" id="simAnos" class="form-control" value="3" min="1" max="50">
                        </div>

                        <button class="btn btn-dark w-100 fw-bold rounded-3 shadow-sm py-2" onclick="atualizarGrafico()">
                            <i class="bi bi-play-fill"></i> Simular Agora
                        </button>

                        <div class="mt-4 p-3 rounded-4 border @bgSubtleClasse">
                            <small class="text-muted d-block fw-bold text-uppercase" style="font-size: 0.7rem;">Patrimônio Estimado ao Final:</small>
                            <h3 class="fw-bold mb-0 @txtClasse" id="txtPatrimonioFinal">R$ 0,00</h3>
                        </div>
                    </div>

                    <div class="col-md-8 px-4">
                        <div style="height: 380px; position: relative;">
                            <canvas id="chartSimulacao"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Passa a cor principal do C# de forma nativa para o JavaScript
    const corTemaAtivo = '@corPrincipalHex';
    let meuGrafico = null;

    function toggleModo(modo) {
        const inputAporte = document.getElementById('simAporte');
        const valHistorico = document.getElementById('valHistorico').value;
        const helpH = document.getElementById('helpHistorico');

        if (modo === 'historico') {
            inputAporte.value = parseFloat(valHistorico).toFixed(2);
            inputAporte.readOnly = true;
            inputAporte.classList.add('bg-light');
            if (helpH) helpH.classList.remove('d-none');
        } else {
            inputAporte.readOnly = false;
            inputAporte.classList.remove('bg-light');
            if (helpH) helpH.classList.add('d-none');
        }
        atualizarGrafico();
    }

    function atualizarGrafico() {
        const canvas = document.getElementById('chartSimulacao');
        if (!canvas) return; // Proteção para não quebrar se o canvas não sumir da árvore DOM

        const aporte = parseFloat(document.getElementById('simAporte').value) || 0;
        const taxaAnual = parseFloat(document.getElementById('simTaxa').value) / 100;
        const anos = parseInt(document.getElementById('simAnos').value) || 1;

        const meses = anos * 12;
        const taxaMensal = Math.pow(1 + taxaAnual, 1/12) - 1;

        let labels = [];
        let dadosPatrimonio = [];
        let dadosAportado = [];
        let acumulado = 0;
        let totalAportado = 0;

        // CORREÇÃO: Mudado de 'int i' para 'let i' (C# vs JavaScript)
        for (let i = 1; i <= meses; i++) {
            acumulado = (acumulado + aporte) * (1 + taxaMensal);
            totalAportado += aporte;

            if (i % 6 === 0 || i === meses) {
                labels.push('Mês ' + i);
                dadosPatrimonio.push(acumulado.toFixed(2));
                dadosAportado.push(totalAportado.toFixed(2));
            }
        }

        const txtPatrimonio = document.getElementById('txtPatrimonioFinal');
        if (txtPatrimonio) {
            txtPatrimonio.innerText = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(acumulado);
        }

        const ctx = canvas.getContext('2d');
        if (meuGrafico) {
            meuGrafico.destroy();
        }

        meuGrafico = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Patrimônio Projetado (Juros Compostos)',
                        data: dadosPatrimonio,
                        borderColor: corTemaAtivo,
                        backgroundColor: corTemaAtivo + '1A', // 10% de opacidade no HEX
                        fill: true,
                        tension: 0.3
                    },
                    {
                        label: 'Total Guardado Individualmente',
                        data: dadosAportado,
                        borderColor: '#6c757d',
                        borderDash: [5, 5],
                        fill: false,
                        tension: 0
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: (context) => context.dataset.label + ': ' +
                                new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(context.raw)
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: (v) => 'R$ ' + v.toLocaleString('pt-BR') }
                    }
                }
            }
        });
    }

    // SOLUÇÃO DO SUMIÇO: Aguarda o modal terminar a animação de abertura (shown.bs.modal)
    // para só então disparar o cálculo do Chart.js com os tamanhos de tela corretos.
    document.addEventListener("DOMContentLoaded", function () {
        const meuModalEl = document.getElementById('modalSimuladorAporte');
        if (meuModalEl) {
            meuModalEl.addEventListener('shown.bs.modal', function () {
                // Força um redimensionamento rápido antes de desenhar
                const canvas = document.getElementById('chartSimulacao');
                if (canvas) {
                    canvas.style.width = '100%';
                    canvas.style.height = '100%';
                }
                atualizarGrafico();
            });
        }
    });
</script>