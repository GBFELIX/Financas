@model FluxoCaixaViewModel

<div class="modal fade" id="modalSimularGasto" tabindex="-1" aria-labelledby="modalSimularGastoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content text-dark">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="modalSimularGastoLabel">
                    <i class="bi bi-cpu-fill text-primary me-2"></i>Simulador de Impacto Orçamentário
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light-subtle">
                <div class="row g-3">
                    <div class="col-lg-5">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-cart-plus-fill me-2"></i>Adicionar Item à Simulação</h6>

                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Nome do Produto/Serviço</label>
                                    <input type="text" id="simItemNome" class="form-control form-control-sm" placeholder="Ex: Monitor UltraWide, Geladeira...">
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label small fw-bold">Valor Total (R$)</label>
                                        <input type="number" id="simItemValor" class="form-control form-control-sm" step="0.01" placeholder="0,00">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-bold">Qtd. Parcelas</label>
                                        <select id="simItemParcelas" class="form-control form-control-sm">
                                            <option value="1">À vista</option>
                                            <option value="2">2x</option>
                                            <option value="3">3x</option>
                                            <option value="4">4x</option>
                                            <option value="5">5x</option>
                                            <option value="6">6x</option>
                                            <option value="10">10x</option>
                                            <option value="12">12x</option>
                                            <option value="24">24x</option>
                                        </select>
                                    </div>
                                </div>
                                <button type="button" onclick="adicionarItemSimulacao()" class="btn btn-primary btn-sm w-100 rounded-pill fw-bold">
                                    <i class="bi bi-plus-lg me-1"></i>Incluir no Cenário
                                </button>

                                <hr class="my-3">

                                <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-list-check me-2"></i>Itens Inclusos</h6>
                                <div class="table-responsive" style="max-height: 180px;">
                                    <table class="table table-sm table-hover align-middle small" id="tabelaSimulacaoItens">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Item</th>
                                                <th>Total</th>
                                                <th>Parc.</th>
                                                <th>Valor/mês</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody id="corpoTabelaSimulacao">
                                            <tr id="linhaVaziaSimulacao"><td colspan="5" class="text-muted text-center py-3">Nenhum item adicionado à simulação</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-calendar3 me-2"></i>Projeção e Impacto Mensal (Próximos 6 Meses)</h6>
                                <div class="row row-cols-1 row-cols-md-2 g-2" id="containerCardsProjecao">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Fechar Simulador</button>
                <button type="button" onclick="limparSimulador()" class="btn btn-outline-danger btn-sm rounded-pill px-3">Limpar Tudo</button>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. MAPEAMENTO DINÂMICO DE ORÇAMENTO POR MÊS (HISTÓRICO REAL)
    const MAPA_ORCAMENTOS = {};

    @if (Model.ResumoMensal != null && Model.ResumoMensal.Any())
    {
            foreach (var resumo in Model.ResumoMensal)
            {
                    string chaveMesAno = $"{resumo.Mes.ToString("D2")}/{resumo.Ano}";

                    <text>
                    MAPA_ORCAMENTOS["@chaveMesAno"] = {
                        entradas: parseFloat("@resumo.Entradas.ToString(System.Globalization.CultureInfo.InvariantCulture)"),
                        despesas: parseFloat("@resumo.Saidas.ToString(System.Globalization.CultureInfo.InvariantCulture)"),
                    };
                    </text>
            }
    }

    // 2. CAPTURA DAS CONTAS FIXAS RECORRENTES DO BANCO
    // Criamos um array no JS para processar os valores recorrentes por dono
    const CONTAS_FIXAS_BANCO = [];
    @if (Model.ContasFixas != null)
    {
            foreach (var conta in Model.ContasFixas)
            {
                    <text>
                    CONTAS_FIXAS_BANCO.push({
                        valor: parseFloat("@conta.Valor.ToString(System.Globalization.CultureInfo.InvariantCulture)"),
                        dono: "@conta.Dono",
                        ehRecorrente: "@conta.EhRecorrente" === "True" || "@conta.EhRecorrente" === "1"
                    });
                    </text>
            }
    }

    // Identifica o dono da visão atual para filtrar no JS de forma idêntica ao Controller
    const VISAO_ATUAL = "@ViewBag.VisaoAtual";

    // 3. CÁLCULO DA SOMATÓRIA DAS CONTAS FIXAS DO DONO
    // Filtra as contas que são recorrentes e batem com o dono logado (ou todas se for a visão Casal)
    let totalContasFixasDono = 0;
    CONTAS_FIXAS_BANCO.forEach(conta => {
        if (conta.ehRecorrente) {
            if (VISAO_ATUAL === "Casal" || conta.dono === VISAO_ATUAL) {
                totalContasFixasDono += conta.valor;
            }
        }
    });

    // Fallbacks do mês ativo na tela
    const FALLBACK_ENTRADAS = parseFloat('@Model.TotalEntradas'.replace(',', '.')) || 0;
    const FALLBACK_DESPESAS = parseFloat('@Model.TotalDespesas'.replace(',', '.')) || 0;
    const FALLBACK_PAGO_CASA = parseFloat('@Model.TotalPendenteCasa'.replace(',', '.')) || 0;
    const FALLBACK_SOBRA = parseFloat('@Model.SobraEstimada'.replace(',', '.')) || 0;

    let listaItensSimulados = [];

    function adicionarItemSimulacao() {
        const nomeInput = document.getElementById('simItemNome');
        const valorInput = document.getElementById('simItemValor');
        const parcelasInput = document.getElementById('simItemParcelas');

        const nome = nomeInput.value.trim();
        const valorTotal = parseFloat(valorInput.value);
        const parcelas = parseInt(parcelasInput.value);

        if (!nome || isNaN(valorTotal) || valorTotal <= 0) {
            alert("Por favor, preencha o nome do produto e o valor total corretamente.");
            return;
        }

        const valorParcela = +(Math.round((valorTotal / parcelas) + "e+2") + "e-2");

        listaItensSimulados.push({
            id: Date.now(),
            nome: nome,
            valorTotal: valorTotal,
            parcelas: parcelas,
            valorParcela: valorParcela
        });

        nomeInput.value = '';
        valorInput.value = '';
        parcelasInput.value = '1';

        atualizarInterfaceSimulador();
    }

    function removerItemSimulacao(id) {
        listaItensSimulados = listaItensSimulados.filter(item => item.id !== id);
        atualizarInterfaceSimulador();
    }

    function limparSimulador() {
        listaItensSimulados = [];
        atualizarInterfaceSimulador();
    }

    function atualizarInterfaceSimulador() {
        const corpoTabela = document.getElementById('corpoTabelaSimulacao');
        corpoTabela.innerHTML = '';

        if (listaItensSimulados.length === 0) {
            corpoTabela.innerHTML = `<tr id="linhaVaziaSimulacao"><td colspan="5" class="text-muted text-center py-3">Nenhum item adicionado à simulação</td></tr>`;
            renderizarCardsProjecao([]);
            return;
        }

        listaItensSimulados.forEach(item => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="fw-bold">${item.nome}</td>
                <td>${item.valorTotal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</td>
                <td><span class="badge bg-secondary">${item.parcelas}x</span></td>
                <td class="text-danger fw-bold">${item.valorParcela.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</td>
                <td class="text-end">
                    <button type="button" class="btn btn-link btn-sm text-danger p-0" onclick="removerItemSimulacao(${item.id})">
                        <i class="bi bi-trash3-fill"></i>
                    </button>
                </td>
            `;
            corpoTabela.appendChild(tr);
        });

        renderizarCardsProjecao(listaItensSimulados);
    }

    function renderizarCardsProjecao(itens) {
        const container = document.getElementById('containerCardsProjecao');
        container.innerHTML = '';

        const opcoesMes = { month: 'long', year: 'numeric' };
        const dataAtual = new Date();

        for (let i = 0; i < 12; i++) {
            let dataFutura = new Date(dataAtual.getFullYear(), dataAtual.getMonth() + i, 1);
            let nomeMes = dataFutura.toLocaleDateString('pt-BR', opcoesMes);
            nomeMes = nomeMes.charAt(0).toUpperCase() + nomeMes.slice(1);

            let mesZeroM = String(dataFutura.getMonth() + 1).padStart(2, '0');
            let chaveMesAno = `${mesZeroM}/${dataFutura.getFullYear()}`;

            let entradasDoMes = MAPA_ORCAMENTOS[chaveMesAno] ? MAPA_ORCAMENTOS[chaveMesAno].entradas : FALLBACK_ENTRADAS;
            let despesasDoMes = MAPA_ORCAMENTOS[chaveMesAno] ? MAPA_ORCAMENTOS[chaveMesAno].despesas : FALLBACK_DESPESAS;
            let pacoCasaDoMes = FALLBACK_PAGO_CASA;

            // INTEGRAÇÃO: Se for um mês futuro (i > 0), garantimos que as despesas fixas recorrentes
            // do banco entrem somando de forma automática no orçamento base daquele mês
            if (i > 0 && MAPA_ORCAMENTOS[chaveMesAno] == null) {
                despesasDoMes += totalContasFixasDono;
            }

            // Calcula o impacto cumulativo dos novos itens inseridos na simulação
            let despesaSimuladaDoMes = 0;
            itens.forEach(item => {
                if (i < item.parcelas) {
                    despesaSimuladaDoMes += item.valorParcela;
                }
            });

            let despesaTotalMes = despesasDoMes + despesaSimuladaDoMes;
            let sobraMes = entradasDoMes - despesaTotalMes - pacoCasaDoMes;

            const corSobra = sobraMes >= 0 ? 'text-success' : 'text-danger';
            const bordaCard = despesaSimuladaDoMes > 0 ? (sobraMes >= 0 ? 'border-start border-4 border-success' : 'border-start border-4 border-danger') : '';

            const cardHtml = `
                <div class="col">
                    <div class="card shadow-sm h-100 ${bordaCard}">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-primary small text-uppercase">${nomeMes}</span>
                                ${despesaSimuladaDoMes > 0 ? '<span class="badge bg-warning text-dark" style="font-size: 0.65rem;">Simulado</span>' : ''}
                            </div>
                            <div class="d-flex justify-content-between text-muted small">
                                <span>Entradas:</span>
                                <span class="text-dark fw-bold">${entradasDoMes.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</span>
                            </div>
                            <div class="d-flex justify-content-between text-muted small">
                                <span>Despesas Base:</span>
                                <span class="text-dark">
                                    ${despesasDoMes.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}
                                </span>
                            </div>
                            <div class="d-flex justify-content-between text-muted small">
                                <span>Casa:</span>
                                <span class="text-dark">
                                    ${pacoCasaDoMes.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}
                                </span>
                            </div>
                            ${despesaSimuladaDoMes > 0 ? `
                            <div class="d-flex justify-content-between text-muted small">
                                <span>Simulação:</span>
                                <span class="text-danger fw-bold">+ ${despesaSimuladaDoMes.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</span>
                            </div>
                            ` : ''}
                            <hr class="my-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold small text-secondary">Sobra:</span>
                                <span class="fw-bold ${corSobra}" style="font-size: 1rem;">${sobraMes.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', cardHtml);
        }
    }

    document.getElementById('modalSimularGasto').addEventListener('shown.bs.modal', function () {
        if(listaItensSimulados.length === 0) {
            atualizarInterfaceSimulador();
        }
    });
</script>