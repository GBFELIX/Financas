@model FluxoCaixaViewModel

@{
    ViewData["Title"] = "Gestão de Fluxo de Caixa";
}

<div class="container mt-4">
    @* Cabeçalho e Filtros Otimizados *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-0 text-dark">Controle de Gastos</h1>
            <p class="text-muted"><i class="bi bi-calendar3 me-2"></i>Planejamento @Model.AnoAtual</p>
        </div>
        @{
            // Lógica para calcular meses e anos vizinhos
            var mesAnterior = Model.MesAtual == 1 ? 12 : Model.MesAtual - 1;
            var anoParaMesAnterior = Model.MesAtual == 1 ? Model.AnoAtual - 1 : Model.AnoAtual;

            var proximoMes = Model.MesAtual == 12 ? 1 : Model.MesAtual + 1;
            var anoParaProximoMes = Model.MesAtual == 12 ? Model.AnoAtual + 1 : Model.AnoAtual;
        }

        <div class="d-flex align-items-center gap-3">
            @* Seta para Voltar *@
            <a asp-action="Index" asp-route-mes="@mesAnterior" asp-route-ano="@anoParaMesAnterior"
               class="btn btn-outline-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center"
               style="width: 32px; height: 32px;" title="Mês Anterior">
                <i class="bi bi-chevron-left"></i>
            </a>

            @* Seu Formulário Original (Pode selecionar direto) *@
            <form method="get" class="d-flex gap-2 bg-light p-2 rounded shadow-sm border">
                <select name="mes" class="form-select form-select-sm border-0 bg-transparent fw-bold" style="width: 140px;" onchange="this.form.submit()">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(Model.MesAtual == i)">
                            @System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(i).ToUpper()
                        </option>
                    }
                </select>
                <input type="number" name="ano" class="form-control form-control-sm border-0 bg-transparent fw-bold"
                       value="@Model.AnoAtual" style="width: 80px;" onchange="this.form.submit()" />

                @* O botão de filtrar ainda existe, mas adicionei o "onchange" acima para ser automático *@
                <button type="submit" class="btn btn-sm btn-dark px-3 rounded-pill d-none d-md-block">Filtrar</button>
            </form>

            @* Seta para Avançar *@
            <a asp-action="Index" asp-route-mes="@proximoMes" asp-route-ano="@anoParaProximoMes"
               class="btn btn-outline-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center"
               style="width: 32px; height: 32px;" title="Próximo Mês">
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </div>

    @* Cards de Resumo Estilo Dashboard *@
    <div class="row mb-4 g-3">
        <div class="col-md-3">
            <div class="card border-0 bg-success text-white shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <h6 class="small text-uppercase opacity-75">Entradas</h6>
                        <i class="bi bi-arrow-up-right-circle opacity-50"></i>
                    </div>
                    <h3 class="mb-0 fw-bold">@Model.TotalEntradas.ToString("C2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            @* Adicionado cursor:pointer e os triggers do modal *@
            <div class="card border-0 bg-danger text-white shadow-sm rounded-4"
                 role="button"
                 data-bs-toggle="modal"
                 data-bs-target="#modalResumoDespesas"
                 style="cursor: pointer;">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <h6 class="small text-uppercase opacity-75">Despesas</h6>
                        <i class="bi bi-arrow-down-left-circle opacity-50"></i>
                    </div>
                    <h3 class="mb-0 fw-bold">@Model.TotalDespesas.ToString("C2")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            @* O 'data-bs-target' precisa ser idêntico ao id do Modal *@
            <div class="card border-0 bg-info text-dark shadow-sm rounded-4"
                 role="button"
                 data-bs-toggle="modal"
                 data-bs-target="#modalDespesasCasa"
                 style="cursor: pointer;">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <h6 class="small text-uppercase opacity-75 fw-bold">Contas da Casa</h6>
                        <i class="bi bi-house-check-fill opacity-50"></i>
                    </div>
                    <h3 class="mb-0 fw-bold">@Model.TotalPagoCasa.ToString("C2")</h3>
                    @if (Model.TotalPendenteCasa > 0)
                    {
                        <small class="text-danger fw-bold">Faltam @Model.TotalPendenteCasa.ToString("C2")</small>
                    }
                    else
                    {
                        <small class="text-success fw-bold"><i class="bi bi-check-all"></i> Tudo pago!</small>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-primary text-white shadow-lg rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <h6 class="small text-uppercase opacity-75 fw-bold">Para Aportar</h6>
                        <i class="bi bi-piggy-bank opacity-50"></i>
                    </div>
                    <h3 class="mb-0 fw-bold">@Model.SobraEstimada.ToString("C2")</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="position-relative d-none d-lg-block">
        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
        <input type="text" id="filtroTexto" class="form-control form-control-sm ps-5 rounded-pill border shadow-sm"
               placeholder="Buscar lançamento..." style="width: 220px;" onkeyup="filtrarPorTexto()">
    </div>

    @if (TempData["Casa"] != null)
    {
        <div class="alert alert-success mt-3 alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Casa"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    @* Tabela de Extrato Modernizada *@
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-receipt-cutoff me-2"></i>Extrato Mensal</h5>
            <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNovoLancamento">
                <i class="bi bi-plus-lg me-1"></i> Lançar Gasto
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th style="width: 100px;">Data</th>
                        <th>Descrição</th>
                        <th>Categoria</th>
                        <th>Pagamento</th>
                        <th class="text-end">Valor</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        // 1. SEPARAÇÃO DAS ENTRADAS (RECEITAS)
                        var entradas = Model.Lancamentos.Where(x => x.Tipo == "Entrada").OrderBy(x => x.Data);

                        // 2. SEPARAÇÃO DAS DESPESAS AGRUPADAS POR CATEGORIA
                        var despesasPorCategoria = Model.Lancamentos
                        .Where(x => x.Tipo == "Despesa")
                        .GroupBy(x => x.Categoria)
                        .OrderBy(g => g.Key);
                    }

                    @* --- BLOCO DE ENTRADAS --- *@
                    @if (entradas.Any())
                    {
                        <tr class="table-success opacity-75">
                            <td colspan="6" class="fw-bold small text-uppercase text-success py-2 px-3">
                                <i class="bi bi-patch-check-fill me-2"></i>Receitas e Rendimentos
                            </td>
                        </tr>
                        @foreach (var item in entradas)
                        {
                            <tr class="bg-success-subtle">
                                <td class="text-muted small ps-3">@item.Data.ToString("dd MMM")</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-white shadow-sm p-2 me-3 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                            <i class="bi bi-cash-stack text-success"></i>
                                        </div>
                                        <span class="fw-bold text-dark">@item.Descricao</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-success text-white">@item.Categoria.ToUpper()</span></td>
                                <td><small class="text-muted"><i class="bi bi-wallet2 me-1"></i>@item.Pagamento</small></td>
                                <td class="text-end fw-bold text-success">@item.Valor.ToString("C2")</td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button type="button" class="btn btn-sm btn-link text-primary p-0" data-bs-toggle="modal" data-bs-target="#editModal-@item.Id"><i class="bi bi-pencil"></i></button>
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id"><i class="bi bi-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                            @await Html.PartialAsync("Edit", item)
                            @await Html.PartialAsync("Delete", item)
                            @await Html.PartialAsync("_ModalResumoDespesas", Model)
                        }
                    }

                    @* --- BLOCO DE DESPESAS POR CATEGORIA --- *@
                    @foreach (var grupo in despesasPorCategoria)
                    {
                        <tr class="table-light">
                            <td colspan="4" class="fw-bold small text-uppercase text-secondary py-2 px-3">
                                <i class="bi bi-tag-fill me-2"></i>@grupo.Key
                            </td>
                            <td class="text-end fw-bold text-secondary pe-3">
                                <small>Subtotal: @grupo.Sum(x => x.Valor).ToString("C2")</small>
                            </td>
                            <td></td>
                        </tr>

                        @foreach (var item in grupo.OrderBy(x => x.Data))
                        {
                            <tr>
                                <td class="text-muted small ps-3">@item.Data.ToString("dd MMM")</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-light p-2 me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                                            <i class="bi @(item.Categoria == "Salário" ? "bi-cash-stack text-purple" :
                                                                  item.Categoria == "Moradia" ? "bi-house text-purple" :
                                                                  item.Categoria == "Alimentação" ? "bi-egg-fried text-purple" :
                                                                  item.Categoria == "Transporte" ? "bi-car-front text-purple" :
                                                                  item.Categoria == "Lazer" ? "bi-controller text-purple" :
                                                                  item.Categoria == "Investimento" ? "bi-graph-up-arrow text-purple" :
                                                                  item.Categoria == "Roupas/Shopping" ? "bi-bag-check text-purple" :
                                                                  item.Categoria == "Estudos" ? "bi-book text-purple" :
                                                                  item.Categoria == "Eletrônicos" ? "bi-cpu text-purple" :
                                                                  item.Categoria == "Farmácia" ? "bi-capsule text-purple" :
                                                                  item.Categoria == "Serviços" ? "bi-tools text-purple" : "bi-tag text-purple")"></i>
                                </div>
                                <span class="text-dark fw-bold">@item.Descricao</span>
                            </div>
                        </td>
                        <td>
                            @{
                                        var badgeClass = item.Categoria switch
                                        {
                                            "Salário" => "bg-success-subtle text-success-emphasis border-danger text-dark",
                                            "Moradia" => "bg-info-subtle text-info-emphasis border-danger text-dark",
                                            "Alimentação" => "bg-warning-subtle text-warning-emphasis border-danger text-dark",
                                            "Transporte" => "bg-primary-subtle text-primary-emphasis border-danger text-dark",
                                            "Lazer" => "bg-secondary-subtle text-dark border-danger text-dark",
                                            "Investimento" => "bg-success-subtle text-dark border-danger",
                                            "Roupas/Shopping" => "bg-danger-subtle text-danger-emphasis border-danger",
                                            "Estudos" => "bg-info-subtle text-dark border-danger",
                                            "Eletrônicos" => "bg-dark-subtle text-dark border-danger text-dark",
                                            "Farmácia" => "bg-danger-subtle text-danger-emphasis border-danger text-dark",
                                            "Serviços" => "bg-light text-dark border-danger text-dark",
                                            _ => "bg-light text-secondary border-danger text-dark"
                                        };
                                    }
                                    <span class="badge rounded-pill border @badgeClass fw-normal" style="font-size: 0.7rem;">@item.Categoria.ToUpper()</span>
                                </td>
                                <td>
                                    <div class="pay-method border small p-1 rounded bg-white d-inline-block">
                                        <i class="bi @(item.Pagamento.Contains("Crédito") ? "bi-credit-card text-primary" : "bi-qr-code text-info") me-1"></i>
                                        @item.Pagamento
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-dark">@item.Valor.ToString("C2")</td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button type="button" class="btn btn-sm btn-link text-primary p-0" data-bs-toggle="modal" data-bs-target="#editModal-@item.Id"><i class="bi bi-pencil-fill"></i></button>
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id"><i class="bi bi-trash-fill"></i></button>
                                    </div>
                                </td>
                            </tr>
                            @await Html.PartialAsync("Edit", item)
                            @await Html.PartialAsync("Delete", item)
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@await Html.PartialAsync("_ModalDespesasCasa", Model)

@* Modal de Novo Lançamento com Suporte a Parcelamento *@
<div class="modal fade" id="modalNovoLancamento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Adicionar Lançamento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tipo de Fluxo</label>
                        <select name="Tipo" class="form-select rounded-3" required>
                            <option value="Despesa">Saída (Gasto)</option>
                            <option value="Entrada">Entrada (Ganho)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">O que é? (Descrição)</label>
                        <input type="text" name="Descricao" class="form-control rounded-3" placeholder="Ex: Supermercado, Salário, Internet" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Valor Total (R$)</label>
                            <input name="Valor" class="form-control rounded-3" type="text" placeholder="0,00" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Nº de Parcelas</label>
                            <input name="numParcelas" class="form-control rounded-3" type="number" value="1" min="1" />
                            <div class="form-text text-info small"><i class="bi bi-info-circle"></i> Para compras em 1x, deixe 1.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Data</label>
                            <input type="date" name="Data" class="form-control rounded-3" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Categoria</label>
                            <select name="Categoria" class="form-select rounded-3">
                                <option value="Salário">Salário</option>
                                <option value="Moradia">Moradia</option>
                                <option value="Alimentação">Alimentação</option>
                                <option value="Transporte">Transporte</option>
                                <option value="Lazer">Lazer</option>
                                <option value="Investimento">Investimento</option>
                                <option value="Roupas/Shopping">Roupas/Shopping</option>
                                <option value="Estudos">Estudos</option>
                                <option value="Eletrônicos">Eletrônicos</option>
                                <option value="Serviços">Serviços</option>
                                <option value="Farmácia">Farmácia</option>
                                <option value="Outros">Outros</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-bold">Método de Pagamento</label>
                        <select name="Pagamento" class="form-select rounded-3">
                            <option value="Pix">Pix / Dinheiro</option>
                            <option value="Cartão Crédito">Cartão de Crédito</option>
                            <option value="Cartão Débito">Cartão de Débito</option>
                            <option value="Pagamento">Pagamento</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Salvar Lançamento</button>
                </div>
            </form>
        </div>
    </div>
</div>

    <script>
        function filtrarPorTexto() {
        // 1. Pega o valor digitado
        var input = document.getElementById("filtroTexto");
        var filter = input.value.toUpperCase();

        // 2. Localiza as linhas da tabela
        var table = document.querySelector(".table");
        var tr = table.getElementsByTagName("tr");

        for (var i = 0; i < tr.length; i++) {
            // Pula as linhas que são apenas títulos de seção (Receitas/Despesas)
            if (tr[i].classList.contains('table-light')) continue;

            var tdDesc = tr[i].getElementsByTagName("td")[1];
            var tdCat = tr[i].getElementsByTagName("td")[2];

            if (tdDesc || tdCat) {
                var txtValueDesc = tdDesc.textContent || tdDesc.innerText;
                var txtValueCat = tdCat.textContent || tdCat.innerText;

                // Se o texto digitado existir em qualquer uma das colunas, mostra a linha
                if (txtValueDesc.toUpperCase().indexOf(filter) > -1 ||
                    txtValueCat.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
    </script>
