@model FluxoCaixaViewModel

@{
    ViewData["Title"] = "Gestão de Fluxo de Caixa";
}

<div class="container mt-4">
    @* Cabeçalho e Filtros Otimizados *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-0 text-dark">Controle de Gastos</h1>
            <p class="text-muted"><i class="bi bi-calendar3 me-2"></i>Planejamento @Model.AnoAtual</p>
        </div>
        @{
            // Lógica para calcular meses e anos vizinhos
            var mesAnterior = Model.MesAtual == 1 ? 12 : Model.MesAtual - 1;
            var anoParaMesAnterior = Model.MesAtual == 1 ? Model.AnoAtual - 1 : Model.AnoAtual;

            var proximoMes = Model.MesAtual == 12 ? 1 : Model.MesAtual + 1;
            var anoParaProximoMes = Model.MesAtual == 12 ? Model.AnoAtual + 1 : Model.AnoAtual;
        }

        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" asp-route-mes="@mesAnterior" asp-route-ano="@anoParaMesAnterior" asp-route-visao="@ViewBag.VisaoAtual"
               class="btn btn-outline-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center"
               style="width: 32px; height: 32px;" title="Mês Anterior">
                <i class="bi bi-chevron-left"></i>
            </a>

            <form method="get" class="d-flex gap-2 bg-light p-2 rounded shadow-sm border">

                <input type="hidden" name="visao" value="@ViewBag.VisaoAtual" />

                <select name="mes" class="form-select form-select-sm border-0 bg-transparent fw-bold" style="width: 140px;" onchange="this.form.submit()">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(Model.MesAtual == i)">
                            @System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(i).ToUpper()
                        </option>
                    }
                </select>
                <input type="number" name="ano" class="form-control form-control-sm border-0 bg-transparent fw-bold"
                       value="@Model.AnoAtual" style="width: 80px;" onchange="this.form.submit()" />

                @* O botão de filtrar ainda existe, mas adicionei o "onchange" acima para ser automático *@
                <button type="submit" class="btn btn-sm btn-dark px-3 rounded-pill d-none d-md-block">Filtrar</button>
            </form>

            @* Seta para Avançar *@
            <a asp-action="Index" asp-route-mes="@proximoMes" asp-route-ano="@anoParaProximoMes" asp-route-visao="@ViewBag.VisaoAtual"
               class="btn btn-outline-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center"
               style="width: 32px; height: 32px;" title="Próximo Mês">
                <i class="bi bi-chevron-right"></i>
            </a>
        </div>
    </div>

    @* Cards de Resumo Estilo Dashboard *@
    <div class="row mb-4 g-3">
        <!-- CARD 1: Entradas / Ganhos -->
        <div class="col-md-3">
            <div class="card border-0 bg-success text-white shadow-sm rounded-4 h-100"
                 data-bs-toggle="modal" data-bs-target="#modalDetalheGanhos"
                 style="cursor: pointer; transition: transform 0.2s;"
                 onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <h6 class="small text-uppercase opacity-75 mb-0">Entradas / Ganhos</h6>
                        <i class="bi bi-arrow-up-right-circle opacity-75 fs-5"></i>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.TotalEntradas.ToString("C2")</h3>
                    <small class="opacity-75 d-flex align-items-center gap-1" style="font-size: 0.7rem;">
                        <i class="bi bi-info-circle"></i> Clique para ver histórico e RV
                    </small>
                </div>
            </div>
        </div>
        <div class="modal fade" id="modalDetalheGanhos" tabindex="-1" aria-hidden="true">
            @await Html.PartialAsync("Details", Model)
        </div>

        <!-- CARD 2: Despesas -->
        <div class="col-md-3">
            <div class="card border-0 bg-danger text-white shadow-sm rounded-4 h-100"
                 data-bs-toggle="modal" data-bs-target="#modalResumoDespesas"
                 style="cursor: pointer; transition: transform 0.2s;"
                 onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <h6 class="small text-uppercase opacity-75 mb-0">Despesas</h6>
                        <i class="bi bi-arrow-down-left-circle opacity-75 fs-5"></i>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.TotalDespesas.ToString("C2")</h3>
                    <small class="opacity-75 d-flex align-items-center gap-1" style="font-size: 0.7rem;">
                        <i class="bi bi-info-circle"></i> Clique para ver mais
                    </small>
                </div>
            </div>
        </div>

        <!-- CARD 3: Contas da Casa -->
        <div class="col-md-3">
            <div class="card border-0 bg-info text-dark shadow-sm rounded-4 h-100"
                 data-bs-toggle="modal" data-bs-target="#modalDespesasCasa"
                 style="cursor: pointer; transition: transform 0.2s;"
                 onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <h6 class="small text-uppercase opacity-75 mb-0 fw-bold">Contas da Casa</h6>
                        <i class="bi bi-house-check-fill opacity-75 fs-5"></i>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.TotalPagoCasa.ToString("C2")</h3>

                    <small class="d-flex align-items-center gap-1" style="font-size: 0.7rem;">
                        @if (Model.TotalPendenteCasa > 0)
                        {
                            <span class="text-danger fw-bold"><i class="bi bi-exclamation-circle"></i> Faltam @Model.TotalPendenteCasa.ToString("C2")</span>
                        }
                        else
                        {
                            <span class="text-success fw-bold"><i class="bi bi-check-all"></i> Tudo pago!</span>
                        }
                    </small>
                </div>
            </div>
        </div>

        <!-- CARD 4: Para Aportar -->
        <div class="col-md-3">
            <div class="card border-0 bg-primary text-white shadow-sm rounded-4 h-100"
                 data-bs-toggle="modal" data-bs-target="#modalSimuladorAporte"
                 style="cursor: pointer; transition: transform 0.2s;"
                 onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <h6 class="small text-uppercase opacity-75 mb-0 fw-bold">Para Aportar</h6>
                        <i class="bi bi-graph-up-arrow opacity-75 fs-5"></i>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.SobraEstimada.ToString("C2")</h3>
                    <small class="opacity-75 d-flex align-items-center gap-1" style="font-size: 0.7rem;">
                        <i class="bi bi-info-circle"></i> Clique para simular projeção
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="position-relative d-none d-lg-block">
        <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
        <input type="text" id="filtroTexto" class="form-control form-control-sm ps-5 rounded-pill border shadow-sm"
               placeholder="Buscar lançamento..." style="width: 220px;" onkeyup="filtrarPorTexto()">
    </div>

    @if (TempData["Casa"] != null)
    {
        <div class="alert alert-success mt-3 alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Casa"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    @* Tabela de Extrato Modernizada *@
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-receipt-cutoff me-2"></i>Extrato Mensal</h5>

            <div class="d-flex gap-2">
                <button class="btn btn-secondary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalSimularGasto">
                    <i class="bi bi-plus-lg me-1"></i> Simular gasto
                </button>

                <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNovoLancamento">
                    <i class="bi bi-plus-lg me-1"></i> Lançar Gasto
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th style="width: 100px;">Data</th>
                        <th>Descrição</th>
                        <th>Categoria</th>
                        <th>Pagamento</th>
                        <th class="text-end">Valor</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var hoje = DateTime.Today;

                        var entradas = Model.Lancamentos.Where(x => x.Tipo == "Entrada").OrderBy(x => x.Data);

                        var despesasPorCategoria = Model.Lancamentos
                        .Where(x => x.Tipo == "Despesa")
                        .GroupBy(x => x.Categoria)
                        .OrderBy(g => g.Key);
                    }

                    @* --- BLOCO DE ENTRADAS --- *@
                    @if (entradas.Any())
                    {
                        <tr class="table-success opacity-75">
                            <td colspan="6" class="fw-bold small text-uppercase text-success py-2 px-3">
                                <i class="bi bi-patch-check-fill me-2"></i>Receitas e Rendimentos
                            </td>
                        </tr>
                        @foreach (var item in entradas)
                        {
                            var diasParaVencer = (item.Data.Date - hoje).Days;

                            // Estilos padrão do seu exemplo
                            var classeCorData = "text-muted";
                            var classeCorLinha = ""; // Nova variável para controlar o fundo da linha inteira

                            if (diasParaVencer <= 0)
                            {
                                classeCorData = "text-success fw-bold";     // Mudado para Verde para destacar o Recebido
                                classeCorLinha = "bg-success-subtle bg-opacity-50"; // Pinta a linha inteira de Verde Suave
                            }
                            else if (diasParaVencer == 1)
                            {
                                classeCorData = "text-danger fw-bold";      // Vermelho para AMANHÃ no texto
                                classeCorLinha = "";                        // Mantém a linha limpa para destacar o texto vermelho
                            }

                            <tr class="@classeCorLinha align-middle">
                                <td class="ps-3 @classeCorData">
                                    <i class="bi bi-clock me-1"></i>@item.Data.ToString("dd MMM")
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-light p-2 me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                                            <i class="bi @(item.Categoria == "Salário" ? "bi-cash-stack text-purple" :
                                                                                      item.Categoria == "Alimentação" ? "bi-egg-fried text-purple" :
                                                                                      item.Categoria == "Transporte" ? "bi-car-front text-purple" :
                                                                                      item.Categoria == "Lazer" ? "bi-controller text-purple" :
                                                                                      item.Categoria == "Investimento" ? "bi-graph-up-arrow text-purple" :
                                                                                      item.Categoria == "Roupas/Shopping" ? "bi-bag-check text-purple" :
                                                                                      item.Categoria == "Estudos" ? "bi-book text-purple" :
                                                                                      item.Categoria == "Eletrônicos" ? "bi-cpu text-purple" :
                                                                                      item.Categoria == "Farmácia" ? "bi-capsule text-purple" :
                                                                                      item.Categoria == "Serviços" ? "bi-tools text-purple" : "bi-tag text-purple")"></i>
                                </div>
                                <span class="fw-bold @classeCorData">@item.Descricao</span>
                            </div>
                        </td>
                        <td>
                            @{
                                        var badgeClass = item.Categoria switch
                                        {
                                            "Salário" => "bg-success-subtle text-dark",
                                            "Moradia" => "bg-info-subtle text-dark",
                                            "Alimentação" => "bg-warning-subtle text-dark",
                                            "Transporte" => "bg-primary-subtle text-dark",
                                            "Investimento" => "bg-success-subtle text-dark",
                                            "Farmácia" => "bg-danger-subtle text-dark",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge rounded-pill border @badgeClass fw-normal" style="font-size: 0.7rem;">@item.Categoria.ToUpper()</span>
                                </td>
                                <td>
                                    <div class="pay-method border small p-1 rounded bg-white d-inline-block">
                                        <i class="bi @(item.Pagamento.Contains("Crédito") ? "bi-credit-card text-primary" : "bi-qr-code text-info") me-1"></i>
                                        @item.Pagamento
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-dark">@item.Valor.ToString("C2")</td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button type="button" class="btn btn-sm btn-link text-primary p-0" data-bs-toggle="modal" data-bs-target="#editModal-@item.Id"><i class="bi bi-pencil-fill"></i></button>
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id"><i class="bi bi-trash-fill"></i></button>
                                    </div>
                                </td>
                            </tr>
                            @await Html.PartialAsync("Edit", item)
                            @await Html.PartialAsync("Delete", item)
                        }
                    }
                    <tr class="table-danger opacity-75">
                        <td colspan="6" class="fw-bold small text-uppercase text-danger py-2 px-3">
                            <i class="bi bi-patch-check-fill me-2"></i>Despesas
                        </td>
                    </tr>
                    @* --- BLOCO DE DESPESAS POR CATEGORIA --- *@
                    @foreach (var grupo in despesasPorCategoria)
                    {
                        <tr class="table-light">
                            <td colspan="4" class="fw-bold small text-uppercase text-secondary py-2 px-3">
                                <i class="bi bi-tag-fill me-2"></i>@grupo.Key
                            </td>
                            <td class="text-end fw-bold text-secondary pe-3">
                                <small>Subtotal: @grupo.Sum(x => x.Valor).ToString("C2")</small>
                            </td>
                            <td></td>
                        </tr>

                        @foreach (var item in grupo.OrderBy(x => x.Data))
                        {
                            // Lógica de cores baseada na proximidade da data
                            var diasParaVencer = (item.Data.Date - hoje).Days;
                            var classeCorData = "text-muted";

                            if (diasParaVencer <= 0)
                            {
                                classeCorData = "text-primary fw-bold"; // Azul para HOJE
                            }
                            else if (diasParaVencer == 1)
                            {
                                classeCorData = "text-danger fw-bold"; // Vermelho para AMANHÃ
                            }

                            <tr>
                                <td class="ps-3 @classeCorData">
                                    <i class="bi bi-clock me-1"></i>@item.Data.ToString("dd MMM")
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-light p-2 me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                                            <i class="bi @(item.Categoria == "Salário" ? "bi-cash-stack text-purple" :
                                                                                   item.Categoria == "Alimentação" ? "bi-egg-fried text-purple" :
                                                                                   item.Categoria == "Transporte" ? "bi-car-front text-purple" :
                                                                                   item.Categoria == "Lazer" ? "bi-controller text-purple" :
                                                                                   item.Categoria == "Investimento" ? "bi-graph-up-arrow text-purple" :
                                                                                   item.Categoria == "Roupas/Shopping" ? "bi-bag-check text-purple" :
                                                                                   item.Categoria == "Estudos" ? "bi-book text-purple" :
                                                                                   item.Categoria == "Eletrônicos" ? "bi-cpu text-purple" :
                                                                                   item.Categoria == "Farmácia" ? "bi-capsule text-purple" :
                                                                                   item.Categoria == "Serviços" ? "bi-tools text-purple" :
                                                                                   item.Categoria == "Estudos" ? "bi-book text-purple" : "bi-tag text-purple")"></i>
                                    
                                                                                                                                                                                       
                                </div>
                                <span class="fw-bold @classeCorData">@item.Descricao</span>
                            </div>
                        </td>
                        <td>
                            @{
                                        var badgeClass = item.Categoria switch
                                        {
                                            "Salário" => "bg-success-subtle text-dark",
                                            "Moradia" => "bg-info-subtle text-dark",
                                            "Alimentação" => "bg-warning-subtle text-dark",
                                            "Transporte" => "bg-primary-subtle text-dark",
                                            "Investimento" => "bg-success-subtle text-dark",
                                            "Farmácia" => "bg-danger-subtle text-dark",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge rounded-pill border @badgeClass fw-normal" style="font-size: 0.7rem;">@item.Categoria.ToUpper()</span>
                                </td>
                                <td>
                                    <div class="pay-method border small p-1 rounded bg-white d-inline-block">
                                        <i class="bi @(item.Pagamento.Contains("Crédito") ? "bi-credit-card text-primary" : "bi-qr-code text-info") me-1"></i>
                                        @item.Pagamento
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-dark">@item.Valor.ToString("C2")</td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button type="button" class="btn btn-sm btn-link text-primary p-0" data-bs-toggle="modal" data-bs-target="#editModal-@item.Id"><i class="bi bi-pencil-fill"></i></button>
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id"><i class="bi bi-trash-fill"></i></button>
                                    </div>
                                </td>
                            </tr>
                            @await Html.PartialAsync("Edit", item)
                            @await Html.PartialAsync("Delete", item)
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@await Html.PartialAsync("_ModalDespesasCasa", Model)
@await Html.PartialAsync("_ModalSimuladorAporte", Model)
@await Html.PartialAsync("_ModalResumoDespesas", Model)
@await Html.PartialAsync("_ModalSimularGasto", Model)

<div class="modal fade" id="modalNovoLancamento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle me-2"></i>Adicionar Lançamento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post" asp-route-visao="@ViewBag.VisaoAtual">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label name="Dono" class="form-label">Quem é o dono deste lançamento?</label>
                        <select name="Dono" class="form-select">
                            <option value="Gabriel" selected="@(ViewBag.VisaoAtual == "Gabriel")">Gabriel</option>
                            <option value="Ela" selected="@(ViewBag.VisaoAtual == "Ela")">Suely</option>
                            <option value="Casal" selected="@(ViewBag.VisaoAtual == "Casal")">Nosso</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tipo de Fluxo</label>
                        <select id="selectTipoFluxo" name="Tipo" class="form-select rounded-3" required>
                            <option value="Despesa">Saída (Gasto)</option>
                            <option value="Entrada">Entrada (Ganho)</option>
                        </select>
                    </div>

                    <div id="secaoSugestoes" class="mb-3 d-none animate__animated animate__fadeIn">
                        <label class="form-label small fw-bold text-muted text-uppercase">Preenchimento Rápido</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="preencher('Salário do dia 15', 1137.00, 'Salário', 15, 'Pagamento')">Salário (Dia 15)</button>
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="preencher('Salário do dia 30', 1340.00, 'Salário', 30, 'Pagamento')">Salário (Dia 30)</button>
                            <button type="button" class="btn btn-sm btn-outline-warning rounded-pill" onclick="preencher('PPR / Bônus', 6000.00, 'Salário', 01, 'Pagamento')">PPR</button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="preencher('13º Salário', 1420.00, 'Salário', 30, 'Pagamento')">13º 1º parcela</button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="preencher('Ajuda facul', 226.00, 'Salário', 10, 'Pix')">Ajuda facul</button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" onclick="preencher('Férias', 3400.00, 'Salário', 30, 'Pagamento')">Férias</button>

                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill" onclick="preencherComData('Rendimento Automático Renda Variável', 0, 'Investimento', 30, 'Pix')">Proventos RV</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">O que é? (Descrição)</label>
                        <input type="text" name="Descricao" class="form-control rounded-3" placeholder="Ex: Supermercado, Salário, Internet" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Valor Total (R$)</label>
                            <input name="Valor" class="form-control rounded-3" type="text" placeholder="0,00" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Nº de Parcelas</label>
                            <input name="numParcelas" class="form-control rounded-3" type="number" value="1" min="1" />
                            <div class="form-text text-info small"><i class="bi bi-info-circle"></i> Para compras em 1x, deixe 1.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Data</label>
                            <input type="date" name="Data" class="form-control rounded-3" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Categoria</label>
                            <select name="Categoria" class="form-select rounded-3">
                                <option value="Salário">Salário</option>
                                <option value="Moradia">Moradia</option>
                                <option value="Alimentação">Alimentação</option>
                                <option value="Transporte">Transporte</option>
                                <option value="Lazer">Lazer</option>
                                <option value="Investimento">Investimento</option>
                                <option value="Roupas/Shopping">Roupas/Shopping</option>
                                <option value="Estudos">Estudos</option>
                                <option value="Eletrônicos">Eletrônicos</option>
                                <option value="Serviços">Serviços</option>
                                <option value="Farmácia">Farmácia</option>
                                <option value="Estudos">Estudos</option>
                                <option value="Outros">Outros</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-bold">Método de Pagamento</label>
                        <select name="Pagamento" class="form-select rounded-3">
                            <option value="Pix">Pix / Dinheiro</option>
                            <option value="Cartão Crédito">Cartão de Crédito</option>
                            <option value="Cartão Débito">Cartão de Débito</option>
                            <option value="Pagamento">Pagamento</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Salvar Lançamento</button>
                </div>
            </form>
        </div>
