</div>

<script>
        console.log("Script de monitoramento carregado!");

        document.addEventListener("click", function (e) {
            if (e.target && e.target.classList.contains('btn-salvar-edicao')) {

                const form = e.target.closest('form');

                if (form) {
                    const valorInput = form.querySelector('input[name="Valor"]');
                    const acrescimoInput = form.querySelector('input[id^="inputAcrescimo-"]');

                    if (acrescimoInput && acrescimoInput.value && acrescimoInput.value !== "0" && acrescimoInput.value !== "") {

                        console.log("Valor atual no campo: " + valorInput.value);
                        console.log("Valor a adicionar: " + acrescimoInput.value);

                        let valorLimpo = valorInput.value;
                        let valorAtual = parseFloat(valorLimpo) || 0;

                        let valorAdicional = parseFloat(acrescimoInput.value) || 0;

                        let novoTotal = valorAtual + valorAdicional;

                        valorInput.value = novoTotal;

                        console.log("Sucesso! Novo total enviado: " + valorInput.value);

                        acrescimoInput.value = "";
                    }
                }
            }
        });
            function preencherComData(descricaoBase, valor, categoria, dia, pagamento) {
            const dataAtual = new Date();

            const mes = String(dataAtual.getMonth() + 1).padStart(2, '0');
            const ano = dataAtual.getFullYear();

            const descricaoFinal = `${descricaoBase} - ${mes}/${ano}`;

            if (typeof preencher === "function") {
                preencher(descricaoFinal, valor, categoria, dia, pagamento);
            } else {
                console.error("A função 'preencher' original não foi encontrada no escopo.");
            }
        }
        function preencher(desc, valor, cat, dia, Pagamento) {
        const modal = document.getElementById('modalNovoLancamento');
        const inputDesc = modal.querySelector('input[name="Descricao"]');
        const inputValor = modal.querySelector('input[name="Valor"]');
        const selectCat = modal.querySelector('select[name="Categoria"]');
        const inputData = modal.querySelector('input[name="Data"]');
        const selectPag = modal.querySelector('select[name="Pagamento"]');

        if (inputDesc) inputDesc.value = desc;
        if (inputValor) inputValor.value = valor.toFixed(2).replace('.', ',');
        if (selectCat) selectCat.value = cat;
        if (selectPag) selectPag.value = Pagamento;

        if (dia && inputData) {
            const agora = new Date();
            const ano = agora.getFullYear();
            const mes = String(agora.getMonth() + 1).padStart(2, '0');
            const diaFormatado = String(dia).padStart(2, '0');
            inputData.value = `${ano}-${mes}-${diaFormatado}`;
        }
    }

    // 2. Lógica para mostrar/esconder as sugestões
    document.addEventListener("DOMContentLoaded", function() {
        const selectTipo = document.getElementById('selectTipoFluxo');
        const secao = document.getElementById('secaoSugestoes');

        if (selectTipo && secao) {
            selectTipo.addEventListener('change', function() {
                if (this.value === 'Entrada') {
                    secao.classList.remove('d-none');
                } else {
                    secao.classList.add('d-none');
                }
            });

            // Disparar uma vez no início caso o modal abra já em "Entrada"
            if (selectTipo.value === 'Entrada') {
                secao.classList.remove('d-none');
            }
        }
    });

        function filtrarPorTexto() {
        // 1. Pega o valor digitado
        var input = document.getElementById("filtroTexto");
        var filter = input.value.toUpperCase();

        // 2. Localiza as linhas da tabela
        var table = document.querySelector(".table");
        var tr = table.getElementsByTagName("tr");

        for (var i = 0; i < tr.length; i++) {
            // Pula as linhas que são apenas títulos de seção (Receitas/Despesas)
            if (tr[i].classList.contains('table-light')) continue;

            var tdDesc = tr[i].getElementsByTagName("td")[1];
            var tdCat = tr[i].getElementsByTagName("td")[2];

            if (tdDesc || tdCat) {
                var txtValueDesc = tdDesc.textContent || tdDesc.innerText;
                var txtValueCat = tdCat.textContent || tdCat.innerText;

                // Se o texto digitado existir em qualquer uma das colunas, mostra a linha
                if (txtValueDesc.toUpperCase().indexOf(filter) > -1 ||
                    txtValueCat.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }
    let chartRF = null;

    function renderizarGraficoRF() {
        const canvas = document.getElementById('chartGanhosRendaFixa');
        if (!canvas) return;

        // Pega o valor base calculado no C# para o mês atual
        const rendimentoMensalAtual = parseFloat('@Model.RendimentoRendaFixaMes.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)') || 0;

        let labels = [];
        let dadosRendimento = [];
        const dataAtual = new Date();

        // Gera a simulação retroativa dos últimos 12 meses
        for (let i = 11; i >= 0; i--) {
            let d = new Date(dataAtual.getFullYear(), dataAtual.getMonth() - i, 1);
            let nomeMes = d.toLocaleString('pt-BR', { month: 'short' }).toUpperCase().replace('.', '');
            labels.push(nomeMes + '/' + d.getFullYear().toString().substring(2));

            // Simula uma variação histórica padrão estável (pode ser refinada com dados reais do banco futuramente)
            let variacaoAjuste = 1 - (i * 0.015);
            dadosRendimento.push((rendimentoMensalAtual * variacaoAjuste).toFixed(2));
        }

        const ctx = canvas.getContext('2d');
        if (chartRF) chartRF.destroy();

        chartRF = new Chart(ctx, {
            type: 'bar', // Formato em barras fica excelente para visualizar rendimentos mensais fixos
            data: {
                labels: labels,
                datasets: [{
                    label: 'Rendimento Líquido Estimado (R$)',
                    data: dadosRendimento,
                    backgroundColor: '#198754', // Verde correspondente ao card de entradas
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: (v) => 'R$ ' + v.toLocaleString('pt-BR') }
                    }
                }
            }
        });
    }

    // Monitora a abertura do modal e a troca de abas para renderizar o gráfico sem sumir ou quebrar proporção
    document.addEventListener("DOMContentLoaded", function () {
        const modalGanhos = document.getElementById('modalDetalheGanhos');
        if (modalGanhos) {
            modalGanhos.addEventListener('shown.bs.modal', renderizarGraficoRF);
        }

        // Corrige bug do Chart.js caso o usuário mude de aba e volte
        const botaoTabRF = document.getElementById('rf-tab');
        if (botaoTabRF) {
            botaoTabRF.addEventListener('shown.bs.tab', renderizarGraficoRF);
        }
    });
</script>

