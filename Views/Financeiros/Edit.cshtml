@model Acoes_Fiis.Models.Financeiro

@{
    Layout = null;
}

<div class="modal fade" id="editModal-@Model.Id" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Editar Lançamento Financeiro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Edit" asp-route-visao="@ViewBag.VisaoAtual" method="post">
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" name="Dono" value="@ViewBag.VisaoAtual" />

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label"></label>
                        <input asp-for="Descricao" class="form-control" />
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label asp-for="Valor" class="form-label">Valor (R$)</label>
                            <input asp-for="Valor" id="inputValor-@Model.Id" class="form-control" type="text" data-valor-original="@Model.Valor" />
                            <span asp-validation-for="Valor" class="text-danger"></span>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label class="form-label text-success">Somar (+ R$)</label>
                            <input id="inputAdicional-@Model.Id" class="form-control border-success text-success" type="number" step="0.01" placeholder="0,00" oninput="jsCalcular_@(Model.Id)()" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Data" class="form-label"></label>
                            <input asp-for="Data" class="form-control" type="date" />
                            <span asp-validation-for="Data" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Tipo" class="form-label"></label>
                            <select asp-for="Tipo" class="form-select">
                                <option value="Entrada">Entrada</option>
                                <option value="Despesa">Despesa</option>
                            </select>
                            <span asp-validation-for="Tipo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Categoria" class="form-label"></label>
                            <select asp-for="Categoria" class="form-select">
                                <option value="Salário">Salário</option>
                                <option value="Moradia">Moradia</option>
                                <option value="Alimentação">Alimentação</option>
                                <option value="Transporte">Transporte</option>
                                <option value="Lazer">Lazer</option>
                                <option value="Investimento">Investimento</option>
                                <option value="Roupas/Shopping">Roupas/Shopping</option>
                                <option value="Estudos">Estudos</option>
                                <option value="Eletrônicos">Eletrônicos</option>
                                <option value="Farmácia">Farmácia</option>
                                <option value="Serviços">Serviços</option>
                                <option value="Outros">Outros</option>
                            </select>
                            <span asp-validation-for="Categoria" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Pagamento" class="form-label">Método de Pagamento</label>
                        <select asp-for="Pagamento" class="form-select">
                            <option value="Pix">Pix / Dinheiro</option>
                            <option value="Cartão Crédito">Cartão de Crédito</option>
                            <option value="Cartão Débito">Cartão de Dezbito</option>
                        </select>
                        <span asp-validation-for="Pagamento" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-salvar-edicao">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function jsCalcular_@(Model.Id)() {
        var inputPrincipal = document.getElementById("inputValor-@Model.Id");
        var inputAdicional = document.getElementById("inputAdicional-@Model.Id");

        if (inputPrincipal && inputAdicional) {
            var valorOriginalStr = inputPrincipal.getAttribute("data-valor-original").replace(',', '.');
            var valorOriginal = parseFloat(valorOriginalStr) || 0;

            var valorAdicional = parseFloat(inputAdicional.value) || 0;

            var resultadoFinal = valorOriginal + valorAdicional;

            inputPrincipal.value = resultadoFinal.toFixed(2).replace('.', ',');
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}