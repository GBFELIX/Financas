@model Acoes_Fiis.Models.AtivoGeral

@{
    ViewData["Title"] = "Excluir Ativo";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <h4 class="mb-0">Confirmar Exclusão</h4>
                </div>
                <div class="card-body">
                    <p class="lead text-center">Tem certeza de que deseja remover este ativo da sua lista de monitoramento?</p>
                    <hr />

                    <dl class="row px-3">
                        <dt class="col-sm-4 text-muted">Classe</dt>
                        <dd class="col-sm-8 fw-bold">
                            <span class="badge bg-dark">@Html.DisplayFor(model => model.ClasseAtivo)</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Ticker / Símbolo</dt>
                        <dd class="col-sm-8 fw-bold text-primary">@Html.DisplayFor(model => model.Ticker)</dd>

                        <dt class="col-sm-4 text-muted">Nome do Ativo</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Nome)</dd>

                        <dt class="col-sm-4 text-muted">Cotação Atual</dt>
                        <dd class="col-sm-8">
                            R$ @Model.PrecoAtual.ToString(Model.ClasseAtivo == "Cripto" ? "N4" : "N2")
                        </dd>

                        <dt class="col-sm-4 text-muted">Última Atualização</dt>
                        <dd class="col-sm-8 small">@Html.DisplayFor(model => model.DataAtualizacao)</dd>
                    </dl>

                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle"></i>
                        <strong>Atenção:</strong> Esta ação removerá apenas o ativo da lista de monitoramento. No futuro, se houver ordens vinculadas, a exclusão pode afetar o cálculo do seu patrimônio total.
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Cancelar e Voltar
                        </a>
                        <form asp-action="Delete">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash"></i> Confirmar Exclusão
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}