@model IEnumerable<Acoes_Fiis.Models.AtivoGeral>

@{
    ViewData["Title"] = "Mercado Global";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            🌎 Mercado Global
            <button type="button" class="btn btn-link p-0 ms-2" data-bs-toggle="modal" data-bs-target="#modalInfoGlobal">
                <i class="bi bi-question-circle text-info" style="font-size: 1.5rem;"></i>
            </button>
        </h1>
        <a asp-action="Create" class="btn btn-primary">Novo Ativo Manual</a>
    </div>

    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <form asp-action="BuscarYahoo" method="get" class="d-flex">
                        <input type="text" name="ticker" class="form-control me-2" placeholder="Ex: BTC-USD, IVVB11" required>
                        <button type="submit" class="btn btn-dark text-nowrap">Analisar</button>
                    </form>
                </div>

                <div class="col-md-4">
                    <form asp-action="Index" method="get" class="d-flex">
                        <select name="filtroClasse" class="form-select me-2" onchange="this.form.submit()">
                            <option value="">Todas as Classes</option>
                            @foreach (var classe in (List<string>)ViewBag.Classes)
                            {
                                <!option value="@classe" @(Context.Request.Query["filtroClasse"] == classe ? "selected" : "")>@classe</!option>
                            }
                        </select>
                        <noscript><button type="submit" class="btn btn-secondary">Filtrar</button></noscript>
                    </form>
                </div>

                <div class="col-md-3">
                    <form asp-action="AtualizarTodos" method="post">
                        <input type="hidden" name="filtroClasse" value="@Context.Request.Query["filtroClasse"]" />
                        <button type="submit" class="btn btn-outline-success w-100 fw-bold">
                            🔄 Atualizar Filtrados
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive shadow rounded">
        <table class="table table-hover align-middle bg-white mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Classe</th>
                    <th>Ticker</th>
                    <th>Nome</th>
                    <th>Preço Atual (BRL)</th>
                    <th>Recomendação</th>
                    <th>Moeda</th>
                    <th>Última Atualização</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @switch (item.ClasseAtivo)
                            {
                                case "Cripto":
                                    <span class="badge bg-warning text-dark">₿ Cripto</span>
                                    break;
                                case "BDR":
                                    <span class="badge bg-info text-dark">🌍 BDR</span>
                                    break;
                                case "ETF":
                                    <span class="badge bg-primary">📊 ETF</span>
                                    break;
                                case "Ouro":
                                    <span class="badge bg-secondary" style="background-color: #ffd700 !important; color: black;">📀 Ouro</span>
                                    break;
                                case "Moeda":
                                    <span class="badge bg-success">💵 Moeda</span>
                                    break;
                                default:
                                    <span class="badge bg-dark">@item.ClasseAtivo</span>
                                    break;
                            }
                        </td>
                        <td class="fw-bold">@item.Ticker</td>
                        <td>@item.Nome</td>
                        <td class="fw-bold">
                            R$ @item.PrecoAtual.ToString(item.ClasseAtivo == "Cripto" || item.ClasseAtivo == "Moeda" ? "N4" : "N2")
                        </td>

                        @* LÓGICA DE RECOMENDAÇÃO BASEADA NA CLASSE *@
                        <td>
                            @{
                                string rec = "Analisar";
                                string cor = "bg-secondary";

                                switch (item.ClasseAtivo)
                                {
                                    case "Cripto":
                                        rec = "Especulativo";
                                        cor = "bg-dark";
                                        break;
                                    case "BDR":
                                    case "ETF":
                                        rec = "Diversificar";
                                        cor = "bg-primary";
                                        break;
                                    case "Ouro":
                                    case "Moeda":
                                        rec = "Hedge";
                                        cor = "bg-info text-dark";
                                        break;
                                }
                            }
                            <span class="badge @cor">@rec</span>
                        </td>

                        <td><span class="badge border text-dark">@item.Moeda</span></td>
                        <td>
                            <small>@item.DataAtualizacao.ToString("dd/MM HH:mm")</small>
                            @if (item.DataAtualizacao > DateTime.Now.AddMinutes(-30))
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Remover</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalInfoGlobal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">📖 Guia de Ativos Globais</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-6 border-bottom pb-2">
                        <h6><strong>🌍 BDR (Brazilian Depositary Receipts)</strong></h6>
                        <p class="small text-muted">Certificados de ações estrangeiras negociados no Brasil. Recomendação: <strong>Diversificar</strong> para reduzir o risco geográfico.</p>
                    </div>
                    <div class="col-md-6 border-bottom pb-2">
                        <h6><strong>📊 ETF (Exchange Traded Funds)</strong></h6>
                        <p class="small text-muted">Fundos de índice que permitem exposição a setores inteiros. Recomendação: <strong>Diversificar</strong> com baixo custo.</p>
                    </div>
                    <div class="col-md-6">
                        <h6><strong>₿ Criptomoedas</strong></h6>
                        <p class="small text-muted">Ativos de alta volatilidade. Recomendação: <strong>Especulativo</strong> devido ao risco de mercado acentuado.</p>
                    </div>
                    <div class="col-md-6">
                        <h6><strong>📀 Ouro / Commodities</strong></h6>
                        <p class="small text-muted">Reserva de valor real. Recomendação: <strong>Hedge</strong> para proteger a carteira contra crises e inflação.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <small class="text-center w-100">Dica CPA-20: Ativos globais protegem seu patrimônio contra a desvalorização do Real!</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}