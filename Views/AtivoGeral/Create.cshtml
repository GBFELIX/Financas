@model Acoes_Fiis.Models.AtivoGeral

@{
    ViewData["Title"] = "Confirmar Cadastro";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">✨ Confirmar Ativo Global</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Ticker" class="form-label fw-bold"></label>
                                    <input asp-for="Ticker" class="form-control bg-light" readonly />
                                    <span asp-validation-for="Ticker" class="text-danger"></span>
                                    <small class="text-muted">Ticker vindo do Yahoo Finance.</small>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Nome" class="form-label fw-bold"></label>
                                    <input asp-for="Nome" class="form-control" placeholder="Ex: Bitcoin ou Apple BDR" autofocus />
                                    <span asp-validation-for="Nome" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="PrecoAtual" class="form-label fw-bold"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">R$</span>
                                        @* lang="pt-BR" ajuda o browser a entender a vírgula *@
                                        <input asp-for="PrecoAtual" type="text" class="form-control" lang="pt-BR" />
                                    </div>
                                    <span asp-validation-for="PrecoAtual" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ClasseAtivo" class="form-label fw-bold"></label>
                                    <select asp-for="ClasseAtivo" class="form-select">
                                        <option value="Cripto">Criptomoeda</option>
                                        <option value="BDR">BDR (Internacional)</option>
                                        <option value="ETF">ETF (Índice)</option>
                                        <option value="Ouro">Ouro / Commodity</option>
                                        <option value="Moeda">Moeda Estrangeira</option>
                                    </select>
                                    <span asp-validation-for="ClasseAtivo" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Moeda" class="form-label fw-bold"></label>
                                    <select asp-for="Moeda" class="form-select">
                                        <option value="BRL">Real (BRL)</option>
                                        <option value="USD">Dólar (USD)</option>
                                    </select>
                                    <span asp-validation-for="Moeda" class="text-danger"></span>
                                </div>

                                <input type="hidden" asp-for="DataAtualizacao" />
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Voltar para Lista</a>
                            <button type="submit" class="btn btn-success px-5">Salvar Ativo</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="alert alert-info mt-3 small">
                <i class="bi bi-info-circle"></i> <strong>Dica:</strong> Se for uma Cripto (USD), o sistema fará a conversão para Reais automaticamente nas atualizações futuras.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Sobrescreve a validação de números do jQuery para aceitar vírgula como separador
        $(document).ready(function () {
            $.validator.methods.number = function (value, element) {
                // Aceita: 1000 | 1000.50 | 1000,50 | 1.000,50
                return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
            };
        });
    </script>
}