@model Acoes_Fiis.Models.CarteiraTotalViewModel

@{
    ViewData["Title"] = "Minha Carteira Profissional";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Minha Carteira</h1>
        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAdicionarAtivo">
            <i class="bi bi-plus-circle"></i> Adicionar Ativo
        </button>
    </div>
    <div class="row g-2 mb-4">
        @* Botão 1: Simulador de Dividendos (Nova Ferramenta) *@
        <div class="col-md-4">
            <button type="button" class="btn btn-outline-success w-100 shadow-sm rounded-3"
                    data-bs-toggle="modal" data-bs-target="#modalSimuladorDividendos">
                <i class="bi bi-calculator me-2"></i> Simulador de Dividendos
            </button>
        </div>

        @* Botão 2: Resumo Mensal *@
        <div class="col-md-4">
            <button type="button" class="btn btn-outline-primary w-100 shadow-sm rounded-3" data-bs-toggle="modal" data-bs-target="#modalResumoAnual">
                <i class="bi bi-calendar-check me-2"></i> Resumo Mensal (DRE)
            </button>
        </div>

        @* Botão 3: Radar de Aporte *@
        <div class="col-md-4">
            <button type="button" class="btn btn-outline-warning w-100 shadow-sm rounded-3 fw-bold" data-bs-toggle="modal" data-bs-target="#modalRadarAporte">
                <i class="bi bi-compass me-2"></i> Radar de Aporte
            </button>
        </div>
    </div>
    <div class="row g-3 mb-4">
        @* Botão 4: Painel de Amortização *@
        <div class="col-md-4">
            <button type="button" class="btn btn-outline-danger w-100 shadow-sm rounded-3 fw-bold" data-bs-toggle="modal" data-bs-target="#modalContraCheques">
                <i class="bi bi-bank me-2"></i> Contra-Cheques
            </button>
        </div>

        @* Botão 5: Evolução do Saldo Devedor *@
        <div class="col-md-4">
            <button type="button" class="btn btn-outline-dark w-100 shadow-sm rounded-3 fw-bold" data-bs-toggle="modal" data-bs-target="#modalEvolucaoDivida">
                <i class="bi bi-graph-down-arrow me-2"></i> Evolução da Dívida / Amortização
            </button>
        </div>

        @* Botão 6: Planejamento 2029 (Meta Apartamento) *@
        <div class="col-md-4">
            <button type="button" class="btn btn-outline-info w-100 shadow-sm rounded-3 fw-bold" data-bs-toggle="modal" data-bs-target="#modalStressTest">
                <i class="bi bi-shield-check me-2"></i> Escudo de Emergência
            </button>
        </div>
    </div>

    <div class="row mb-4 g-3">
        @* Card 1: Patrimônio com Fluxo Automático *@
        <div class="col-md-3">
            <div class="card bg-dark text-white shadow border-0 h-100 rounded-4"
                 style="cursor: pointer;"
                 data-bs-toggle="modal"
                 data-bs-target="#modalDetalhesPatrimonio">
                <div class="card-body text-center p-4">
                    <h6 class="text-uppercase small fw-bold text-info opacity-75">Patrimônio Bruto Real</h6>
                    <h2 class="mb-1 fw-bold">R$ @((Model.PatrimonioTotalReal).ToString("N2"))</h2>
                    @* Feedback visual sobre a data *@
                    <small class="text-muted">
                        <i class="bi bi-clock-history"></i> Atualizado até @DateTime.Now.ToString("dd/MM")
                    </small>
                </div>
            </div>
        </div>

        @* Card 2: Rendimentos Mensais *@
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow border-0 h-100 rounded-4">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small fw-bold opacity-75">Rendimentos do Mês</h6>
                    <h3 class="mb-1">R$ @Model.RendaMensalTotalConsolidada.ToString("N2")</h3>
                    <div class="mt-2 pt-2 border-top border-white border-opacity-25">
                        <small class="d-block">Ganhos (Mês): <span class="fw-bold">R$ @Model.EntradasMesCorrente.ToString("N2")</span></small>
                    </div>
                </div>
            </div>
        </div>

        @* Card 3: Projeção e Despesas *@
        <div class="col-md-3">
            <div class="card bg-info text-dark shadow border-0 h-100 rounded-4">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small fw-bold opacity-75">Projeção Anual (Proventos)</h6>
                    <h3 class="mb-1">R$ @Model.ProventoAnualEstimado.ToString("N2")</h3>
                    <div class="mt-2 pt-2 border-top border-dark border-opacity-10">
                        <small class="d-block text-danger fw-bold">Saídas (Mês): R$ @Model.SaidasMesCorrente.ToString("N2")</small>
                    </div>
                </div>
            </div>
        </div>


        @* Card 4: Resultado Geral de Carteira *@
        <div class="col-md-3">
            <div class="card shadow border-0 h-100 rounded-4 @(Model.TotalLucro >= 0 ? "bg-success" : "bg-danger") text-white">
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h6 class="text-uppercase small fw-bold opacity-75">Resultado RV</h6>
                    <h3 class="mb-0">R$ @Model.TotalLucro.ToString("N2")</h3>
                    <small class="mt-1">Lucro/Prejuízo Total</small>
                </div>
            </div>
        </div>
    </div>


    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success mt-3 alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div> 
    }
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-graph-up-arrow me-2"></i>Renda Variável</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th>Ticker</th>
                        <th>Qtd</th>
                        <th>P. Médio</th>
                        <th>P. Atual</th>
                        <th class="text-success">Rend./Cota</th>
                        <th class="text-success">Renda Mensal</th>
                        <th>Total</th>
                        <th>Lucro/Prej.</th>
                        <th>Status</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        string ultimoTipo = "";
                    }
                    @foreach (var item in Model.Itens.Where(x => x.TipoAtivo != "RendaFixa").OrderBy(x => x.TipoAtivo == "Acao" ? 0 : x.TipoAtivo == "Fii" ? 1 : 2).ThenBy(x => x.Ticker))
                    {
                        <div class="modal fade" id="modalCompra-@item.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow-lg rounded-4">
                                    <div class="modal-header bg-success text-white border-0 py-3">
                                        <h5 class="modal-title fw-bold">
                                            <i class="bi bi-graph-up-arrow me-2"></i>Registrar Compra - @item.Ticker
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-action="ComprarAtivo" asp-controller="Carteiras" asp-route-visao="@ViewBag.VisaoAtual" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />

                                        <div class="modal-body p-4">
                                            <div class="p-3 bg-light rounded-3 mb-3 border text-center" style="font-size: 0.85rem;">
                                                <div class="row">
                                                    <div class="col-4 border-end">
                                                        <small class="text-muted d-block">Qtd. Atual</small>
                                                        <span class="fw-bold text-dark" id="qtdAtual-@item.Id">@item.Quantidade</span>
                                                    </div>
                                                    <div class="col-4 border-end">
                                                        <small class="text-muted d-block">PM Atual</small>
                                                        <span class="fw-bold text-secondary">@item.PrecoMedio.ToString("C2")</span>
                                                    </div>
                                                    <div class="col-4">
                                                        <small class="text-muted d-block">Cotação Atual</small>
                                                        <span class="fw-bold text-success" id="precoAtual-@item.Id">@item.PrecoAtual.ToString("N2")</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-bold small text-muted text-uppercase">Quantidade a Comprar</label>
                                                <input type="number" name="quantidadeComprada" id="inputQtdCompra-@item.Id"
                                                       class="form-control form-control-lg text-center fw-bold text-success"
                                                       value="1" min="1" required oninput="calcularNovoPrecoMedio('@item.Id', @item.Quantidade, @item.PrecoMedio.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @item.PrecoAtual.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="p-3 border border-success-subtle bg-success bg-opacity-10 rounded-4 text-center">
                                                <div class="row">
                                                    <div class="col-6 border-end border-success-subtle">
                                                        <small class="text-muted small d-block text-uppercase" style="font-size:0.65rem;">Novo Custo do Aporte</small>
                                                        <span class="fw-bold text-dark" id="txtNovoAporte-@item.Id">R$ @item.PrecoAtual.ToString("N2")</span>
                                                    </div>
                                                    <div class="col-6">
                                                        <small class="text-muted small d-block text-uppercase" style="font-size:0.65rem;">Novo Preço Médio Estimado</small>
                                                        <span class="fw-bold text-success" id="txtNovoPM-@item.Id">R$ 0,00</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="modal-footer border-0 bg-light rounded-bottom-4 p-3">
                                            <button type="button" class="btn btn-secondary border-0 px-3 rounded-3" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-success fw-bold px-4 rounded-3 shadow-sm">Confirmar Compra</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="modal fade" id="modalVenda-@item.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow-lg rounded-4">
                                    <div class="modal-header bg-danger text-white border-0 py-3">
                                        <h5 class="modal-title fw-bold">
                                            <i class="bi bi-cash-stack me-2"></i>Registrar Venda - @item.Ticker
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-action="VenderAtivo" asp-route-visao="@ViewBag.VisaoAtual" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />

                                        <div class="modal-body p-4">
                                            <div class="p-3 bg-light rounded-3 mb-3 border text-center">
                                                <div class="row">
                                                    <div class="col-6 border-end">
                                                        <small class="text-muted d-block">Qtd. Disponível</small>
                                                        <span class="fw-bold text-dark">@item.Quantidade</span>
                                                    </div>
                                                    <div class="col-6">
                                                        <small class="text-muted d-block">Preço Médio atual</small>
                                                        <span class="fw-bold text-primary">@item.PrecoMedio.ToString("C2")</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-bold small">Quantidade a Vender</label>
                                                <input type="number" name="quantidadeVendida" class="form-control form-control-lg text-center"
                                                       value="@item.Quantidade" min="1" max="@item.Quantidade" required />
                                                <div class="form-text text-muted small text-center mt-1">
                                                    O sistema utilizará a cotação atual cadastrada para apurar o lucro ou prejuízo automaticamente.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="modal-footer border-0 bg-light rounded-bottom-4 p-3">
                                            <button type="button" class="btn btn-secondary border-0 px-3 rounded-3" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-danger fw-bold px-4 rounded-3 shadow-sm">Confirmar Venda</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        if (ultimoTipo != item.TipoAtivo)
                        {
                            <tr class="table-secondary">
                                <td colspan="10" class="fw-bold small text-uppercase">
                                    @(item.TipoAtivo == "Fii" ? "Fundos Imobiliários" :
                                     item.TipoAtivo == "Acao" ? "Ações" : "Geral / Outros")
                                </td>
                            </tr>
                                    ultimoTipo = item.TipoAtivo;
                        }
                        <tr>
                            <td class="fw-bold text-primary">@item.Ticker</td>
                            <td class="fw-bold text-success">@item.Quantidade.ToString("N0")</td>
                            <td>R$ @item.PrecoMedio.ToString("N2")</td>
                            <td>R$ @item.PrecoAtual.ToString("N2")</td>
                            <td class="text-success small">@(item.UltimoRendimento > 0 ? item.UltimoRendimento.ToString("C2") : "-")</td>
                            <td class="fw-bold text-success">@(item.ProventoMensalEstimado > 0 ? item.ProventoMensalEstimado.ToString("C2") : "-")</td>
                            <td class="fw-bold">R$ @item.ValorAtual.ToString("N2")</td>
                            <td class="@(item.LucroPrejuizo >= 0 ? "text-success" : "text-danger") fw-bold">
                                R$ @item.LucroPrejuizo.ToString("N2")
                            </td>
                            <td>
                                <span class="badge bg-@item.CorBadge">
                                    @item.Recomendacao
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm rounded-3" role="group" aria-label="Ações do Ativo">
                                    <button type="button" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1"
                                            data-bs-toggle="modal" data-bs-target="#modalCompra-@item.Id" title="Registrar Compra">
                                        <i class="bi bi-graph-up-arrow"></i>
                                        <span class="d-none d-md-inline">Comprar</span>
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalVenda-@item.Id"
                                            title="Registrar Venda">
                                        <i class="bi bi-graph-down-arrow"></i>
                                        <span class="d-none d-md-inline">Vender</span>
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 border-end-0"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal-@item.Id"
                                            title="Editar Ativo">
                                        <i class="bi bi-pencil-square"></i>
                                        <span class="d-none d-md-inline"></span>
                                    </button>
                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       asp-route-visao="@ViewBag.VisaoAtual"
                                       class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1"
                                       title="Excluir Ativo">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        @await Html.PartialAsync("Edit", new Acoes_Fiis.Models.Carteira
                        {
                                        Id = item.Id,
                                        Ticker = item.Ticker,
                                        Quantidade = item.Quantidade,
                                        PrecoMedio = item.PrecoMedio,
                                        TipoAtivo = item.TipoAtivo,
                                        // Setor = item.Setor,
                                        // DataCompra = item.DataCompra
                                        })
                    }  
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("ModalFinanceiro", Model)
    @await Html.PartialAsync("_ModalDetalhesPatrimonio", Model)
    @await Html.PartialAsync("_ModalRadarAporte", Model)
    @await Html.PartialAsync("_ModalContraCheque", Model)
    @await Html.PartialAsync("_ModalEvolucaoDivida", Model)
    @await Html.PartialAsync("_ModalEscudo", Model)
    @await Html.PartialAsync("_ModalSimulacao", Model)

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-muted"><i class="bi bi-safe me-2"></i>Renda Fixa & Reserva</h5>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalNovoRF">
                <i class="bi bi-plus-lg"></i> Novo Título
            </button>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th>Classe / Título</th>
                        <th>Montante Investido</th>
                        <th>Taxa (% a.m)</th>
                        <th>Rend. Bruto</th>
                        <th>IR (17,5%)</th>
                        <th class="text-success text-end">Rend. Líquido</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rf in Model.Itens.Where(x => x.TipoAtivo == "RendaFixa"))
                    {
                        <tr>
                            <td class="fw-bold">@rf.Ticker</td>
                            <td>
                                <form asp-action="AtualizarRendaFixa" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@rf.Id" />
                                    <input type="hidden" name="Dono" value="@ViewBag.VisaoAtual" />
                                    <div class="input-group input-group-sm" style="width: 150px;">
                                        <span class="input-group-text">R$</span>
                                        <input type="text" name="novoMontante" class="form-control" data-val="false" value="@rf.PrecoMedio.ToString("N2")" placeholder="@rf.PrecoMedio.ToString("N2")" />
                                    </div>
                                    <div class="input-group input-group-sm" style="width: 100px;">

                                        <input type="text" name="novaTaxa" class="form-control" data-val="false"  value="@rf.TaxaRentabilidade?.ToString("N2")" placeholder="@rf.TaxaRentabilidade?.ToString("N2")" />

                                        <span class="input-group-text">%</span>

                                    </div>
                                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i></button>
                                </form>
                            </td>
                            <td>@rf.TaxaRentabilidade?.ToString("N2")%</td>
                            <td class="text-muted small">R$ @((rf.PrecoMedio * (rf.TaxaRentabilidade ?? 0) / 100).ToString("N2"))</td>
                            <td class="text-danger small">- R$ @((rf.PrecoMedio * (rf.TaxaRentabilidade ?? 0) / 100 * 0.175m).ToString("N2"))</td>
                            <td class="fw-bold text-success text-end">R$ @rf.ProventoMensalEstimado.ToString("N2")</td>
                            <td class="text-center">
                                <a asp-action="Delete" asp-route-id="@rf.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<div class="modal fade" id="modalAdicionarAtivo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-success text-white border-0 py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-plus-circle me-2"></i>Novo Lançamento na Carteira
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="AdicionarAtivo" method="post" asp-route-visao="@ViewBag.VisaoAtual">
                <div class="modal-body p-4">

                    <div class="mb-4">
                        <label for="selectModalTicker" class="form-label fw-bold small text-muted text-uppercase mb-2">
                            Selecione o Ativo (Ações, FIIs ou Gerais)
                        </label>
                        <select id="selectModalTicker" name="ticker" class="form-select" required>
                            <option value="">Pesquise pelo ticker ou nome...</option>

                            <optgroup label="Ações">
                                @foreach (var t in Model.ListaTickersAcoes)
                                {
                                    <option value="@t">📈 @t</option>
                                }
                            </optgroup>

                            <optgroup label="FIIs">
                                @foreach (var t in Model.ListaTickersFiis)
                                {
                                    <option value="@t">🏢 @t</option>
                                }
                            </optgroup>

                            <optgroup label="Outros (Cripto/BDR)">
                                @foreach (var t in Model.ListaTickersGerais)
                                {
                                    <option value="@t">🌐 @t</option>
                                }
                            </optgroup>
                        </select>
                    </div>

                    <input type="hidden" name="Dono" value="@ViewBag.VisaoAtual" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted text-uppercase">Quantidade</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-secondary-subtle text-secondary"><i class="bi bi-hash"></i></span>
                                <input type="number" name="quantidade" class="form-control border-secondary-subtle fw-semibold" placeholder="0" min="1" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted text-uppercase">Preço Médio de Execução</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-secondary-subtle text-success fw-bold">R$</span>
                                <input type="number" name="precoMedio" step="0.01" min="0.01" class="form-control border-secondary-subtle fw-semibold" placeholder="0,00" required />
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info border-0 bg-info bg-opacity-10 text-info-emphasis rounded-3 small d-flex align-items-center mb-0 mt-3">
                        <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                        <span><strong>Dica:</strong> O sistema identificará automaticamente a categoria do ativo e gerará o lançamento correspondente como despesa no seu fluxo financeiro.</span>
                    </div>
                </div>

                <div class="modal-footer border-top-0 bg-light rounded-bottom-4 p-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-3 opacity-75" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-save me-1"></i>Salvar na Carteira
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="modalNovoRF" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content text-dark">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="bi bi-piggy-bank me-2"></i>Novo Título de Renda Fixa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AdicionarRendaFixa" method="post" asp-route-visao="@ViewBag.VisaoAtual">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nome do Título / Instituição</label>
                        <input type="text" name="Ticker" class="form-control" placeholder="Ex: CDB Nubank, Tesouro Selic..." required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Montante Inicial</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input type="number" name="PrecoMedio" step="0.01" data-val="false" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Taxa Anual (Est.)</label>
                            <div class="input-group">
                                <input type="text" name="TaxaRentabilidade" step="0.01" data-val="false" class="form-control" placeholder="12.75" required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Notas / Objetivo</label>
                        <textarea name="Notas" class="form-control" rows="2" placeholder="Ex: Reserva para o apartamento"></textarea>
                    </div>
                    <input type="hidden" name="Dono" value="@ViewBag.VisaoAtual" />
                    <input type="hidden" name="TipoAtivo" value="RendaFixa" />
                    <input type="hidden" name="Quantidade" value="1" />
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success px-4">Salvar Investimento</button>
                </div>
            </form>
        </div>
    </div>
</div>

