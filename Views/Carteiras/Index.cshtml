@model Acoes_Fiis.Models.CarteiraTotalViewModel

@{
    ViewData["Title"] = "Minha Carteira Profissional";
}

<div class="container mt-4">
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
        <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-2">

            <div class="d-flex align-items-center gap-2">
                <div class="rounded-3 p-2 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                    <i class="bi bi-wallet2 fs-5"></i>
                </div>
                <h5 class="fw-bold text-dark mb-0 tracking-wide" style="font-size: 1.1rem;">Minha Carteira</h5>
            </div>

            <div class="d-flex align-items-center gap-2">

                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle d-inline-flex align-items-center gap-2 rounded-pill px-3 py-2 fw-semibold" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-sliders text-secondary"></i> Ferramentas e Análises
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2 p-1" style="min-width: 260px; font-size: 0.85rem;">
                        
                        <li>
                            <h6 class="dropdown-header text-uppercase text-muted fw-bold pb-1" style="font-size: 0.65rem;">Finanças & Financiamento</h6>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <button type="button" class="dropdown-item py-2 rounded-2 text-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalResumoAnual">
                                <i class="bi bi-calendar-check"></i> Resumo Mensal (DRE)
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item py-2 rounded-2 text-danger d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalContraCheques">
                                <i class="bi bi-bank"></i> Contra-Cheques
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item py-2 rounded-2 text-dark d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalEvolucaoDivida">
                                <i class="bi bi-graph-down-arrow"></i> Evolução da Dívida / Amortização
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item py-2 rounded-2 text-dark d-flex align-items-center gap-2"
                                    data-bs-toggle="modal" data-bs-target="#modalHistoricoAtivos">
                                <i class="bi bi-clock-history text-secondary"></i> Histórico de Trade (Ações/FIIs)
                            </button>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <h6 class="dropdown-header text-uppercase text-muted fw-bold pb-1" style="font-size: 0.65rem;">Simulador</h6>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <button type="button" class="dropdown-item py-2 rounded-2 text-success d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalSimuladorDividendos">
                                <i class="bi bi-calculator"></i> Simulador de Dividendos
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item py-2 rounded-2 text-warning fw-bold d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalPlanejamento">
                                <i class="bi bi-compass"></i> Futuro
                            </button>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <h6 class="dropdown-header text-uppercase text-muted fw-bold pb-1" style="font-size: 0.65rem;">Configurações</h6>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <button type="button" class="dropdown-item py-2 rounded-2 text-info fw-bold d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalStressTest">
                                <i class="bi bi-shield-check"></i> Escudo de Emergência
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item py-2 rounded-2 text-dark d-flex align-items-center gap-2"
                                    data-bs-toggle="modal" data-bs-target="#modalParametros">
                                <i class="bi bi-gear-fill text-secondary"></i> Ajustar Parâmetros (CDI)
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item py-2 rounded-2 text-danger d-flex align-items-center gap-2"
                                    data-bs-toggle="modal" data-bs-target="#modalBackup">
                                <i class="bi bi-cloud-arrow-up-fill"></i> Configurar Rotina de Backup
                            </button>
                        </li>
                        <li>
                            <button type="button" class="dropdown-item py-2 rounded-2 text-primary d-flex align-items-center gap-2"
                                    data-bs-toggle="modal" data-bs-target="#modalMetas">
                                <i class="bi bi-sliders"></i> Alterar Modo de Alocação
                            </button>
                        </li>
                    </ul>
                </div>

                <a href="https://www.investidor.b3.com.br/login?utm_source=B3_MVP&utm_medium=HM_PF&utm_campaign=menu"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-sm btn-primary d-inline-flex align-items-center gap-2 rounded-pill px-3 py-2 fw-bold shadow-sm">
                    <i class="bi bi-plus-circle-fill"></i> Acessar B3
                </a>

                <button type="button" class="btn btn-sm btn-success d-inline-flex align-items-center gap-2 rounded-pill px-3 py-2 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAdicionarAtivo">
                    <i class="bi bi-plus-circle-fill"></i> Adicionar Ativo
                </button>      

            </div>

        </div>
    </div>

    <style>
        .tracking-wide {
            letter-spacing: 0.3px;
        }
        /* Deixa o hover das opções do menu mais limpo e arredondado */
        .dropdown-item:hover {
            background-color: #f8f9fa;
        }

        .dropdown-item i {
            font-size: 1rem;
        }
    </style>

    <div class="row mb-4 g-3">
        @* Card 1: Patrimônio com Fluxo Automático *@
        <div class="col-md-3">
            <div class="card bg-dark text-white shadow border-0 h-100 rounded-4"
                 style="cursor: pointer;"
                 data-bs-toggle="modal"
                 data-bs-target="#modalDetalhesPatrimonio"
                 style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;"
                 onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 .5rem 1rem rgba(0,0,0,0.15)!important';"
                 onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none';">
                <div class="card-body text-center p-4">
                    <h6 class="text-uppercase small fw-bold text-info opacity-75">Patrimônio Bruto Real</h6>
                    <h2 class="mb-1 fw-bold">R$ @((Model.PatrimonioTotalReal).ToString("N2"))</h2>
                    @* Feedback visual sobre a data *@
                    <small class="text-muted">
                        <i class="bi bi-clock-history"></i> Atualizado até @DateTime.Now.ToString("dd/MM")
                    </small>
                </div>
            </div>
        </div>

        @* Card 2: Rendimentos Mensais *@
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow border-0 h-100 rounded-4"
                 style="cursor: pointer;"
                 data-bs-toggle="modal"
                 data-bs-target="#modalRendimentosERebalanceamento"
                 title="Clique para ver Detalhes e Rebalanceamento"
                 style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;"
                 onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 .5rem 1rem rgba(0,0,0,0.15)!important';"
                 onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none';">
                

                <div class="card-body text-center p-4">
                    <h6 class="text-uppercase small fw-bold opacity-75">Rendimentos do Mês</h6>
                    <h2 class="mb-1 fw-bold">R$ @Model.RendaMensalTotalConsolidada.ToString("N2")</h2>
                    <div class="mt-2 pt-2 border-top border-white border-opacity-25">
                        <small class="d-block">Ganhos (Mês): <span class="fw-bold">R$ @(Model.EntradasMesCorrente.ToString("N2"))</span></small>
                    </div>
                </div>
            </div>
        </div>

        @{
            // Matemática rápida de cobertura sem pesar o HTML
            decimal proventoMensalEstimado = Model.ProventoAnualEstimado / 12m;
            decimal divisorSaidas = Model.SaidasMesCorrente > 0 ? Model.SaidasMesCorrente : 1m;
            double percentualCobertura = (double)(proventoMensalEstimado / divisorSaidas) * 100;
        }

        @* Card 3: Projeção Anual (Gatilho para o Novo Diagnóstico de Alocação) *@
        <div class="col-md-3">
            <div class="card bg-info text-dark shadow border-0 h-100 rounded-4 position-relative"
                 data-bs-toggle="modal"
                 data-bs-target="#modalDiagnosticoAlocacao"
                 style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;"
                 onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 .5rem 1rem rgba(0,0,0,0.15)!important';"
                 onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none';">

                <div class="card-body text-center d-flex flex-column justify-content-between py-3">
                    <div>
                        <h6 class="text-uppercase small fw-bold opacity-75 mb-1">Projeção Anual (Proventos)</h6>
                        <h3 class="mb-0 fw-bold">R$ @Model.ProventoAnualEstimado.ToString("N2")</h3>
                    </div>

                    <div class="mt-2 pt-2 border-top border-dark border-opacity-10">
                        <small class="d-block text-danger fw-bold mb-1">
                            Saídas (Mês): R$ @Model.SaidasMesCorrente.ToString("N2")
                        </small>
                        <span class="badge bg-dark bg-opacity-10 text-dark fw-bold fs-7 px-2 py-1 rounded-pill">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Cobre @percentualCobertura.ToString("N0")% dos gastos
                        </span>
                    </div>

                    <div class="w-100 text-center opacity-50 mt-1" style="font-size: 0.65rem;">
                        <span class="text-uppercase fw-bold"><i class="bi bi-pie-chart me-1"></i>Ver Divisão Carteira</span>
                    </div>
                </div>
            </div>
        </div>


        @* Card 4: Resultado Geral de Carteira *@
        <div class="col-md-3">
            <div class="card shadow border-0 h-100 rounded-4 @(Model.TotalLucro >= 0 ? "bg-success" : "bg-danger") text-white position-relative card-interativo"
                 data-bs-toggle="modal"
                 data-bs-target="#modalRadarAporte"
                 style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;"
                 onmouseover="this.style.transform='scale(1.02)'; this.style.boxShadow='0 .5rem 1rem rgba(0,0,0,0.15)!important';"
                 onmouseout="this.style.transform='scale(1)'; this.style.boxShadow='none';">
                <div class="card-body text-center d-flex flex-column justify-content-center py-3">
                    <h6 class="text-uppercase small fw-bold opacity-75 mb-1">Resultado RV</h6>
                    <h3 class="mb-0 fw-bold">R$ @Model.TotalLucro.ToString("N2")</h3>
                    <small class="opacity-90 fs-7 mt-1">Lucro/Prejuízo Total</small>

                    <div class="position-absolute bottom-0 start-50 translate-middle-x mb-1 opacity-50 style-gatilho">
                        <small style="font-size: 0.65rem;" class="text-uppercase fw-bold letter-spacing-1"><i class="bi bi-search me-1"></i>Ver Diagnóstico</small>
                    </div>
                </div>
            </div>
        </div>


    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success mt-3 alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div> 
    }
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-graph-up-arrow me-2"></i>Renda Variável</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th>Ticker</th>
                        <th>Qtd</th>
                        <th>P. Médio</th>
                        <th>P. Atual</th>
                        <th class="text-success">Rend./Cota</th>
                        <th class="text-success">Renda Mensal</th>
                        <th>Total</th>
                        <th>Lucro/Prej.</th>
                        <th>Status</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        string ultimoTipo = "";
                    }
                    @foreach (var item in Model.Itens.Where(x => x.TipoAtivo != "RendaFixa").OrderBy(x => x.TipoAtivo == "Acao" ? 0 : x.TipoAtivo == "Fii" ? 1 : 2).ThenBy(x => x.Ticker))
                    {
                        <div class="modal fade" id="modalCompra-@item.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow-lg rounded-4">
                                    <div class="modal-header bg-success text-white border-0 py-3">
                                        <h5 class="modal-title fw-bold">
                                            <i class="bi bi-graph-up-arrow me-2"></i>Registrar Compra - @item.Ticker
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-action="ComprarAtivo" asp-controller="Carteiras" asp-route-visao="@ViewBag.VisaoAtual" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />

                                        <div class="modal-body p-4">
                                            <div class="p-3 bg-light rounded-3 mb-3 border text-center" style="font-size: 0.85rem;">
                                                <div class="row">
                                                    <div class="col-4 border-end">
                                                        <small class="text-muted d-block">Qtd. Atual</small>
                                                        <span class="fw-bold text-dark" id="qtdAtual-@item.Id">@item.Quantidade</span>
                                                    </div>
                                                    <div class="col-4 border-end">
                                                        <small class="text-muted d-block">PM Atual</small>
                                                        <span class="fw-bold text-secondary">@item.PrecoMedio.ToString("C2")</span>
                                                    </div>
                                                    <div class="col-4">
                                                        <small class="text-muted d-block">Cotação Atual</small>
                                                        <span class="fw-bold text-success" id="precoAtual-@item.Id">@item.PrecoAtual.ToString("N2")</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-bold small text-muted text-uppercase">Quantidade a Comprar</label>
                                                <input type="number" name="quantidadeComprada" id="inputQtdCompra-@item.Id"
                                                       class="form-control form-control-lg text-center fw-bold text-success"
                                                       value="1" min="1" required oninput="calcularNovoPrecoMedio('@item.Id', @item.Quantidade, @item.PrecoMedio.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @item.PrecoAtual.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" />
                                            </div>

                                            <div class="p-3 border border-success-subtle bg-success bg-opacity-10 rounded-4 text-center">
                                                <div class="row">
                                                    <div class="col-6 border-end border-success-subtle">
                                                        <small class="text-muted small d-block text-uppercase" style="font-size:0.65rem;">Novo Custo do Aporte</small>
                                                        <span class="fw-bold text-dark" id="txtNovoAporte-@item.Id">R$ @item.PrecoAtual.ToString("N2")</span>
                                                    </div>
                                                    <div class="col-6">
                                                        <small class="text-muted small d-block text-uppercase" style="font-size:0.65rem;">Novo Preço Médio Estimado</small>
                                                        <span class="fw-bold text-success" id="txtNovoPM-@item.Id">R$ 0,00</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="modal-footer border-0 bg-light rounded-bottom-4 p-3">
                                            <button type="button" class="btn btn-secondary border-0 px-3 rounded-3" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-success fw-bold px-4 rounded-3 shadow-sm">Confirmar Compra</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="modal fade" id="modalVenda-@item.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow-lg rounded-4">
                                    <div class="modal-header bg-danger text-white border-0 py-3">
                                        <h5 class="modal-title fw-bold">
                                            <i class="bi bi-cash-stack me-2"></i>Registrar Venda - @item.Ticker
                                        </h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <form asp-action="VenderAtivo" asp-route-visao="@ViewBag.VisaoAtual" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />

                                        <div class="modal-body p-4">
                                            <div class="p-3 bg-light rounded-3 mb-3 border text-center">
                                                <div class="row">
                                                    <div class="col-6 border-end">
                                                        <small class="text-muted d-block">Qtd. Disponível</small>
                                                        <span class="fw-bold text-dark">@item.Quantidade</span>
                                                    </div>
                                                    <div class="col-6">
                                                        <small class="text-muted d-block">Preço Médio atual</small>
                                                        <span class="fw-bold text-primary">@item.PrecoMedio.ToString("C2")</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label fw-bold small">Quantidade a Vender</label>
                                                <input type="number" name="quantidadeVendida" class="form-control form-control-lg text-center"
                                                       value="@item.Quantidade" min="1" max="@item.Quantidade" required />
                                                <div class="form-text text-muted small text-center mt-1">
                                                    O sistema utilizará a cotação atual cadastrada para apurar o lucro ou prejuízo automaticamente.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="modal-footer border-0 bg-light rounded-bottom-4 p-3">
                                            <button type="button" class="btn btn-secondary border-0 px-3 rounded-3" data-bs-dismiss="modal">Cancelar</button>
                                            <button type="submit" class="btn btn-danger fw-bold px-4 rounded-3 shadow-sm">Confirmar Venda</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        if (ultimoTipo != item.TipoAtivo)
                        {
                            <tr class="table-secondary">
                                <td colspan="10" class="fw-bold small text-uppercase">
                                    @(item.TipoAtivo == "Fii" ? "Fundos Imobiliários" :
                                     item.TipoAtivo == "Acao" ? "Ações" : "Geral / Outros")
                                </td>
                            </tr>
                                    ultimoTipo = item.TipoAtivo;
                        }
                        <tr>
                            <td class="fw-bold @(item.Favorito ? "text-warning" : "text-primary")"
                                style="cursor: pointer; transition: color 0.3s;"
                                onclick="alternarFavorito(@item.Id, this)"
                                title="Clique para favoritar/desfavoritar">
                                <i class="bi @(item.Favorito ? "bi-star-fill" : "bi-star text-muted opacity-50") me-1" id="icone-star-@item.Id"></i>
                                    @item.Ticker
                                </td>
                            <td class="fw-bold text-success" id="quantidade-@item.Id">@item.Quantidade.ToString("N0")</td>
                            <td>R$ @item.PrecoMedio.ToString("N2")</td>
                            <td>R$ @item.PrecoAtual.ToString("N2")</td>
                                @if (item.TipoAtivo == "Acao")
                                {
                                <td id="celula-rendimento-@item.Id" class="text-success small fw-semibold">
                                    <span id="texto-rendimento-@item.Id">
                                        @(item.DividendYield > 0 ? item.DividendYield.ToString("N2") + "%" : "0,00%")
                                    </span>
                                </td>
                                }
                                else
                                {
                                <td id="celula-rendimento-@item.Id"
                                    class="text-success small fw-semibold"
                                    style="cursor: pointer;"
                                    onclick="tornarRendimentoEditavel(@item.Id, @item.UltimoRendimento)">
                                    <span id="texto-rendimento-@item.Id">
                                        @(item.UltimoRendimento > 0 ? item.UltimoRendimento.ToString("C2") : "R$ 0,00")
                                    </span>
                                </td>
                                }
                                @{
                                    decimal proventoEstimadoFinal = 0m;

                                    if (item.TipoAtivo == "Acao")
                                    {
                                        if (item.DividendYield > 0 && item.DividendYield <= 20.0m)
                                        {
                                            decimal valorAtualTotal = item.PrecoAtual * item.Quantidade;
                                            proventoEstimadoFinal = ((valorAtualTotal * (item.DividendYield / 100m)) / 12m) * item.Quantidade;
                                        }
                                    }
                                    else
                                    {
                                        proventoEstimadoFinal = item.ProventoMensalEstimado;
                                    }
                                }

                                <td class="fw-bold text-success" id="provento-estimado-@item.Id">
                                    @(proventoEstimadoFinal > 0 ? proventoEstimadoFinal.ToString("C2") : "-")
                                </td>
                            <td class="fw-bold">R$ @item.ValorAtual.ToString("N2")</td>
                            <td class="@(item.LucroPrejuizo >= 0 ? "text-success" : "text-danger") fw-bold">
                                R$ @item.LucroPrejuizo.ToString("N2")
                            </td>
                            <td>
                                <span class="badge bg-@item.CorBadge">
                                    @item.Recomendacao
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm rounded-3" role="group" aria-label="Ações do Ativo">
                                    <button type="button" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1"
                                            data-bs-toggle="modal" data-bs-target="#modalCompra-@item.Id" title="Registrar Compra">
                                        <i class="bi bi-graph-up-arrow"></i>
                                        <span class="d-none d-md-inline">Comprar</span>
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalVenda-@item.Id"
                                            title="Registrar Venda">
                                        <i class="bi bi-graph-down-arrow"></i>
                                        <span class="d-none d-md-inline">Vender</span>
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 border-end-0"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal-@item.Id"
                                            title="Editar Ativo">
                                        <i class="bi bi-pencil-square"></i>
                                        <span class="d-none d-md-inline"></span>
                                    </button>
                                        @if (item.TipoAtivo == "Acao")
                                        {
                                            <a href="https://investidor10.com.br/acoes/@item.Ticker.ToLower()/" target="_blank" class="btn btn-sm btn-outline-info" title="Ver no Investidor10">
                                                <i class="bi bi-graph-up-arrow"></i>
                                            </a>
