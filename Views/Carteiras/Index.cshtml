@model Acoes_Fiis.Models.CarteiraTotalViewModel

@{
    ViewData["Title"] = "Minha Carteira Profissional";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Minha Carteira</h1>
        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAdicionarAtivo">
            <i class="bi bi-plus-circle"></i> Adicionar Ativo
        </button>
    </div>
    <div class="col-md-3 text-end">
        <form asp-action="AtualizarTodos" method="post">
            <button type="submit" class="btn btn-outline-success w-100">
                🔄 Atualizar Filtrados
            </button>
        </form>
    </div>
    <p></p>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-dark text-white shadow border-0 h-100">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small fw-bold text-info">Patrimônio Bruto</h6>
                    <h2 class="mb-0">R$ @((Model.TotalPatrimonio + Model.TotalInvestidoRendaFixa).ToString("N2"))</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow border-0 h-100">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small fw-bold">Renda Mensal Total</h6>
                    <h3 class="mb-0">R$ @Model.RendaMensalTotalConsolidada.ToString("N2")</h3>
                    <small class="opacity-75">Líquida de Impostos</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-dark shadow border-0 h-100">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small fw-bold">Projeção 12 Meses</h6>
                    <h3 class="mb-0">R$ @Model.ProventoAnualEstimado.ToString("N2")</h3>
                    <small class="fw-bold text-white">Simulação!</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow border-0 h-100 @(Model.TotalLucro >= 0 ? "bg-success" : "bg-danger") text-white">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small fw-bold">Resultado RV</h6>
                    <h3 class="mb-0">R$ @Model.TotalLucro.ToString("N2")</h3>
                </div>
            </div>
        </div>
    </div>
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success mt-3 alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-graph-up-arrow me-2"></i>Renda Variável</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th>Ticker</th>
                        <th>Qtd</th>
                        <th>P. Médio</th>
                        <th>P. Atual</th>
                        <th class="text-success">Rend./Cota</th>
                        <th class="text-success">Renda Mensal</th>
                        <th>Total</th>
                        <th>Lucro/Prej.</th>
                        <th>Status</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        string ultimoTipo = "";
                    }
                    @foreach (var item in Model.Itens.Where(x => x.TipoAtivo != "RendaFixa").OrderBy(x => x.TipoAtivo == "Acao" ? 0 : x.TipoAtivo == "Fii" ? 1 : 2).ThenBy(x => x.Ticker))
                    {
                        if (ultimoTipo != item.TipoAtivo)
                        {
                            <tr class="table-secondary">
                                <td colspan="10" class="fw-bold small text-uppercase">
                                    @(item.TipoAtivo == "Fii" ? "Fundos Imobiliários" :
                                     item.TipoAtivo == "Acao" ? "Ações" : "Geral / Outros")
                                </td>
                            </tr>
                                    ultimoTipo = item.TipoAtivo;
                        }
                        <tr>
                            <td class="fw-bold text-primary">@item.Ticker</td>
                            <td class="fw-bold text-success">@item.Quantidade.ToString("N0")</td>
                            <td>R$ @item.PrecoMedio.ToString("N2")</td>
                            <td>R$ @item.PrecoAtual.ToString("N2")</td>
                            <td class="text-success small">@(item.UltimoRendimento > 0 ? item.UltimoRendimento.ToString("C2") : "-")</td>
                            <td class="fw-bold text-success">@(item.ProventoMensalEstimado > 0 ? item.ProventoMensalEstimado.ToString("C2") : "-")</td>
                            <td class="fw-bold">R$ @item.ValorAtual.ToString("N2")</td>
                            <td class="@(item.LucroPrejuizo >= 0 ? "text-success" : "text-danger") fw-bold">
                                R$ @item.LucroPrejuizo.ToString("N2")
                            </td>
                            <td>
                                <span class="badge bg-@item.CorBadge">
                                    @item.Recomendacao
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Deletar</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-muted"><i class="bi bi-safe me-2"></i>Renda Fixa & Reserva</h5>
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalNovoRF">
                <i class="bi bi-plus-lg"></i> Novo Título
            </button>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th>Classe / Título</th>
                        <th>Montante Investido</th>
                        <th>Taxa (% a.m)</th>
                        <th>Rend. Bruto</th>
                        <th>IR (17,5%)</th>
                        <th class="text-success text-end">Rend. Líquido</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rf in Model.Itens.Where(x => x.TipoAtivo == "RendaFixa"))
                    {
                        <tr>
                            <td class="fw-bold">@rf.Ticker</td>
                            <td>
                                <form asp-action="AtualizarRendaFixa" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@rf.Id" />
                                    <div class="input-group input-group-sm" style="width: 150px;">
                                        <span class="input-group-text">R$</span>
                                        <input type="number" name="novoMontante" step="0.01" class="form-control" value="@rf.PrecoMedio.ToString("N2")" placeholder="@rf.PrecoMedio.ToString("N2")" />
                                    </div>
                                    <div class="input-group input-group-sm" style="width: 100px;">
                                        <input type="text" name="novaTaxa" step="0.01" class="form-control" value="@rf.TaxaRentabilidade?.ToString("N2")" placeholder="@rf.TaxaRentabilidade?.ToString("N2")" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i></button>
                                </form>
                            </td>
                            <td>@rf.TaxaRentabilidade?.ToString("N2")%</td>
                            <td class="text-muted small">R$ @((rf.PrecoMedio * (rf.TaxaRentabilidade ?? 0) / 100).ToString("N2"))</td>
                            <td class="text-danger small">- R$ @((rf.PrecoMedio * (rf.TaxaRentabilidade ?? 0) / 100 * 0.175m).ToString("N2"))</td>
                            <td class="fw-bold text-success text-end">R$ @rf.ProventoMensalEstimado.ToString("N2")</td>
                            <td class="text-center">
                                <a asp-action="Delete" asp-route-id="@rf.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash">Deletar</i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<div class="modal fade" id="modalAdicionarAtivo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Novo Lançamento na Carteira</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AdicionarAtivo" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Selecione o Ativo (Ações, FIIs ou Gerais)</label>
                        <select name="ticker" class="form-select" required>
                            <option value="">-- Escolha um Ticker --</option>
                            <optgroup label="Ações">
                                @foreach (var t in Model.ListaTickersAcoes)
                                {
                                    <option value="@t">@t</option>
                                }
                            </optgroup>
                            <optgroup label="FIIs">
                                @foreach (var t in Model.ListaTickersFiis)
                                {
                                    <option value="@t">@t</option>
                                }
                            </optgroup>
                            <optgroup label="Outros (Cripto/BDR)">
                                @foreach (var t in Model.ListaTickersGerais)
                                {
                                    <option value="@t">@t</option>
                                }
                            </optgroup>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Quantidade</label>
                            <input type="number" name="quantidade" class="form-control" placeholder="0" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Preço Médio (R$)</label>
                            <input type="number" name="precoMedio" step="0.01" class="form-control" placeholder="R$ 0,00" required />
                        </div>
                    </div>

                    <div class="alert alert-info small">
                        Dica: O sistema identificará automaticamente se o ativo é Ação ou FII.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Salvar na Carteira</button>
                </div>
            </form>
        </div>
    </div>
</div>   
<div class="modal fade" id="modalNovoRF" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content text-dark">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="bi bi-piggy-bank me-2"></i>Novo Título de Renda Fixa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AdicionarRendaFixa" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nome do Título / Instituição</label>
                        <input type="text" name="Ticker" class="form-control" placeholder="Ex: CDB Nubank, Tesouro Selic..." required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Montante Inicial</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input type="number" name="PrecoMedio" step="0.01" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Taxa Anual (Est.)</label>
                            <div class="input-group">
                                <input type="number" name="TaxaRentabilidade" step="0.01" class="form-control" placeholder="12.75" required />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Notas / Objetivo</label>
                        <textarea name="Notas" class="form-control" rows="2" placeholder="Ex: Reserva para o apartamento"></textarea>
                    </div>

                    <input type="hidden" name="TipoAtivo" value="RendaFixa" />
                    <input type="hidden" name="Quantidade" value="1" />
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success px-4">Salvar Investimento</button>
                </div>
            </form>
        </div>
    </div>
</div>