@model CarteiraTotalViewModel

<div class="modal fade" id="modalSimuladorDividendos" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-header bg-success text-white border-0 py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-calculator-fill me-2"></i>Simulador de Renda Passiva
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-0">
                <ul class="nav nav-tabs nav-fill bg-light border-bottom-0" id="simuladorTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold text-success py-3" id="carteira-tab" data-bs-toggle="tab" data-bs-target="#carteira" type="button" role="tab">
                            <i class="bi bi-wallet2 me-1"></i> Minha Carteira
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-secondary py-3" id="meta-tab" data-bs-toggle="tab" data-bs-target="#meta" type="button" role="tab">
                            <i class="bi bi-graph-up-arrow me-1"></i> Projeção de Crescimento (12 Meses)
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-4" id="simuladorTabsContent">

                    <div class="tab-pane fade show active" id="carteira" role="tabpanel">
                        <p class="small text-muted mb-3">
                            Simule sua carteira de FIIs atual ou busque novos ativos da base para projetar seu capital e renda.
                        </p>

                        <div class="row g-3 mb-3 pb-3 border-bottom">
                            <div class="col-lg-5 border-end pe-3">
                                <div class="mb-2">
                                    <label for="inputFiltroTickerSim" class="form-label fw-bold small text-muted text-uppercase mb-1">
                                        <i class="bi bi-search me-1"></i>Filtrar Ativo da Base
                                    </label>
                                    <input type="text" id="inputFiltroTickerSim" class="form-control form-control-sm shadow-sm" placeholder="Buscar por ticker ou nome..." onkeyup="filtrarTickersSimulador()" />
                                </div>
                                <div>
                                    <select id="selectModalTickerSim" class="form-select form-select-sm shadow-sm" size="5">
                                        @if (Model.ListaTickersFiis != null)
                                        {
                                            @foreach (var grupoFii in Model.ListaTickersFiis.DistinctBy(x => x.Ticker).GroupBy(x => x.Segmento))
                                            {
                                                <optgroup label="FIIs - @grupoFii.Key">
                                                    @foreach (var item in grupoFii)
                                                    {
                                                        <option value="@item.Ticker.Replace(".SA", "")"
                                                                data-search="@item.Ticker.ToUpper()"
                                                                data-preco="@(item.PrecoAtual.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                                                data-div="@(item.UltimoRendimento.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))">
                                                            @{
                                                                string emojiTipoFii = item.TipoFii switch { "Tijolo" => "🧱", "Papel" => "📜", "Híbrido" => "🔄", _ => "❓" };
                                                            }
                                                            @emojiTipoFii @item.Ticker.Replace(".SA", "")
                                                        </option>
                                                    }
                                                </optgroup>
                                            }
                                        }
                                        @if (Model.ListaTickersAcoes != null)
                                        {
                                            @foreach (var grupoAcao in Model.ListaTickersAcoes.DistinctBy(x => x.Ticker).GroupBy(x => x.TipoAcao))
                                            {
                                                <optgroup label="Ações - @grupoAcao.Key">
                                                    @foreach (var item in grupoAcao)
                                                    {
                                                        <option value="@item.Ticker.Replace(".SA", "")" data-search="@item.Ticker.ToUpper()">
                                                            @{
                                                                string emojiTipo = item.TipoAtivo switch { "Setor Perene" => "🏦", "Dividendos" => "💰", "Crescimento" => "🚀", _ => "❓" };
                                                            }
                                                            @emojiTipo @item.Ticker.Replace(".SA", "")
                                                        </option>
                                                    }
                                                </optgroup>
                                            }
                                        }
                                        @if (Model.ListaTickersGerais != null)
                                        {
                                            @foreach (var grupoGeral in Model.ListaTickersGerais.DistinctBy(x => x.Ticker).GroupBy(x => x.ClasseAtivo))
                                            {
                                                string emoji = grupoGeral.Key.ToLower().Contains("cripto") ? "🪙" : grupoGeral.Key.ToLower().Contains("bdr") ? "🇺🇸" : "🌐";
                                                <optgroup label="@grupoGeral.Key">
                                                    @foreach (var item in grupoGeral)
                                                    {
                                                        var textoExibicao = item.Ticker.Replace(".SA", "").Replace("-USD", "").Replace("=X", "");
                                                        <option value="@textoExibicao" data-search="@item.Ticker.ToUpper() @item.Nome.ToUpper()">
                                                            @emoji @textoExibicao - @item.Nome
                                                        </option>
                                                    }
                                                </optgroup>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-7 d-flex flex-column justify-content-end">
                                <div class="row g-2 align-items-end">
                                    <div class="col-sm-3">
                                        <label class="small fw-semibold text-muted mb-1">Ticker</label>
                                        <input type="text" id="novoTicker" class="form-control form-control-sm border-secondary-subtle fw-bold text-uppercase" placeholder="Ex: MXRF11">
                                    </div>
                                    <div class="col-sm-2">
                                        <label class="small fw-semibold text-muted mb-1">Qtd</label>
                                        <input type="number" id="novaQtd" class="form-control form-control-sm border-secondary-subtle" placeholder="0" min="1">
                                    </div>
                                    <div class="col-sm-3">
                                        <label class="small fw-semibold text-muted mb-1">Preço (R$)</label>
                                        <input type="number" id="novoPreco" class="form-control form-control-sm border-secondary-subtle" placeholder="0,00" step="0.01">
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="small fw-semibold text-muted mb-1">Div/Cota (R$)</label>
                                        <input type="number" id="novoDiv" class="form-control form-control-sm border-secondary-subtle text-success" placeholder="0,00" step="0.01">
                                    </div>
                                    <div class="col-12 mt-2">
                                        <button type="button" id="btnAdicionarFii" class="btn btn-sm btn-success w-100 fw-bold shadow-sm">
                                            <i class="bi bi-plus-circle-fill me-1"></i>Adicionar Ativo ao Simulador
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive mb-3" style="max-height: 250px; overflow-y: auto;">
                            <table class="table table-hover table-sm align-middle" id="tabelaFiisSimulador">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Ativo</th>
                                        <th style="width: 90px;">Qtd</th>
                                        <th style="width: 110px;">Preço (R$)</th>
                                        <th style="width: 110px;">Div/Cota (R$)</th>
                                        <th>Capital Investido</th>
                                        <th>Rendimento Mensal</th>
                                        <th class="text-center">Ação</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Itens != null)
                                    {
                                        foreach (var item in Model.Itens.Where(x => x.TipoAtivo != null && x.TipoAtivo.Equals("Fii", StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <tr>
                                                <td class="fw-bold text-uppercase">@item.Ticker</td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm sim-qtd border-secondary-subtle" value="@item.Quantidade" min="1">
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm sim-preco border-secondary-subtle" value="@item.PrecoAtual.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" step="0.01">
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm sim-div border-secondary-subtle text-success" value="@item.UltimoRendimento.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" step="0.01">
                                                </td>
                                                <td class="fw-bold sim-subtotal-capital">R$ 0,00</td>
                                                <td class="fw-bold text-success sim-subtotal-rendimento">R$ 0,00</td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-sm btn-outline-danger border-0 btn-remover-fii"><i class="bi bi-trash"></i></button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row g-2">
                            <div class="col-md-6">
                                <div class="p-3 rounded-4 bg-light border border-secondary-subtle h-100">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="small text-secondary fw-semibold"><i class="bi bi-piggy-bank me-2"></i>Capital Total Projetado:</span>
                                        <span id="resCapitalTotalCarteira" class="fw-bold text-dark fs-5">R$ 0,00</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 rounded-4 bg-light border border-success-subtle h-100">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="small text-secondary fw-semibold"><i class="bi bi-cash-stack me-2"></i>Renda Mensal Projetada:</span>
                                        <span id="resRendimentoTotal" class="fw-bold text-success fs-5">R$ 0,00</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="meta" role="tabpanel">
                        <p class="small text-muted mb-3">
                            Projete o crescimento do seu patrimônio e da sua renda passiva mês a mês com base nos seus aportes diários/mensais e no Dividend Yield médio da sua simulação atual.
                        </p>

                        <div class="row g-3 mb-3 align-items-center">
                            <div class="col-md-5">
                                <label class="form-label small text-muted text-uppercase fw-bold mb-1">Aporte Mensal Desejado</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white border-secondary-subtle text-success fw-bold">R$</span>
                                    <input type="number" id="simAporteMensal" class="form-control border-secondary-subtle fw-bold text-success" value="200" min="0" step="50">
                                </div>
                            </div>
                            <div class="col-md-7">
                                <div class="p-2 rounded bg-light border border-secondary-subtle d-flex justify-content-around small text-secondary">
                                    <div>Capital Inicial Base: <span id="lblCapitalInicialBase" class="fw-bold text-dark">R$ 0,00</span></div>
                                    <div class="border-start ps-3">DY Médio Mensal da Carteira: <span id="lblTaxaMedia" class="fw-bold text-success">0,00%</span></div>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive shadow-sm rounded-3" style="max-height: 320px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0" id="tabelaProjecaoCrescimento">
                                <thead class="table-dark sticky-top small">
                                    <tr>
                                        <th class="py-2">Mês</th>
                                        <th>Capital Inicial</th>
                                        <th>Aporte do Mês</th>
                                        <th>Dividendos Recebidos</th>
                                        <th>Capital Final (Reinvestido)</th>
                                        <th>Nova Renda Mensal</th>
                                    </tr>
                                </thead>
                                <tbody class="small">
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>

            <div class="modal-footer border-0 p-3 pt-0 mt-2">
                <button type="button" class="btn btn-dark w-100 rounded-pill fw-bold" data-bs-dismiss="modal">Fechar Simulador</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Função global de filtro para o select interno do simulador
    function filtrarTickersSimulador() {
        const input = document.getElementById('inputFiltroTickerSim');
        const filter = input.value.toUpperCase();
        const select = document.getElementById('selectModalTickerSim');
        const options = select.getElementsByTagName('option');
        const optgroups = select.getElementsByTagName('optgroup');

        for (let i = 0; i < options.length; i++) {
            const searchData = options[i].getAttribute('data-search') || '';
            if (searchData.toUpperCase().indexOf(filter) > -1) {
                options[i].style.display = "";
            } else {
                options[i].style.display = "none";
            }
        }

        for (let i = 0; i < optgroups.length; i++) {
            const subOptions = optgroups[i].getElementsByTagName('option');
            let algumVisivel = false;
            for (let j = 0; j < subOptions.length; j++) {
                if (subOptions[j].style.display !== "none") {
                    algumVisivel = true;
                    break;
                }
            }
            optgroups[i].style.display = algumVisivel ? "" : "none";
        }
    }

    document.addEventListener("DOMContentLoaded", function () {

        const tbodyFiis = document.querySelector("#tabelaFiisSimulador tbody");
        const resRendimentoTotal = document.getElementById("resRendimentoTotal");
        const resCapitalTotalCarteira = document.getElementById("resCapitalTotalCarteira");

        const selectAtivo = document.getElementById("selectModalTickerSim");
        const inputTicker = document.getElementById("novoTicker");
        const inputPreco = document.getElementById("novoPreco");
        const inputDiv = document.getElementById("novoDiv");
        const inputQtd = document.getElementById("novaQtd");

        // Elementos da Aba de Projeção
        const inputAporte = document.getElementById("simAporteMensal");
        const lblCapitalBase = document.getElementById("lblCapitalInicialBase");
        const lblTaxaMedia = document.getElementById("lblTaxaMedia");
        const tbodyProjecao = document.querySelector("#tabelaProjecaoCrescimento tbody");

        // Variáveis globais de controle de cálculo entre abas
        let atualCapitalTotal = 0;
        let atualRendimentoTotal = 0;

        selectAtivo.addEventListener("change", function() {
            const opcaoSelecionada = selectAtivo.options[selectAtivo.selectedIndex];
            if(opcaoSelecionada && opcaoSelecionada.value) {
                inputTicker.value = opcaoSelecionada.value;
                inputPreco.value = opcaoSelecionada.getAttribute("data-preco") || "";
                inputDiv.value = opcaoSelecionada.getAttribute("data-div") || "";
                if(!inputQtd.value) {
                    inputQtd.value = 1;
                }
            }
        });

        // Executa a projeção com base nos dados gerados na Aba 1
        function calcularProjecao12Meses() {
            const aporteMensal = parseFloat(inputAporte.value) || 0;
            tbodyProjecao.innerHTML = "";

            // Calcula a taxa média da carteira (Rendimento Total / Capital Total)
            let taxaMediaMensal = atualCapitalTotal > 0 ? (atualRendimentoTotal / atualCapitalTotal) : 0;

            // Atualiza os labels informativos da Aba 2
            lblCapitalBase.innerText = atualCapitalTotal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            lblTaxaMedia.innerText = (taxaMediaMensal * 100).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + "%";

            let capitalAcumulado = atualCapitalTotal;

            for (let mes = 1; mes <= 12; mes++) {
                let capInicialMes = capitalAcumulado;
                let dividendosMes = capInicialMes * taxaMediaMensal;

                // O capital final do mês considera: Capital Inicial + Aporte + Dividendos reinvestidos
                capitalAcumulado = capInicialMes + aporteMensal + dividendosMes;

                // Renda passiva estimada gerada para o próximo mês com o novo patrimônio
                let proximaRendaMensal = capitalAcumulado * taxaMediaMensal;

                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td class="fw-bold text-secondary">Mês ${mes}</td>
                    <td>${capInicialMes.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</td>
                    <td>${aporteMensal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</td>
                    <td class="text-success fw-semibold">+ ${dividendosMes.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</td>
                    <td class="fw-bold text-dark">${capitalAcumulado.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</td>
                    <td class="text-success fw-bold">${proximaRendaMensal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}</td>
                `;
                tbodyProjecao.appendChild(tr);
            }
        }

        function calcularCarteira() {
            let totalMensalRendimento = 0;
            let totalCapital = 0;
            const linhas = tbodyFiis.querySelectorAll("tr");

            linhas.forEach(linha => {
                const qtdInput = linha.querySelector(".sim-qtd");
                const precoInput = linha.querySelector(".sim-preco");
                const divInput = linha.querySelector(".sim-div");

                const spanSubtotalCapital = linha.querySelector(".sim-subtotal-capital");
                const spanSubtotalRend = linha.querySelector(".sim-subtotal-rendimento");

                const qtd = parseFloat(qtdInput.value) || 0;
                const preco = parseFloat(precoInput.value) || 0;
                const div = parseFloat(divInput.value) || 0;

                const subtotalCapital = qtd * preco;
                const subtotalRend = qtd * div;

                spanSubtotalCapital.innerText = subtotalCapital.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                spanSubtotalRend.innerText = subtotalRend.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

                totalCapital += subtotalCapital;
                totalMensalRendimento += subtotalRend;
            });

            resCapitalTotalCarteira.innerText = totalCapital.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            resRendimentoTotal.innerText = totalMensalRendimento.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

            // Alimenta as variáveis globais e dispara a projeção da outra aba em cadeia
            atualCapitalTotal = totalCapital;
            atualRendimentoTotal = totalMensalRendimento;

            calcularProjecao12Meses();
        }

        function anexarEventosLinha(linha) {
            const inputs = linha.querySelectorAll("input[type='number']");
            const btnRemover = linha.querySelector(".btn-remover-fii");

            inputs.forEach(input => input.addEventListener("input", calcularCarteira));

            btnRemover.addEventListener("click", function() {
                linha.remove();
                calcularCarteira();
            });
        }

        // Adicionar novo FII na simulação
        document.getElementById("btnAdicionarFii").addEventListener("click", function() {
            const ticker = inputTicker.value.toUpperCase() || "NOVO ATIVO";
            const qtd = inputQtd.value || 1;
            const preco = inputPreco.value || 0;
            const div = inputDiv.value || 0;

            const tr = document.createElement("tr");
            tr.innerHTML = `
                <td class="fw-bold text-uppercase">${ticker}</td>
                <td><input type="number" class="form-control form-control-sm sim-qtd border-secondary-subtle" value="${qtd}" min="1"></td>
                <td><input type="number" class="form-control form-control-sm sim-preco border-secondary-subtle" value="${preco}" step="0.01"></td>
                <td><input type="number" class="form-control form-control-sm sim-div border-secondary-subtle text-success" value="${div}" step="0.01"></td>
                <td class="fw-bold sim-subtotal-capital">R$ 0,00</td>
                <td class="fw-bold text-success sim-subtotal-rendimento">R$ 0,00</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger border-0 btn-remover-fii"><i class="bi bi-trash"></i></button>
                </td>
            `;

            tbodyFiis.appendChild(tr);
            anexarEventosLinha(tr);
            calcularCarteira();

            // Limpa os campos após a inserção
            inputTicker.value = "";
            inputQtd.value = "";
            inputPreco.value = "";
            inputDiv.value = "";
            selectAtivo.value = "";
        });

        // Escuta modificações no campo de Aporte Mensal na Aba 2 para recalcular a projeção na hora
        inputAporte.addEventListener("input", calcularProjecao12Meses);

        // Inicializa eventos e cálculos nas linhas injetadas via C#
        tbodyFiis.querySelectorAll("tr").forEach(anexarEventosLinha);
        calcularCarteira();

        // Estilização das Abas
        const tabs = document.querySelectorAll('#simuladorTabs .nav-link');
        tabs.forEach(tab => {
            tab.addEventListener('show.bs.tab', function(event) {
                tabs.forEach(t => {
                    t.classList.remove('text-success');
                    t.classList.add('text-secondary');
                });
                event.target.classList.remove('text-secondary');
                event.target.classList.add('text-success');
            });
        });
    });
</script>