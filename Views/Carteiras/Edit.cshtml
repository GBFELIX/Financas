@model Acoes_Fiis.Models.Carteira

@{
    Layout = null;
    var visaoAtual = ViewBag.VisaoAtual as string ?? "Gabriel";
}

<div class="modal fade" id="editModal-@Model.Id" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-light">
                <h5 class="modal-title" id="editModalLabel">
                    <i class="bi bi-pencil-square me-2 text-primary"></i>Editar Ativo: <strong>@Model.Ticker</strong>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="Edit" asp-route-visao="@visaoAtual" method="post">
                <div class="modal-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Ticker" class="form-label small fw-bold text-muted text-uppercase">Ticker</label>
                            <input asp-for="Ticker" class="form-control bg-light border-secondary-subtle fw-bold" readonly />
                            <span asp-validation-for="Ticker" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TipoAtivo" class="form-label small fw-bold text-muted text-uppercase">Tipo de Ativo</label>
                            <input asp-for="TipoAtivo" class="form-control bg-light border-secondary-subtle" readonly />
                            <span asp-validation-for="TipoAtivo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Quantidade" class="form-label small fw-bold text-muted text-uppercase">Quantidade</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-secondary-subtle text-secondary"><i class="bi bi-hash"></i></span>
                                <input asp-for="Quantidade" class="form-control border-secondary-subtle" type="number" step="any" required />
                            </div>
                            <span asp-validation-for="Quantidade" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PrecoMedio" class="form-label small fw-bold text-muted text-uppercase">Preço Médio (R$)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-secondary-subtle text-success fw-bold">R$</span>
                                <input asp-for="PrecoMedio" class="form-control border-secondary-subtle" type="number" step="0.01" required />
                            </div>
                            <span asp-validation-for="PrecoMedio" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-2 p-3 bg-light rounded-3 border border-info-subtle">
                        <p class="mb-0 small text-muted">
                            <i class="bi bi-info-circle me-1 text-info"></i>
                            <strong>Atenção:</strong> Alterações aqui refletem imediatamente no cálculo do seu patrimônio total real.
                        </p>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-3 opacity-75" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-save me-1"></i>Salvar Alterações
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CORREÇÃO: Scripts de validação injetados diretamente na Partial, sem usar -->
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>