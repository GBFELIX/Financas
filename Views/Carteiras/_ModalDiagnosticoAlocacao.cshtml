@model CarteiraTotalViewModel

<div class="modal fade" id="modalDiagnosticoAlocacao" tabindex="-1" aria-labelledby="modalDiagnosticoAlocacaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-dark text-white rounded-top-4 border-0">
                <h5 class="modal-title fw-bold" id="modalDiagnosticoAlocacaoLabel">
                    <i class="bi bi-pie-chart-fill text-info me-2"></i>Diagnóstico de Alocação de Ativos
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">

                <ul class="nav nav-pills mb-3 justify-content-center" id="pills-tab-diagnostico" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold" id="pills-divisao-tab" data-bs-toggle="pill" data-bs-target="#pills-divisao" type="button" role="tab">
                            <i class="bi bi-pie-chart-fill me-2"></i>Gráficos por Setor
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold" id="pills-nivelamento-tab" data-bs-toggle="pill" data-bs-target="#pills-nivelamento" type="button" role="tab">
                            <i class="bi bi-sliders me-2"></i>Metas vs Alocação Real
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="pills-tabContentDiagnostico">
                    <div class="tab-pane fade show active" id="pills-divisao" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-4 text-center">
                                <div class="bg-white p-3 rounded-4 shadow-sm h-100">
                                    <h6 class="fw-bold text-secondary mb-0" id="tituloGraficoAcoes">Ações por Ticker</h6>
                                    <small class="text-muted d-block mb-3" style="font-size: 0.7rem;">(Clique no gráfico para agrupar)</small>
                                    <canvas id="chartAcoesSetor" style="cursor: pointer;"></canvas>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="bg-white p-3 rounded-4 shadow-sm h-100">
                                    <h6 class="fw-bold text-secondary mb-0" id="tituloGraficoFiis">FIIs por Ticker</h6>
                                    <small class="text-muted d-block mb-3" style="font-size: 0.7rem;">(Clique no gráfico para agrupar)</small>
                                    <canvas id="chartFiisSegmento" style="cursor: pointer;"></canvas>
                                </div>
                            </div>
                            <div class="col-md-4 text-center">
                                <div class="bg-white p-3 rounded-4 shadow-sm h-100">
                                    <h6 class="fw-bold text-secondary mb-3">Ativos Gerais</h6>
                                    <canvas id="chartGeraisClasse"></canvas>
                                </div>
                            </div>
                            <div class="card shadow-sm rounded border-0 h-100">
                                <div class="card-body text-center">
                                    <h6 class="card-title fw-bold text-secondary mb-3">Distribuição Geral da Carteira</h6>
                                    <div style="max-height: 400px;" class="d-flex justify-content-center">
                                        <canvas id="chartCarteiraConsolidado"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="pills-nivelamento" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-7">
                                <div class="bg-white p-3 rounded-4 shadow-sm h-100">
                                    <h6 class="fw-bold text-dark mb-3">
                                        <i class="bi bi-arrow-left-right me-2 text-primary"></i>Nivelamento de Metas
                                    </h6>
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                            onclick="abrirConfiguracaoMetasRapido()">
                                        <i class="bi bi-sliders"></i> Alterar Modo
                                    </button>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Macro Categoria</th>
                                                    <th>Valor total</th>
                                                    <th class="text-center" style="width: 130px;">Alvo</th>
                                                    
                                                    <th class="text-center">Atual</th>
                                                    <th class="text-center">Desvio</th>
                                                    <th class="text-center">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (ViewBag.PainelRebalanceamento != null)
                                                {
                                                    foreach (var item in (List<ItemRebalanceamentoViewModel>)ViewBag.PainelRebalanceamento)
                                                    {
                                                        // Configuração visual dinâmica para as linhas
                                                        string corDesvio = item.Desvio < 0 ? "text-danger" : "text-success";

                                                        string badgeStatus = "bg-secondary";
                                                        string iconeStatus = "bi-check";

                                                        if (item.Status.Contains("APORTAR"))
                                                        {
                                                            badgeStatus = "bg-warning text-dark";
                                                            iconeStatus = "bi-arrow-down";
                                                        }
                                                        else if (item.Status.Contains("AGUARDAR") || item.Status.Contains("OK"))
                                                        {
                                                            badgeStatus = "bg-success";
                                                            iconeStatus = "bi-check";
                                                        }
                                                        else if (item.Status.Contains("REDUZIR"))
                                                        {
                                                            badgeStatus = "bg-danger";
                                                            iconeStatus = "bi-arrow-up";
                                                        }

                                                        string emojiClasse = item.Categoria.ToUpper() switch
                                                        {
                                                            var c when c.Contains("AÇÃO") || c.Contains("ACOES") => "🏦 Ações",
                                                            var c when c.Contains("FII") || c.Contains("IMOBIL") => "🧱 FIIs",
                                                            var c when c.Contains("FIXA") || c.Contains("TESOURO") => "⚡ Renda Fixa",
                                                            var c when c.Contains("GLOBAL") || c.Contains("CRIPTO") => "🌍 Global",
                                                            _ => "📦 " + item.Categoria
                                                        };
                                                    
                                                        <tr>
                                                            <td class="fw-bold">@emojiClasse</td>
                                                            <td class="text-center fw-semibold text-muted">
                                                                @item.ValorAtual.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                                                            </td>
                                                            <td class="text-center">
                                                                @item.PercentualAlvo.ToString("N0")%
                                                            </td>
                                                            
                                                            <td class="text-center fw-semibold text-muted">
                                                                @item.PercentualAtual.ToString("N1")%
                                                            </td>

                                                            <td class="text-center fw-bold @corDesvio">
                                                                @(item.Desvio > 0 ? "+" : "")@item.Desvio.ToString("N1")%
                                                            </td>

                                                            <td class="text-center">
                                                                <span class="badge @badgeStatus rounded-pill px-3 py-1 fw-bold shadow-xs" style="font-size: 0.75rem;">
                                                                    <i class="bi @iconeStatus me-1"></i> @item.Status
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                                else
                                                {
                                                    <tr>
                                                        <td colspan="5" class="text-center text-muted py-4">
                                                            <i class="bi bi-exclamation-triangle me-2 text-warning"></i> Nenhuma meta ou classe mapeada.
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-5">
                                <div class="card border-0 bg-dark text-white rounded-4 shadow-sm h-100">
                                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                                        <div>
                                            <h6 class="text-uppercase small fw-bold text-success mb-2"><i class="bi bi-lightning-charge-fill me-1"></i>Aporte Inteligente</h6>
                                            <h4 class="fw-bold mb-3">Sugestão de Rebalanceamento</h4>

                                            <div class="p-3 bg-white bg-opacity-10 rounded-3 border border-secondary border-opacity-20 mb-3">
                                                <h5 class="mb-1 text-warning fw-bold"><i class="bi bi-wallet2 me-2"></i>@Model.SugestaoAporteCategoria</h5>
                                                <p class="small text-white-50 m-0">@Model.SugestaoAporteJustificativa</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    function abrirConfiguracaoMetasRapido() {
        const modalDetalhes = bootstrap.Modal.getInstance(document.getElementById('modalRendimentosERebalanceamento'));
        const modalDetalhes1 = bootstrap.Modal.getInstance(document.getElementById('modalDiagnosticoAlocacao'));
        if(modalDetalhes) modalDetalhes.hide();
        if(modalDetalhes1) modalDetalhes1.hide();

        setTimeout(() => {
            const modalConfigMetas = new bootstrap.Modal(document.getElementById('modalMetas'));
            modalConfigMetas.show();
        }, 400);
    }

    document.addEventListener("DOMContentLoaded", function () {
        @{
                var mapaAcoesBanco = (Model.ListaTickersAcoes ?? new List<Recomendacao>())
                        .DistinctBy(x => x.Ticker.ToUpper())
                        .ToDictionary(x => x.Ticker.ToUpper(), x => new
                        {
                                TipoAcao = string.IsNullOrEmpty(x.TipoAcao) ? "Outros" : x.TipoAcao,
                                TipoAtivo = string.IsNullOrEmpty(x.TipoAtivo) ? "Outros" : x.TipoAtivo
                        });

                var mapaFiisBanco = (Model.ListaTickersFiis ?? new List<RecomendacaoFii>())
                        .DistinctBy(x => x.Ticker.ToUpper())
                        .ToDictionary(x => x.Ticker.ToUpper(), x => new
                        {
                                Segmento = string.IsNullOrEmpty(x.Segmento) ? "Outros" : x.Segmento,
                                TipoFii = string.IsNullOrEmpty(x.TipoFii) ? "Outros" : x.TipoFii
                        });

                var mapaGeraisBanco = (Model.ListaTickersGerais ?? new List<AtivoGeral>())
                        .DistinctBy(x => x.Ticker.ToUpper())
                        .ToDictionary(x => x.Ticker.ToUpper(), x => new
                        {
                                Classe = string.IsNullOrEmpty(x.ClasseAtivo) ? "Outros" : x.ClasseAtivo,
                                Nome = x.Nome
                        });

                var itensCarteiraConsolidados = Model.Itens
                        .Where(x => !string.IsNullOrEmpty(x.Ticker))
                        .GroupBy(x => x.Ticker.ToUpper())
                        .Select(g => new
                        {
                                Ticker = g.Key,
                                TickerExibicao = g.Key.Replace(".SA", "").Replace("-USD", "").Replace("=X", ""),
                                ValorTotal = g.Sum(x => (decimal)x.Quantidade * x.PrecoMedio)
                        })
                        .Where(x => x.ValorTotal > 0)
                        .ToList();

                var acoesGrafico = itensCarteiraConsolidados
                        .Where(x => mapaAcoesBanco.ContainsKey(x.Ticker))
                        .Select(x => new
                        {
                                x.TickerExibicao,
                                x.ValorTotal,
                                TipoAcao = mapaAcoesBanco[x.Ticker].TipoAcao,
                                TipoAtivo = mapaAcoesBanco[x.Ticker].TipoAtivo
                        }).ToList();

                var fiisGrafico = itensCarteiraConsolidados
                        .Where(x => mapaFiisBanco.ContainsKey(x.Ticker))
                        .Select(x => new
                        {
                                x.TickerExibicao,
                                x.ValorTotal,
                                Segmento = mapaFiisBanco[x.Ticker].Segmento,
                                TipoFii = mapaFiisBanco[x.Ticker].TipoFii
                        }).ToList();

                var geraisGrafico = itensCarteiraConsolidados
                        .Where(x => mapaGeraisBanco.ContainsKey(x.Ticker))
                        .Select(x => new
                        {
                                x.TickerExibicao,
                                x.ValorTotal,
                                Classe = mapaGeraisBanco[x.Ticker].Classe,
                                Nome = mapaGeraisBanco[x.Ticker].Nome
                        }).ToList();

                decimal totalFinanceiroAcoes = acoesGrafico.Sum(x => x.ValorTotal);
                decimal totalFinanceiroFiis = fiisGrafico.Sum(x => x.ValorTotal);
                decimal totalFinanceiroGerais = geraisGrafico.Sum(x => x.ValorTotal);
        }

        const CORES_PALETA = ['#003366', '#fd7e14', '#20c997', '#6f42c1', '#336699', '#ffc107', '#e83e8c', '#6699cc', '#28a745', '#99ccff', '#dc3545', '#17a2b8', '#6c757d'];

        const dadosAcoes = @Html.Raw(Json.Serialize(acoesGrafico));
        const dadosFiis = @Html.Raw(Json.Serialize(fiisGrafico));

        let estadoAcoes = 0;
        const titulosAcoes = ['Ações por Ticker', 'Ações por Tipo de Ação', 'Ações por Tipo de Ativo'];

        let estadoFiis = 0;
        const titulosFiis = ['FIIs por Ticker', 'FIIs por Segmento', 'FIIs por Tipo de Fii'];

        function agruparDados(dados, propriedadeAgrupamento) {
            let mapa = {};
            dados.forEach(item => {
                let chave = item[propriedadeAgrupamento] || 'Outros';
                if (!mapa[chave]) mapa[chave] = 0;
                mapa[chave] += item.valorTotal;
            });
            return {
                labels: Object.keys(mapa),
                data: Object.values(mapa)
            };
        }

        // ==========================================
        // MÁGICA DO TOOLTIP (MOSTRA OS ATIVOS DENTRO DA FATIA)
        // ==========================================
        const tooltipCallbacks = {
            label: function(context) {
                let label = context.label || '';
                let valor = parseFloat(context.raw) || 0;
                let total = context.chart.data.datasets[0].data.reduce((sum, val) => sum + parseFloat(val), 0);
                let percentage = total > 0 ? ((valor / total) * 100).toFixed(1) : 0;
                return ` ${label}: R$ ${valor.toLocaleString('pt-BR', {minimumFractionDigits: 2})} (${percentage}%)`;
            },
            footer: function(tooltipItems) {
                let chart = tooltipItems[0].chart;
                let estado = chart.customState;

                // Se o estado for 0 (Visão Ticker normal), não precisa mostrar nada no rodapé
                if (!estado || estado === 0) return null;

                let labelFatia = tooltipItems[0].label;
                let propDeFiltro = chart.customProp;
                let dadosBrutos = chart.customRawData;

                // Filtra quais ações ou FIIs fazem parte deste agrupamento
                let tickersNaFatia = dadosBrutos
                    .filter(x => (x[propDeFiltro] || 'Outros') === labelFatia)
                    .map(x => x.tickerExibicao);

                // Se a lista for muito grande, quebramos em linhas para não estourar a tela
                let linhas = ['', '📌 Ativos nesta fatia:'];
                let linhaAtual = [];
                for(let i = 0; i < tickersNaFatia.length; i++) {
                    linhaAtual.push(tickersNaFatia[i]);
                    if (linhaAtual.length === 4 || i === tickersNaFatia.length - 1) {
                        linhas.push('   ' + linhaAtual.join(', '));
                        linhaAtual = [];
                    }
                }
                return linhas;
            }
        };

        const configTooltip = {
            callbacks: tooltipCallbacks,
            footerFont: { style: 'italic', weight: 'normal', size: 11 },
            footerColor: '#ced4da',
            padding: 12
        };

        // ==========================================
        // CHART 1: AÇÕES
        // ==========================================
        const ctxAcoes = document.getElementById('chartAcoesSetor').getContext('2d');
        const graficoAcoes = new Chart(ctxAcoes, {
            type: 'doughnut',
            data: {
                labels: dadosAcoes.map(x => x.tickerExibicao),
                datasets: [{
                    data: dadosAcoes.map(x => x.valorTotal),
                    backgroundColor: CORES_PALETA
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' }, tooltip: configTooltip },
                onClick: (event, elements, chart) => {
                    estadoAcoes = (estadoAcoes + 1) % 3;
                    let prop = '';
                    let novoAgrupamento;

                    if (estadoAcoes === 0) {
                        novoAgrupamento = { labels: dadosAcoes.map(x => x.tickerExibicao), data: dadosAcoes.map(x => x.valorTotal) };
                    } else if (estadoAcoes === 1) {
                        prop = 'tipoAcao';
                        novoAgrupamento = agruparDados(dadosAcoes, prop);
                    } else if (estadoAcoes === 2) {
                        prop = 'tipoAtivo';
                        novoAgrupamento = agruparDados(dadosAcoes, prop);
                    }

                    // Guarda informações no próprio gráfico para o tooltip conseguir ler
                    chart.customState = estadoAcoes;
                    chart.customProp = prop;
                    chart.customRawData = dadosAcoes;

                    chart.data.labels = novoAgrupamento.labels;
                    chart.data.datasets[0].data = novoAgrupamento.data;
                    document.getElementById('tituloGraficoAcoes').innerText = titulosAcoes[estadoAcoes];
                    chart.update();
                }
            }
        });
        graficoAcoes.customState = 0; // Inicia sem agrupamento

        // ==========================================
        // CHART 2: FIIs
        // ==========================================
        const ctxFiis = document.getElementById('chartFiisSegmento').getContext('2d');
        const graficoFiis = new Chart(ctxFiis, {
            type: 'doughnut',
            data: {
                labels: dadosFiis.map(x => x.tickerExibicao),
                datasets: [{
                    data: dadosFiis.map(x => x.valorTotal),
                    backgroundColor: [...CORES_PALETA].reverse()
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' }, tooltip: configTooltip },
                onClick: (event, elements, chart) => {
                    estadoFiis = (estadoFiis + 1) % 3;
                    let prop = '';
                    let novoAgrupamento;

                    if (estadoFiis === 0) {
                        novoAgrupamento = { labels: dadosFiis.map(x => x.tickerExibicao), data: dadosFiis.map(x => x.valorTotal) };
                    } else if (estadoFiis === 1) {
                        prop = 'segmento';
                        novoAgrupamento = agruparDados(dadosFiis, prop);
                    } else if (estadoFiis === 2) {
                        prop = 'tipoFii';
                        novoAgrupamento = agruparDados(dadosFiis, prop);
                    }

                    chart.customState = estadoFiis;
                    chart.customProp = prop;
                    chart.customRawData = dadosFiis;

                    chart.data.labels = novoAgrupamento.labels;
                    chart.data.datasets[0].data = novoAgrupamento.data;
                    document.getElementById('tituloGraficoFiis').innerText = titulosFiis[estadoFiis];
                    chart.update();
                }
            }
        });
        graficoFiis.customState = 0; // Inicia sem agrupamento

        // ==========================================
        // CHART 3 e 4 (Gerais e Consolidado permanecem iguais)
        // ==========================================
        const ctxGerais = document.getElementById('chartGeraisClasse').getContext('2d');
        new Chart(ctxGerais, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(geraisGrafico.Select(x => x.TickerExibicao))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(geraisGrafico.Select(x => x.ValorTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)))),
                    backgroundColor: CORES_PALETA.slice(3)
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' }, tooltip: configTooltip }
            }
        });

        const ctxConsolidado = document.getElementById('chartCarteiraConsolidado').getContext('2d');
        new Chart(ctxConsolidado, {
            type: 'doughnut',
            data: {
                labels: ['Ações Nacionais', 'Fundos Imobiliários', 'Mercado Global / Outros'],
                datasets: [{
                    data: [
                        @totalFinanceiroAcoes.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @totalFinanceiroFiis.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @totalFinanceiroGerais.ToString(System.Globalization.CultureInfo.InvariantCulture)
                    ],
                    backgroundColor: ['#003366', '#fd7e14', '#28a745']
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' }, tooltip: configTooltip }
            }
        });
    });
</script>