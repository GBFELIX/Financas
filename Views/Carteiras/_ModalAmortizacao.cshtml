@model CarteiraTotalViewModel

@{
    var visaoAtual = ViewBag.VisaoAtual as string ?? "Gabriel";
    var hoje = DateTime.Now;

    // CORREÇÃO: Fallback para uma data real caso o banco venha zerado.
    // Substitua a data abaixo pela data real de início do financiamento.
    DateTime dataInicioContrato = Model.DataInicio != DateTime.MinValue
                                  ? Model.DataInicio
                                  : new DateTime(2026, 05, 01);

    // Calculadora exata de meses seguidos
    int diferencaMeses = ((hoje.Year - dataInicioContrato.Year) * 12) + hoje.Month - dataInicioContrato.Month;
    int numeroParcelaAlvo = diferencaMeses + 1;

    if (numeroParcelaAlvo < 1)
    {
        numeroParcelaAlvo = 1;
    }
}

<div class="modal fade" id="modalAmortizacao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <form asp-action="RegistrarAporteExtra" asp-controller="Carteiras" method="post">

                <input type="hidden" name="priceId" value="2" />
                <input type="hidden" name="mesReferencia" value="@numeroParcelaAlvo" />
                <input type="hidden" name="visao" value="@visaoAtual" />

                <div class="modal-header bg-danger text-white border-0 py-3">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-lightning-charge-fill me-2"></i>Acelerador de Quitação
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">

                    <!-- Campo de Valor Formatado e Protegido contra Ponto/Vírgula -->
                    <div class="text-center mb-4">
                        <small class="text-muted text-uppercase fw-bold">Quanto deseja amortizar este mês?</small>
                        <div class="input-group input-group-lg mt-2">
                            <span class="input-group-text bg-white border-end-0 text-success fw-bold">R$</span>
                            <input type="text" name="valor"
                                   class="form-control border-start-0 fw-bold text-success text-center"
                                   value="@Model.SobraDisponivelParaAmortizar.ToString("N2")" />
                        </div>
                        <p class="small text-muted mt-2">Sobra atual em caixa: <span class="fw-bold text-dark">@Model.SobraDisponivelParaAmortizar.ToString("C2")</span></p>
                    </div>

                    <!-- Inteligência de Comparação Simplificada -->
                    @{
                        decimal taxaMensalFinanc = (Model.TaxaJurosAnual / 12) / 100;
                        decimal rendimentoMedioCarteira = 0.01m;
                        bool valeAmortizar = taxaMensalFinanc > rendimentoMedioCarteira;
                    }

                    <div class="alert @(valeAmortizar ? "alert-warning" : "alert-info") border-0 rounded-4 mb-4">
                        <div class="d-flex">
                            <i class="bi @(valeAmortizar ? "bi-exclamation-triangle-fill text-warning" : "bi-info-circle-fill text-info") fs-4 me-3"></i>
                            <div>
                                <h6 class="fw-bold mb-1 small text-uppercase" style="font-size: 0.75rem;">Estratégia Recomendada</h6>
                                <small class="text-dark">
                                    Juros do banco: <strong>@(taxaMensalFinanc.ToString("P2"))</strong> ao mês.
                                    <span class="d-block mt-1 fw-semibold">
                                        @(valeAmortizar ? "Amortizar agora é mais eficaz que deixar investido!" : "Os investimentos estão rendendo mais que os juros da dívida.")
                                    </span>
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Impacto Projetado Seguro -->
                    <label class="small text-muted text-uppercase fw-bold mb-2 d-block" style="font-size: 0.7rem;">Impacto Estimado</label>
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <div class="p-3 border rounded-4 bg-light text-center">
                                <i class="bi bi-shield-check text-success d-block fs-4 mb-1"></i>
                                <small class="d-block text-muted" style="font-size: 0.7rem;">Dinheiro Seguro</small>
                                <span class="fw-bold text-dark">Dívida Menor</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 border rounded-4 bg-light text-center">
                                <i class="bi bi-piggy-bank text-success d-block fs-4 mb-1"></i>
                                <small class="d-block text-muted" style="font-size: 0.7rem;">Juros Poupados</small>
                                <span class="fw-bold text-dark">~ @((Model.SobraDisponivelParaAmortizar * 1.8m).ToString("C2"))</span>
                            </div>
                        </div>
                    </div>

                    <!-- CORREÇÃO VISUAL PARA DEBUG: Mostra o número calculado na tela antes de enviar -->
                    <div class="text-center mb-3 text-primary small fw-bold bg-light p-2 rounded-3">
                        <i class="bi bi-info-circle-fill"></i> Parcela Alvo Identificada: Mês @numeroParcelaAlvo
                    </div>

                    <!-- Botão de Confirmação -->
                    <button type="submit" class="btn btn-danger w-100 rounded-pill fw-bold py-3 shadow-sm text-uppercase" style="font-size: 0.85rem;">
                        <i class="bi bi-check-circle-fill me-2"></i>Efetuar Amortização Extra
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>