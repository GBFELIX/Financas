@model CarteiraTotalViewModel

@{
    var visaoAtual = ViewBag.VisaoAtual as string ?? "Gabriel";
    var hoje = DateTime.Now;
    var anoAtual = hoje.Year;
}

<div class="modal fade" id="modalContraCheques" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-header bg-dark text-white border-0 py-3 rounded-top-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-file-earmark-pdf-fill text-info me-2"></i>Gestão de Contra-Cheques e Folha
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- Seletores de Filtro Superior -->
            <div class="bg-light p-3 border-bottom d-flex justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <label class="small fw-bold text-muted text-uppercase mb-0">Exercício:</label>
                    <select name="anoFiltro" class="form-select form-select-sm rounded-3 fw-bold border-secondary-subtle" style="width: 110px;">
                        @for (int i = anoAtual - 2; i <= anoAtual + 1; i++)
                        {
                            <!option value="@i" @(i == anoAtual ? "selected" : "")>Ano @i</!option>
                        }
                    </select>
                </div>
                <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-3 fw-bold">Perfil: @visaoAtual</span>
            </div>

            <!-- Abas de Navegação Interna -->
            <ul class="nav nav-tabs px-4 pt-3 bg-light border-0" id="folhaTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active border-0 fw-bold small text-uppercase pb-2 text-dark" id="registro-tab" data-bs-toggle="tab" data-bs-target="#registro-pane" type="button" role="tab"><i class="bi bi-plus-circle me-1"></i> Lançar Mês</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link border-0 fw-bold small text-uppercase pb-2 text-dark" id="historico-tab" data-bs-toggle="tab" data-bs-target="#historico-pane" type="button" role="tab"><i class="bi bi-clock-history me-1"></i> Histórico & PDFs</button>
                </li>
            </ul>

            <div class="modal-body tab-content p-4">

                <!-- ABA 1: LANÇAMENTO DE SALÁRIO (FORMULÁRIO ISOLADO AQUI) -->
                <div class="tab-pane fade show active" id="registro-pane" role="tabpanel" aria-labelledby="registro-tab" tabindex="0">
                    <form asp-action="RegistrarFolhaPagamento" asp-controller="Carteiras" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="visao" value="@visaoAtual" />
                        <input type="hidden" name="ano" value="@anoAtual" /> @* Passa o ano selecionado no fluxo *@

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted text-uppercase fw-bold">Mês de Referência</label>
                                <select name="mes" class="form-select rounded-3 border-secondary-subtle" required>
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <!option value="@m" @(m == hoje.Month ? "selected" : "")>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m).ToUpper()</!option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-muted text-uppercase fw-bold">Anexar PDF do Holerite</label>
                                <div class="input-group">
                                    <label class="input-group-text bg-white border-secondary-subtle text-secondary" for="pdfContraCheque"><i class="bi bi-upload"></i></label>
                                    <input type="file" name="pdfFile" class="form-control border-secondary-subtle" id="pdfContraCheque" accept=".pdf">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-muted text-uppercase fw-bold">Salário Bruto (R$)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-secondary-subtle text-success fw-bold">R$</span>
                                    <input type="text" name="salarioBruto" class="form-control border-secondary-subtle fw-bold text-success" placeholder="0,00" required />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-muted text-uppercase fw-bold">Descontos em Folha (R$)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-secondary-subtle text-danger fw-bold">R$</span>
                                    <input type="text" name="descontos" class="form-control border-secondary-subtle fw-bold text-danger" placeholder="0,00" required />
                                </div>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2 shadow-sm text-uppercase" style="font-size: 0.85rem;">
                                    <i class="bi bi-check-circle-fill me-2"></i>Salvar e Computar na Carteira
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- ABA 2: HISTÓRICO ACUMULADO E DOWNLOADS -->
                <div class="tab-pane fade" id="historico-pane" role="tabpanel" aria-labelledby="historico-tab" tabindex="0">
                    <div class="table-responsive rounded-3 border">
                        <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                            <thead class="table-light">
                                <tr class="text-muted small" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                                    <th class="ps-3">COMPETÊNCIA</th>
                                    <th>SALÁRIO BRUTO</th>
                                    <th>DESCONTOS</th>
                                    <th>SALÁRIO LÍQUIDO</th>
                                    <th class="text-center">HOLERITE (PDF)</th>
                                    <th class="text-end pe-3">AÇÃO</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.HistoricoFolhas != null && Model.HistoricoFolhas.Any())
                                {
                                    @foreach (var folha in Model.HistoricoFolhas.OrderByDescending(f => f.Ano).ThenByDescending(f => f.Mes))
                                    {
                                        string nomeMes = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(folha.Mes).ToUpper();
                                        decimal salarioLiquido = folha.SalarioBruto - folha.Descontos;

                                        <tr>
                                            <td class="fw-bold ps-3">@nomeMes / @folha.Ano</td>
                                            <td class="text-success fw-semibold">@folha.SalarioBruto.ToString("C2")</td>
                                            <td class="text-danger">@folha.Descontos.ToString("C2")</td>
                                            <td class="text-dark fw-bold">@salarioLiquido.ToString("C2")</td>
                                            <td class="text-center">
                                                @if (!string.IsNullOrEmpty(folha.PathPdf))
                                                {
                                                    <a href="@folha.PathPdf" target="_blank" class="btn btn-sm btn-outline-danger border-0 px-2 py-1 rounded-3">
                                                        <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small italic" style="font-size: 0.75rem;">Sem anexo</span>
                                                }
                                            </td>
                                            <td class="text-end pe-3">
                                                <form asp-action="ExcluirFolhaPagamento" asp-controller="Carteiras" method="post" class="d-inline"
                                                      onsubmit="return confirm('Tem certeza que deseja excluir o registro de @nomeMes / @folha.Ano?');">
                                                    <input type="hidden" name="id" value="@folha.Id" />
                                                    <input type="hidden" name="visao" value="@visaoAtual" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0 px-2 py-1 rounded-3">
                                                        <i class="bi bi-trash3-fill"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i class="bi bi-folder-x d-block fs-3 mb-2 text-secondary"></i>
                                            Nenhum contra-cheque registrado para este exercício.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary w-100 rounded-pill fw-bold small" data-bs-dismiss="modal">Fechar Gestor</button>
            </div>
        </div>
    </div>
</div>