@model CarteiraTotalViewModel

<div class="modal fade" id="modalRendimentosERebalanceamento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-header bg-dark text-white border-0 pb-0 pt-3 rounded-top-4">
                <ul class="nav nav-tabs border-0 w-100" id="tabsModalFinanceiro" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active text-white border-0 bg-transparent fw-bold pb-3 px-4 position-relative"
                                id="tab-rendimentos" data-bs-toggle="tab" data-bs-target="#conteudo-rendimentos"
                                type="button" role="tab" aria-selected="true">
                            <i class="bi bi-graph-up-arrow text-success me-1"></i> Evolução Patrimonial
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-white border-0 bg-transparent fw-bold pb-3 px-4 position-relative"
                                id="tab-projecao" data-bs-toggle="tab" data-bs-target="#conteudo-projecao"
                                type="button" role="tab" aria-selected="false">
                            <i class="bi bi-crystal-ball text-info me-1"></i> Projeção Futura
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-white border-0 bg-transparent fw-bold pb-3 px-4 position-relative"
                                id="tab-proventos" data-bs-toggle="tab" data-bs-target="#conteudo-proventos"
                                type="button" role="tab" aria-selected="false">
                            <i class="bi bi-trophy text-warning me-1"></i> Proventos
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link text-white border-0 bg-transparent fw-bold pb-3 px-4 position-relative"
                                id="tab-metas" data-bs-toggle="tab" data-bs-target="#conteudo-metas"
                                type="button" role="tab" aria-selected="false">
                            <i class="bi bi-trophy text-warning me-1"></i> Metas & Múltiplos
                        </button>
                    </li>
                </ul>
                <button type="button" class="btn-close btn-close-white mb-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="tab-content" id="conteudoTabsModal">

                    @* ABA 1: EVOLUÇÃO PATRIMONIAL *@
                    <div class="tab-pane fade show active" id="conteudo-rendimentos" role="tabpanel" aria-labelledby="tab-rendimentos">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold text-dark m-0">Crescimento do Patrimônio Líquido</h5>
                            <span class="badge bg-success rounded-pill px-3 py-2 fw-bold">Atual: R$ @Model.PatrimonioTotalReal.ToString("N2")</span>
                        </div>

                        <div style="height: 280px; position: relative;" class="mb-2">
                            <canvas id="chartEvolucaoPatrimonial"></canvas>
                        </div>
                    </div>

                    @* ABA 2: PROJEÇÃO FUTURA *@
                    <div class="tab-pane fade" id="conteudo-projecao" role="tabpanel" aria-labelledby="tab-projecao">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold text-dark m-0">Previsão de Patrimônio (Próximos 12 Meses)</h5>
                            <span class="badge bg-info rounded-pill px-3 py-2 fw-bold text-dark">Estimado</span>
                        </div>

                        <div style="height: 280px; position: relative;" class="mb-2">
                            <canvas id="chartProjecaoFutura"></canvas>
                        </div>
                    </div>
                    @* ABA 3: HISTÓRICO E PROJEÇÃO DE PROVENTOS RECEBIDOS *@
                    <div class="tab-pane fade" id="conteudo-proventos" role="tabpanel" aria-labelledby="tab-proventos">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold text-dark m-0">Proventos</h5>
                            <span class="badge bg-info rounded-pill px-3 py-2 fw-bold text-dark">Inclui Caixinhas e Renda Variável</span>
                        </div>

                        <div style="height: 280px; position: relative;" class="mb-2">
                            <canvas id="chartRendimentosInvestimentos"></canvas>
                        </div>
                    </div>

                    @* ABA 4: METAS E MÚLTIPLOS *@
                    <div class="tab-pane fade" id="conteudo-metas" role="tabpanel" aria-labelledby="tab-metas">
                        @{
                            decimal custoMensal = 3000.00m;
                            decimal patrimonioAtual = Model.PatrimonioTotalReal;

                            decimal alvoReserva = custoMensal * 6;
                            decimal pctReserva = Math.Min(100, (patrimonioAtual / alvoReserva) * 100);

                            decimal alvoImovel = 180000.00m;
                            decimal pctImovel = Math.Min(100, (patrimonioAtual / alvoImovel) * 100);

                            decimal alvoLiberdade = custoMensal * 300;
                            decimal pctLiberdade = Math.Min(100, (patrimonioAtual / alvoLiberdade) * 100);
                        }

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h5 class="fw-bold text-dark m-0">Metas Estratégicas de Alocação</h5>
                                <small class="text-muted">Acompanhe a evolução do seu patrimônio frente aos seus grandes marcos</small>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle border-0">
                                <thead class="table-light text-uppercase fs-7 text-secondary fw-bold border-0">
                                    <tr>
                                        <th class="border-0">Objetivo & Múltiplo Alvo</th>
                                        <th class="border-0 text-center">Valor Alvo</th>
                                        <th class="border-0 text-center" style="width: 30%;">Progresso</th>
                                        <th class="border-0 text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="border-0 fs-6 text-dark">
                                    <tr>
                                        <td class="fw-bold border-0">
                                            🛡️ Reserva de Emergência
                                            <small class="d-block text-muted fw-normal">Curto Prazo • Múltiplo de 6 meses de custo</small>
                                        </td>
                                        <td class="border-0 text-center fw-semibold text-secondary">R$ @alvoReserva.ToString("N0")</td>
                                        <td class="border-0">
                                            <div class="progress rounded-pill shadow-none mb-1" style="height: 8px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: @pctReserva.ToString("0")%"></div>
                                            </div>
                                            <small class="text-muted fw-semibold">@pctReserva.ToString("N1")% concluído</small>
                                        </td>
                                        <td class="border-0 text-end">
                                            <span class="badge @(pctReserva >= 100 ? "bg-success" : "bg-warning text-dark") rounded-pill px-3">
                                                @(pctReserva >= 100 ? "Concluído" : "Construindo")
                                            </span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="fw-bold border-0">
                                            🏢 Fundo Aquisição Imóvel
                                            <small class="d-block text-muted fw-normal">Médio Prazo • Alvo de Consolidação Real (2029)</small>
                                        </td>
                                        <td class="border-0 text-center fw-semibold text-secondary">R$ @alvoImovel.ToString("N0")</td>
                                        <td class="border-0">
                                            <div class="progress rounded-pill shadow-none mb-1" style="height: 8px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @pctImovel.ToString("0")%"></div>
                                            </div>
                                            <small class="text-muted fw-semibold">@pctImovel.ToString("N1")% concluído</small>
                                        </td>
                                        <td class="border-0 text-end">
                                            <span class="badge @(pctImovel >= 100 ? "bg-success" : "bg-primary") rounded-pill px-3">
                                                @(pctImovel >= 100 ? "Concluído" : "Em Andamento")
                                            </span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td class="fw-bold border-0">
                                            🚀 Independência Financeira
                                            <small class="d-block text-muted fw-normal">Longo Prazo • Regra dos 4% (Múltiplo de 300 meses)</small>
                                        </td>
                                        <td class="border-0 text-center fw-semibold text-secondary">R$ @alvoLiberdade.ToString("N0")</td>
                                        <td class="border-0">
                                            <div class="progress rounded-pill shadow-none mb-1" style="height: 8px;">
                                                <div class="progress-bar bg-info" role="progressbar" style="width: @pctLiberdade.ToString("0")%"></div>
                                            </div>
                                            <small class="text-muted fw-semibold">@pctLiberdade.ToString("N1")% concluído</small>
                                        </td>
                                        <td class="border-0 text-end">
                                            <span class="badge bg-dark text-info rounded-pill px-3">Acumulando</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer bg-light border-0 rounded-bottom-4 py-2">
                <button type="button" class="btn btn-sm btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Fechar Painel</button>
            </div>
        </div>
    </div>
</div>

<style>
    #tabsModalFinanceiro .nav-link.active {
        color: #fff !important;
        border-bottom: 3px solid #198754 !important;
    }

    #tabsModalFinanceiro .nav-link {
        opacity: 0.75;
        transition: all 0.2s ease;
    }

        #tabsModalFinanceiro .nav-link:hover {
            opacity: 1;
        }

    .fs-7 {
        font-size: 0.78rem;
    }
</style>

<script>
    function calcularNovoPrecoMedio(id, qtdAtual, pmAtual, precoAtual) {
        const inputQtd = document.getElementById(`inputQtdCompra-${id}`);
        const txtAporte = document.getElementById(`txtNovoAporte-${id}`);
        const txtNovoPM = document.getElementById(`txtNovoPM-${id}`);

        if (!inputQtd) return;

        const qtdComprada = parseFloat(inputQtd.value) || 0;

        const custoAporte = qtdComprada * precoAtual;
        txtAporte.innerText = custoAporte.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

        const custoTotalAcumulado = (qtdAtual * pmAtual) + custoAporte;
        const totalAcoesNovas = qtdAtual + qtdComprada;

        const novoPrecoMedioEstimado = totalAcoesNovas > 0 ? (custoTotalAcumulado / totalAcoesNovas) : 0;
        txtNovoPM.innerText = novoPrecoMedioEstimado.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    document.addEventListener("DOMContentLoaded", function () {
        const modalSelect = document.getElementById('selectModalTicker');
        if (modalSelect) {
            new TomSelect(modalSelect, {
                plugins: ['dropdown_input'],
                create: false,
                sortField: { field: "text", direction: "asc" },
                maxOptions: 60,
                render: {
                    option: function(data, escape) {
                        return '<div class="option py-2">' + escape(data.text) + '</div>';
                    },
                    item: function(data, escape) {
                        return '<div class="item fw-bold text-success">' + escape(data.text) + '</div>';
                    }
                }
            });
        }
    });

    function tornarRendimentoEditavel(id, valorAtual) {
        const celula = document.getElementById(`celula-rendimento-${id}`);

        if (celula.querySelector('input')) return;

        const input = document.createElement('input');
        input.type = 'number';
        input.step = '0.01';
        input.min = '0.00';
        input.className = 'form-control form-control-sm text-success fw-bold text-center border-primary d-inline-block';
        input.style.maxWidth = '90px';
        input.value = valorAtual;

        const spanTexto = document.getElementById(`texto-rendimento-${id}`);
        spanTexto.style.display = 'none';
        celula.appendChild(input);
        input.focus();
        input.select();

        const salvarMudanca = () => {
            const novoValor = parseFloat(input.value) || 0;

            fetch(`/Carteiras/AtualizarRendimentoInline?id=${id}&novoValor=${novoValor}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => {
                if (response.ok) {
                    input.remove();
                    spanTexto.textContent = novoValor.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                    spanTexto.style.display = '';
                    celula.setAttribute('onclick', `tornarRendimentoEditavel(${id}, ${novoValor})`);

                    const campoProvento = document.getElementById(`provento-estimado-${id}`);
                    const campoQuantidade = document.getElementById(`quantidade-${id}`);

                    if (campoProvento && campoQuantidade) {
                        const qtdTexto = campoQuantidade.textContent.trim().replace(/\./g, '').replace(',', '.');
                        const quantidade = parseFloat(qtdTexto) || 0;
                        const novoProventoEstimado = quantidade * novoValor;

                        if (novoProventoEstimado > 0) {
                            campoProvento.textContent = novoProventoEstimado.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                        } else {
                            campoProvento.textContent = "-";
                        }
                    }
                } else {
                    alert('Erro ao salvar o novo valor de rendimento.');
                    cancelarEdicao();
                }
            })
            .catch(error => {
                console.error('Erro:', error);
                cancelarEdicao();
            });
        };

        const cancelarEdicao = () => {
            input.remove();
            spanTexto.style.display = '';
        };

        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                salvarMudanca();
            }
            if (e.key === 'Escape') {
                cancelarEdicao();
            }
        });

        input.addEventListener('blur', function() {
            salvarMudanca();
        });
    }

    // CONTROLE GLOBAL DOS GRÁFICOS DO MODAL
    let chartEvolucao = null;
    let chartProjecao = null;
    let chartRendimentos = null;

    document.addEventListener("DOMContentLoaded", function () {
        const modalElement = document.getElementById('modalRendimentosERebalanceamento');
        if (!modalElement) return;

        // Dispara a renderização sincronizada quando o modal terminar de abrir na tela
        modalElement.addEventListener('shown.bs.modal', function () {

            // --- GRÁFICO 1: EVOLUÇÃO PATRIMONIAL ---
            const canvasEvolucao = document.getElementById('chartEvolucaoPatrimonial');
            if (canvasEvolucao) {
                let labelsEvolucao = @Html.Raw(Json.Serialize(ViewBag.HistoricoEvolucaoLabels)) || [];
                let dadosEvolucao = @Html.Raw(Json.Serialize(ViewBag.HistoricoEvolucaoValores)) || [];

                labelsEvolucao.reverse();
                dadosEvolucao.reverse();

                if (labelsEvolucao.length === 1) {
                    labelsEvolucao = ['Início', labelsEvolucao[0]];
                    dadosEvolucao = [dadosEvolucao[0], dadosEvolucao[0]];
                } else if (labelsEvolucao.length === 0) {
                    labelsEvolucao = ['Início', new Date().toLocaleDateString('pt-BR', { month: '2-digit', year: 'numeric' })];
                    dadosEvolucao = [@Model.PatrimonioTotalReal, @Model.PatrimonioTotalReal];
                }

                const ctxEvolucao = canvasEvolucao.getContext('2d');
                if (chartEvolucao) chartEvolucao.destroy();

                chartEvolucao = new Chart(ctxEvolucao, {
                    type: 'line',
                    data: {
                        labels: labelsEvolucao,
                        datasets: [{
                            label: 'Patrimônio Líquido (R$)',
                            data: dadosEvolucao,
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13, 110, 253, 0.1)',
                            fill: true,
                            tension: 0.3,
                            borderWidth: 3,
                            pointBackgroundColor: '#0d6efd',
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: (context) => 'Saldo: ' + new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(context.raw)
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: false,
                                ticks: { callback: (v) => 'R$ ' + v.toLocaleString('pt-BR') }
                            }
                        }
                    }
                });
            }

            // --- GRÁFICO 2: PROJEÇÃO FUTURA ---
            const canvasProjecao = document.getElementById('chartProjecaoFutura');
            if (canvasProjecao) {
                let labelsProjecao = @Html.Raw(Json.Serialize(ViewBag.ProjecaoFuturaLabels)) || [];
                let dadosProjecao = @Html.Raw(Json.Serialize(ViewBag.ProjecaoFuturaValores)) || [];

                if (labelsProjecao.length === 0) {
                    labelsProjecao = ['Sem Dados'];
                    dadosProjecao = [@Model.PatrimonioTotalReal];
                }

                const ctxProjecao = canvasProjecao.getContext('2d');
                if (chartProjecao) chartProjecao.destroy();

                chartProjecao = new Chart(ctxProjecao, {
                    type: 'line',
                    data: {
                        labels: labelsProjecao,
                        datasets: [{
                            label: 'Patrimônio Projetado (R$)',
                            data: dadosProjecao,
                            borderColor: '#0dcaf0',
                            backgroundColor: 'rgba(13, 202, 240, 0.1)',
                            fill: true,
                            tension: 0.3,
                            borderWidth: 3,
                            pointBackgroundColor: '#0dcaf0',
                            pointRadius: 4,
                            borderDash: [5, 5]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: (context) => 'Projeção: ' + new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(context.raw)
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: false,
                                ticks: { callback: (v) => 'R$ ' + v.toLocaleString('pt-BR') }
                            }
                        }
                    }
                });
            }

            // --- GRÁFICO 3: RENDIMENTOS DE INVESTIMENTOS (REDA FIXA VS RENDA VARIÁVEL) ---
            const canvasRendimentos = document.getElementById('chartRendimentosInvestimentos');
            if (canvasRendimentos) {
                const labelsPassado = @Html.Raw(Json.Serialize(ViewBag.RendimentosLabelsPassado)) || [];
                const labelsFuturo = @Html.Raw(Json.Serialize(ViewBag.RendimentosLabelsFuturo)) || [];

                const fixaPassado = @Html.Raw(Json.Serialize(ViewBag.FixaValoresPassado)) || [];
                const fixaFuturo = @Html.Raw(Json.Serialize(ViewBag.FixaValoresFuturo)) || [];

                const variavelPassado = @Html.Raw(Json.Serialize(ViewBag.VariavelValoresPassado)) || [];
                const variavelFuturo = @Html.Raw(Json.Serialize(ViewBag.VariavelValoresFuturo)) || [];

                const todasLabels = [...labelsPassado, ...labelsFuturo];

                const dsFixaPassado = [...fixaPassado];
                const dsFixaFuturo = Array(fixaPassado.length - 1).fill(null);
                if(fixaPassado.length > 0) dsFixaFuturo.push(fixaPassado[fixaPassado.length - 1]);
                dsFixaFuturo.push(...fixaFuturo);

                const dsVariavelPassado = [...variavelPassado];
                const dsVariavelFuturo = Array(variavelPassado.length - 1).fill(null);
                if(variavelPassado.length > 0) dsVariavelFuturo.push(variavelPassado[variavelPassado.length - 1]);
                dsVariavelFuturo.push(...variavelFuturo);

                const ctxRendimentos = canvasRendimentos.getContext('2d');
                if (chartRendimentos) chartRendimentos.destroy();

                chartRendimentos = new Chart(ctxRendimentos, {
                    type: 'line',
                    data: {
                        labels: todasLabels,
                        datasets: [
                            {
                                label: 'Renda Fixa Real (Caixinhas)',
                                data: dsFixaPassado,
                                borderColor: '#0d6efd',
                                backgroundColor: 'transparent',
                                tension: 0.2,
                                borderWidth: 3,
                                pointBackgroundColor: '#0d6efd'
                            },
                            {
                                label: 'Projeção Renda Fixa',
                                data: dsFixaFuturo,
                                borderColor: '#70a6ff',
                                backgroundColor: 'transparent',
                                tension: 0.2,
                                borderWidth: 2,
                                borderDash: [5, 5],
                                pointBackgroundColor: '#70a6ff',
                                pointRadius: 3
                            },
                            {
                                label: 'Renda Variável Real',
                                data: dsVariavelPassado,
                                borderColor: '#198754',
                                backgroundColor: 'transparent',
                                tension: 0.2,
                                borderWidth: 3,
                                pointBackgroundColor: '#198754'
                            },
                            {
                                label: 'Projeção Renda Variável',
                                data: dsVariavelFuturo,
                                borderColor: '#a3cfbb',
                                backgroundColor: 'transparent',
                                tension: 0.2,
                                borderWidth: 2,
                                borderDash: [5, 5],
                                pointBackgroundColor: '#a3cfbb',
                                pointRadius: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top',
                                labels: { boxWidth: 20, font: { weight: 'bold' } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: (context) => context.dataset.label + ': ' + new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(context.raw)
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { callback: (v) => 'R$ ' + v.toLocaleString('pt-BR') }
                            }
                        }
                    }
                });
            }
        });

        // Força todos os gráficos do Canvas a recalcular o tamanho real ao mudar de abas
        const tabLinks = document.querySelectorAll('#tabsModalFinanceiro button');
        tabLinks.forEach(tab => {
            tab.addEventListener('shown.bs.tab', function () {
                if (chartEvolucao) chartEvolucao.resize();
                if (chartProjecao) chartProjecao.resize();
                if (chartRendimentos) chartRendimentos.resize();
            });
        });
    });

    function abrirConfiguracaoMetasRapido() {
        const modalDetalhes = bootstrap.Modal.getInstance(document.getElementById('modalRendimentosERebalanceamento'));
        if(modalDetalhes) modalDetalhes.hide();

        setTimeout(() => {
            const modalConfigMetas = new bootstrap.Modal(document.getElementById('modalMetas'));
            modalConfigMetas.show();
        }, 400);
    }
</script>