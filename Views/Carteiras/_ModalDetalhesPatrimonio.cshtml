@model CarteiraTotalViewModel

<div class="modal fade" id="modalDetalhesPatrimonio" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        @* Mudado para modal-lg para acomodar confortavelmente os 4 cards lado a lado *@
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white border-0 pt-4 px-4 rounded-top-4">
                <div class="d-flex align-items-center">
                    <i class="bi bi-pie-chart-fill me-3 fs-3 text-info"></i>
                    <div>
                        <h5 class="modal-title fw-bold">Raio-X do Patrimônio</h5>
                        <small class="text-info opacity-75">Posição consolidada até @DateTime.Now.ToString("dd/MM/yyyy")</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                @* 1. Distribuição de Ativos (O que está investido) *@
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-end mb-2">
                        <label class="small text-muted text-uppercase fw-bold">Alocação de Investimentos</label>
                        <span class="badge bg-light text-dark border">@((Model.TotalPatrimonio + Model.TotalInvestidoRendaFixa).ToString("C2"))</span>
                    </div>

                    <div class="p-3 border rounded-4 bg-light">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small text-secondary"><i class="bi bi-graph-up me-2"></i>Renda Variável</span>
                            <span class="fw-bold text-dark">@Model.TotalPatrimonio.ToString("C2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-0">
                            <span class="small text-secondary"><i class="bi bi-safe me-2"></i>Renda Fixa / Caixa</span>
                            <span class="fw-bold text-dark">@((Model.PatrimonioTotalReal - Model.TotalPatrimonio).ToString("C2"))</span>
                        </div>
                    </div>
                </div>

                @* 2. Fluxo Vivo (O que mudou pelo seu esforço/gastos) *@
                <div class="mb-4">
                    <label class="small text-muted text-uppercase fw-bold mb-3 d-block">Movimentações Financeiras (Histórico Acumulado)</label>

                    <div class="row g-2 text-center mb-3">
                        @* Entradas JÁ recebidas (Corrigido para col-md-3) *@
                        <div class="col-6 col-md-3">
                            <div class="p-2 border rounded-3 bg-success-subtle border-success-subtle text-success h-100 d-flex flex-column justify-content-center">
                                <small class="d-block opacity-75 fw-bold" style="font-size: 0.6rem; letter-spacing: 0.5px;">RECEBIDO</small>
                                <span class="fw-bold" style="font-size: 0.85rem;">@((Model.ResumoMensal.Sum(x => x.Entradas) - Model.EntradasFuturas).ToString("C2"))</span>
                            </div>
                        </div>

                        @* Entradas FUTURAS (O que está por vir) (Corrigido para col-md-3) *@
                        <div class="col-6 col-md-3">
                            <div class="p-2 border rounded-3 bg-info-subtle border-info-subtle text-info h-100 d-flex flex-column justify-content-center">
                                <small class="d-block opacity-75 fw-bold" style="font-size: 0.6rem; letter-spacing: 0.5px;">A RECEBER</small>
                                <span class="fw-bold" style="font-size: 0.85rem;">@Model.EntradasFuturas.ToString("C2")</span>
                            </div>
                        </div>

                        @* Saídas totais realizadas (Corrigido para col-md-3) *@
                        <div class="col-6 col-md-3">
                            <div class="p-2 border rounded-3 bg-danger-subtle border-danger-subtle text-danger h-100 d-flex flex-column justify-content-center">
                                <small class="d-block opacity-75 fw-bold" style="font-size: 0.6rem; letter-spacing: 0.5px;">SAÍDAS REALIZADAS</small>
                                <span class="fw-bold" style="font-size: 0.85rem;">@((Model.ResumoMensal.Sum(x => x.Saidas) - Model.SaidasFuturas).ToString("C2"))</span>
                            </div>
                        </div>

                        @* Saídas FUTURAS (Corrigido para col-md-3) *@
                        <div class="col-6 col-md-3">
                            <div class="p-2 border rounded-3 bg-danger-subtle border-danger-subtle text-danger h-100 d-flex flex-column justify-content-center">
                                <small class="d-block opacity-75 fw-bold" style="font-size: 0.6rem; letter-spacing: 0.5px;">SAÍDAS FUTURAS</small>
                                <span class="fw-bold" style="font-size: 0.85rem;">@Model.SaidasFuturas.ToString("C2")</span>
                            </div>
                        </div>
                    </div>

                    @* Barra de Saúde Financeira *@
                    @{
                        var totalEntradas = Model.ResumoMensal.Sum(x => x.Entradas) - Model.EntradasFuturas;
                        var totalSaidas = Model.ResumoMensal.Sum(x => x.Saidas) - Model.SaidasFuturas;
                        var percSaida = totalEntradas > 0 ? (totalSaidas / totalEntradas) * 100 : 0;

                        // Garante o formato decimal correto com ponto para o estilo do Bootstrap
                        var stringWidth = percSaida.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) + "%";
                    }
                    <div class="mb-2 d-flex justify-content-between small">
                        <span class="text-muted italic">Taxa de Consumo Global</span>
                        <span class="fw-bold @(percSaida > 70 ? "text-danger" : "text-success")">@percSaida.ToString("N1")%</span>
                    </div>
                    <div class="progress rounded-pill" style="height: 8px;">
                        <div class="progress-bar @(percSaida > 70 ? "bg-danger" : "bg-success")"
                             role="progressbar"
                             style="width: @stringWidth"
                             aria-valuenow="@percSaida" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                @* 3. Resultado Final (Liquidez Total) *@
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-0">
                        <div class="bg-primary p-3 text-center text-white">
                            <h6 class="small text-uppercase opacity-75 mb-1">Patrimônio Bruto Real Disponível</h6>
                            <h2 class="fw-bold mb-0">@Model.PatrimonioTotalReal.ToString("C2")</h2>
                        </div>
                        <div class="bg-white p-3 border-top text-center">
                            <small class="text-muted fw-bold italic">
                                <i class="bi bi-info-circle me-1"></i>
                                Este é o valor que você possui hoje se liquidar tudo.
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-dark w-100 rounded-pill fw-bold" data-bs-dismiss="modal">Fechar Detalhamento</button>
            </div>
        </div>
    </div>
</div>