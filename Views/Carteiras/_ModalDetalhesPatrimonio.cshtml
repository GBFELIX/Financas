@model CarteiraTotalViewModel

<div class="modal fade" id="modalDetalhesPatrimonio" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-light border-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark">Composição do Patrimônio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                @* Seção de Ativos *@
                <div class="mb-4">
                    <label class="small text-muted text-uppercase fw-bold mb-2 d-block">Ativos Investidos</label>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span>Renda Variável (Ações/FIIs)</span>
                        <span class="fw-bold text-dark">R$ @Model.TotalPatrimonio.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Renda Fixa</span>
                        <span class="fw-bold text-dark">R$ @Model.TotalInvestidoRendaFixa.ToString("N2")</span>
                    </div>
                </div>

                <hr class="opacity-10">

                @* Seção de Fluxo de Caixa (O que você pediu) *@
                <div class="mb-4">
                    <label class="small text-muted text-uppercase fw-bold mb-2 d-block">Saldo em Conta (Acumulado)</label>
                    <div class="d-flex justify-content-between align-items-center mb-2 text-success">
                        <span><i class="bi bi-plus-circle me-2"></i>Total de Entradas</span>
                        <span class="fw-bold">+ R$ @Model.ResumoMensal.Sum(x => x.Entradas).ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center text-danger">
                        <span><i class="bi bi-dash-circle me-2"></i>Total de Saídas</span>
                        <span class="fw-bold">- R$ @Model.ResumoMensal.Sum(x => x.Saidas).ToString("N2")</span>
                    </div>
                </div>

                @* Resultado Final *@
                <div class="bg-light p-3 rounded-4 border">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">Patrimônio Real</span>
                        <span class="fs-4 fw-bold text-primary">R$ @Model.PatrimonioTotalReal.ToString("N2")</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Entendi</button>
            </div>
        </div>
    </div>
</div>