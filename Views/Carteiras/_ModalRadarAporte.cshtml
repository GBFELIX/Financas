@model CarteiraTotalViewModel

<div class="modal fade" id="modalRadarAporte" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-warning border-0 py-3">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="bi bi-compass-fill me-2"></i>Radar de Aporte Inteligente
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-warning-subtle border-warning-subtle rounded-4 mb-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-cash-coin fs-3 me-3 text-warning"></i>
                        <div>
                            <small class="d-block text-uppercase fw-bold text-muted">Saldo Livre p/ Aporte</small>
                            <h4 class="mb-0 fw-bold text-dark">@((Model.EntradasMesCorrente - Model.SaidasMesCorrente).ToString("C2"))</h4>
                        </div>
                    </div>
                </div>

                <label class="small text-muted text-uppercase fw-bold mb-3">Oportunidades do Radar</label>

                @if (Model.SugestoesAporte.Any())
                {
                    @foreach (var item in Model.SugestoesAporte)
                    {
                        var sobraMes = Model.EntradasMesCorrente - Model.SaidasMesCorrente;
                        var qtdPossivel = item.PrecoAtual > 0 ? (int)(sobraMes / item.PrecoAtual) : 0;

                        <div class="card mb-2 border-0 bg-light rounded-3 hover-shadow transition">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge @(item.Tipo == "FII" ? "bg-primary" : "bg-success") mb-1">@item.Tipo</span>
                                        <h5 class="fw-bold mb-0">@item.Ticker</h5>
                                        <small class="text-muted">@item.Mensagem</small>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-dark">@item.PrecoAtual.ToString("C2")</div>
                                        <small class="text-info d-block">P/VP ou P/L: @item.IndicadorDesconto.ToString("N2")</small>
                                    </div>
                                </div>
                                @if (qtdPossivel > 0)
                                {
                                    <div class="mt-2 pt-2 border-top border-2 border-white small">
                                        <i class="bi bi-cart-plus me-1"></i> Com sua sobra, você compra <strong>@qtdPossivel</strong> cotas.
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-search text-muted fs-1 mb-2"></i>
                        <p class="text-muted">Nenhuma "Forte Compra" detectada no momento.</p>
                    </div>
                }
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-dark w-100 rounded-pill fw-bold" data-bs-dismiss="modal">Fechar Radar</button>
            </div>
        </div>
    </div>
</div>