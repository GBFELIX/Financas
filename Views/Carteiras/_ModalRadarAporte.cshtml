@model CarteiraTotalViewModel

<div class="modal fade" id="modalRadarAporte" tabindex="-1" aria-hidden="true">
    @* Usamos modal-xl para ter espaço para os 5 quadrados *@
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-warning border-0 py-3">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="bi bi-compass-fill me-2"></i>Radar de Aporte Inteligente
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-warning-subtle border-warning-subtle rounded-4 mb-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-cash-coin fs-3 me-3 text-warning"></i>
                        <div>
                            <small class="d-block text-uppercase fw-bold text-muted">Saldo Livre p/ Aporte</small>
                            <h4 class="mb-0 fw-bold text-dark">@((Model.EntradasMesCorrente - Model.SaidasMesCorrente).ToString("C2"))</h4>
                        </div>
                    </div>
                </div>

                <label class="small text-muted text-uppercase fw-bold mb-3">Oportunidades do Radar</label>

                @if (Model.SugestoesAporte.Any())
                {
                    @* Container Flex para forçar 5 por linha *@
                    <div class="d-flex flex-wrap gap-3 justify-content-start">
                        @foreach (var item in Model.SugestoesAporte)
                        {
                            var sobraMes = Model.EntradasMesCorrente - Model.SaidasMesCorrente;
                            var qtdPossivel = item.PrecoAtual > 0 ? (int)(sobraMes / item.PrecoAtual) : 0;

                            @* Largura calculada: (100% / 5) - compensação do gap *@
                            <div class="card border-0 bg-light rounded-4 hover-shadow transition text-center p-2"
                                 style="flex: 0 0 calc(20% - 1rem); min-width: 180px; aspect-ratio: 1 / 1;">

                                <div class="card-body d-flex flex-column justify-content-between p-2">
                                    <div>
                                        <span class="badge @(item.Tipo == "FII" ? "bg-primary" : "bg-success") mb-2">@item.Tipo</span>
                                        <h4 class="fw-bold mb-0">@item.Ticker</h4>
                                        <div class="fw-bold text-dark fs-5">@item.PrecoAtual.ToString("C2")</div>
                                    </div>

                                    <div class="my-2">
                                        <small class="text-info d-block fw-bold" style="font-size: 0.75rem;">
                                            @(item.Tipo == "FII" ? "P/VP" : "P/L"): @item.IndicadorDesconto.ToString("N2")
                                        </small>
                                        <small class="text-muted d-block" style="font-size: 0.7rem; line-height: 1;">@item.Mensagem</small>
                                    </div>

                                    @if (qtdPossivel > 0)
                                    {
                                        <div class="bg-white rounded-3 py-2 border border-warning-subtle">
                                            <small class="d-block text-muted" style="font-size: 0.65rem;">VOCÊ COMPRA</small>
                                            <strong class="text-dark fs-5">@qtdPossivel</strong>
                                            <small class="text-muted" style="font-size: 0.65rem;">cotas</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-search text-muted fs-1 mb-2"></i>
                        <p class="text-muted">Nenhuma "Forte Compra" detectada no momento.</p>
                    </div>
                }
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-dark w-100 rounded-pill fw-bold" data-bs-dismiss="modal">Fechar Radar</button>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        background-color: #fff !important;
        border: 1px solid #ffc107 !important;
    }

    .transition {
        transition: all 0.3s ease;
    }
</style>