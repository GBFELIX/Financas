@model Acoes_Fiis.Models.RecomendacaoFii

@{
    ViewData["Title"] = "Excluir FII";
}

<div class="container mt-4">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">⚠️ Confirmar Exclusão</h4>
        </div>
        <div class="card-body">
            <h5 class="text-danger mb-4">Tem certeza de que deseja remover este FII da sua carteira?</h5>

            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Ticker)</dt>
                        <dd class="col-sm-8 fw-bold text-primary">@Html.DisplayFor(model => model.Ticker)</dd>

                        <dt class="col-sm-4">Preço Atual</dt>
                        <dd class="col-sm-8">R$ @Model.PrecoAtual.ToString("N2")</dd>

                        <dt class="col-sm-4">P/VP</dt>
                        <dd class="col-sm-8">@Model.PVP.ToString("N2")</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Segmento</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Segmento)</dd>

                        <dt class="col-sm-4">Última Atualiz.</dt>
                        <dd class="col-sm-8">@Model.DataAtualizacao.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger btn-lg px-5">
                        <i class="bi bi-trash"></i> Confirmar Exclusão
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Cancelar e Voltar
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}