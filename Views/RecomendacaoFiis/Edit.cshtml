@model Acoes_Fiis.Models.RecomendacaoFii

@{
    ViewData["Title"] = "Editar FII";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">✏️ Editar Fundo: @Model.Ticker</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DataAtualizacao" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Ticker" class="form-label fw-bold"></label>
                        <input asp-for="Ticker" class="form-control bg-light" readonly />
                        <span asp-validation-for="Ticker" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="PrecoAtual" class="form-label fw-bold">Preço Atual (R$)</label>
                        <input asp-for="PrecoAtual" type="text" class="form-control" />
                        <span asp-validation-for="PrecoAtual" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="VPA" class="form-label fw-bold">VPA</label>
                        <input asp-for="VPA" type="text" class="form-control" />
                        <span asp-validation-for="VPA" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="UltimoRendimento" class="form-label fw-bold">Último Rendimento (R$)</label>
                        <input asp-for="UltimoRendimento" type="text" class="form-control" />
                        <span asp-validation-for="UltimoRendimento" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Vacancia" class="form-label fw-bold">Vacância (%)</label>
                        <input asp-for="Vacancia" type="text" class="form-control" />
                        <span asp-validation-for="Vacancia" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="TipoFii" class="form-label fw-bold">Tipo de Fundo</label>
                        <select asp-for="TipoFii" class="form-select">
                            <option value="Tijolo">🧱 Tijolo</option>
                            <option value="Papel">📄 Papel (Recebíveis)</option>
                            <option value="FoF">🏢 FoF (Fundo de Fundos)</option>
                            <option value="Híbrido">🔄 Híbrido</option>
                        </select>
                        <span asp-validation-for="TipoFii" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Segmento" class="form-label fw-bold">Segmento</label>
                        <select asp-for="Segmento" class="form-select">
                            <option value="Logística">🚛 Logística</option>
                            <option value="Shopping">🛍️ Shoppings</option>
                            <option value="Lajes Corporativas">🏢 Lajes Corporativas</option>
                            <option value="Recebíveis">💰 Recebíveis</option>
                            <option value="Híbrido">🔄 Híbrido</option>
                            <option value="Outros">❓ Outros</option>
                        </select>
                        <span asp-validation-for="Segmento" class="text-danger"></span>
                    </div>
                </div>

                <hr />
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a asp-action="Index" class="btn btn-outline-secondary me-md-2">Voltar</a>
                    <button type="submit" class="btn btn-warning px-5 fw-bold">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
        }
    </script>
}