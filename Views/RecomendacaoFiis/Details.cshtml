@model Acoes_Fiis.Models.RecomendacaoFii

@{
    ViewData["Title"] = "Ficha Técnica - " + Model.Ticker;
}

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">🔍 Detalhes do Ativo: @Model.Ticker</h4>
            <span class="badge bg-light text-dark">@Model.Segmento</span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 border-end">
                    <h5 class="text-muted border-bottom pb-2">Indicadores de Preço</h5>
                    <dl class="row mt-3">
                        <dt class="col-sm-5">Preço Atual</dt>
                        <dd class="col-sm-7 fw-bold text-primary">R$ @Model.PrecoAtual.ToString("N2")</dd>

                        <dt class="col-sm-5">VPA</dt>
                        <dd class="col-sm-7">R$ @Model.VPA.ToString("N2")</dd>

                        <dt class="col-sm-5">P/VP</dt>
                        <dd class="col-sm-7">
                            @{
                                var pvp = Model.PVP;
                                string classePvp = pvp < 1.00m ? "badge bg-success" : (pvp > 1.05m ? "badge bg-danger" : "badge bg-secondary");
                            }
                            <span class="@classePvp" style="font-size: 0.9rem;">@pvp.ToString("N2")</span>
                        </dd>
                    </dl>
                </div>

                <div class="col-md-6 ps-md-4">
                    <h5 class="text-muted border-bottom pb-2">Rendimentos e Risco</h5>
                    <dl class="row mt-3">
                        <dt class="col-sm-5">Último Provento</dt>
                        <dd class="col-sm-7 text-success fw-bold">R$ @Model.UltimoRendimento.ToString("N2")</dd>

                        <dt class="col-sm-5">DY Mensal</dt>
                        <dd class="col-sm-7">@Model.DividendYieldMensal.ToString("N2")%</dd>

                        <dt class="col-sm-5">Vacância</dt>
                        <dd class="col-sm-7 text-danger">@Model.Vacancia.ToString("N2")%</dd>

                        <dt class="col-sm-5">Tipo de Fundo</dt>
                        <dd class="col-sm-7">@Model.TipoFii</dd>
                    </dl>
                </div>
            </div>

            <hr />

            <div class="row align-items-center">
                <div class="col-sm-6">
                    <small class="text-muted">
                        <i class="bi bi-clock"></i> Última atualização em: @Model.DataAtualizacao.ToString("dd/MM/yyyy HH:mm:ss")
                    </small>
                </div>
                <div class="col-sm-6 text-end">
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning me-2">
                        <i class="bi bi-pencil"></i> Editar
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Voltar para Lista
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}