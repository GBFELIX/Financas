@model IEnumerable<Acoes_Fiis.Models.Price>

@{
    ViewData["Title"] = "Simulações de Financiamento";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6">Minhas Simulações (Tabela Price)</h1>
    <p>
        <a asp-action="Create" class="btn btn-primary shadow-sm">Nova Simulação</a>
    </p>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Imóvel</th>
                    <th>Entrada</th>
                    <th>Juros (Ano)</th>
                    <th class="text-center">Prazo</th>
                    <th class="text-center">Início do Financiamento</th>
                    <th>Extra/Mês</th>
                    <th>Prestação</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-success">
                            @item.ValorImovel.ToString("C")
                        </td>
                        <td>
                            @item.ValorEntrada.ToString("C")
                        </td>
                        <td>
                            @item.TaxaJurosAnual.ToString("N2")%
                        </td>
                        <td class="text-center">
                            @item.PrazoMeses <span class="text-muted small">meses</span>
                        </td>
                        <td class="text-center">
                            @item.DataInicio.ToString("MM/yyyy")
                        </td>
                        <td class="text-danger">
                            @(item.AporteExtraMensal.HasValue ? item.AporteExtraMensal.Value.ToString("C") : "-")
                        </td>
                        <td>
                            @item.ValorPrestação.ToString("C")
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info text-white">Ver Amortização</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3 text-center">
        Nenhuma simulação cadastrada. Comece criando uma nova!
    </div>
}