@model Acoes_Fiis.Models.Price

@{
    ViewData["Title"] = "Editar Simulação";
}

<div class="container">
    <h1 class="display-6">Editar Financiamento</h1>
    <hr />

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-pencil-square"></i> Dados do Contrato
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" name="Dono" value="@ViewBag.VisaoAtual" />

                        <div class="mb-3">
                            <label asp-for="ValorImovel" class="form-label fw-bold">Valor do Imovel</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorImovel" type="text" data-val="false" class="form-control" />
                            </div>
                            <span asp-validation-for="ValorImovel" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ValorEntrada" class="form-label fw-bold">Valor da Entrada</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorEntrada" type="text" data-val="false" class="form-control" />
                            </div>
                            <span asp-validation-for="ValorEntrada" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TaxaJurosAnual" class="form-label fw-bold">Taxa de Juros Anual</label>
                                <div class="input-group">
                                    <input asp-for="TaxaJurosAnual" type="text" data-val="false" class="form-control" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span asp-validation-for="TaxaJurosAnual" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PrazoMeses" class="form-label fw-bold">Quantos Meses?</label>
                                <input asp-for="PrazoMeses" class="form-control" />
                                <span asp-validation-for="PrazoMeses" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DataInicio" class="form-label fw-bold">Inicio</label>
                            <input asp-for="DataInicio" type="date" class="form-control" />
                            <span asp-validation-for="DataInicio" class="text-danger"></span>
                            <small class="text-muted">Altere para ajustar o início do cronograma.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AporteExtraMensal" class="form-label fw-bold">Aporte Extra Mensal</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="AporteExtraMensal" type="text" data-val="false" class="form-control border-success" />
                            </div>
                            <span asp-validation-for="AporteExtraMensal" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ValorPrestação" class="form-label fw-bold">Valor da Prestação</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="ValorPrestação" type="text" data-val="false" class="form-control border-success" />
                            </div>
                            <span asp-validation-for="ValorPrestação" class="text-danger"></span>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary w-100 shadow-sm">
                                <i class="bi bi-save"></i> Salvar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100 mb-4">Voltar para o financiamento</a>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-list-check"></i> Aportes Pontuais Cadastrados
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mês</th>
                                <th>Valor</th>
                                <th class="text-end">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AportesPontuais != null && Model.AportesPontuais.Any())
                            {
                                foreach (var aporte in Model.AportesPontuais.OrderBy(a => a.MesReferencia))
                                {
                                    <tr>
                                        <td class="align-middle">Mês @aporte.MesReferencia</td>
                                        <td class="align-middle fw-bold">@aporte.Valor.ToString("C")</td>
                                        <td class="text-end">
                                            <form asp-action="RemoverAporte" method="post" style="display:inline;">
                                                <input type="hidden" name="aporteId" value="@aporte.Id" />
                                                <input type="hidden" name="priceId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Excluir este aporte?')">
                                                    <i class="bi bi-trash"></i> Remover
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center p-4 text-muted">
                                        Nenhum aporte pontual registrado.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <script src="~/js/site-fix-decimal.js"></script>
    }
}